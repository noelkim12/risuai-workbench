---
comment: "가챠 메뉴 UI (GACHA_MENU)"
type: editdisplay
ableFlag: true
flag: g<cbs>
---
@@@ IN
\[GACHA_MENU:([\d,]+)P?\]
@@@ OUT
<div class="gacha-menu-panel"><div class="gacha-menu-hdr"><span class="gacha-menu-icon">🎰</span><span>가챠 머신</span></div><div class="gacha-menu-pts"><span class="gacha-pts-icon">💰</span><span class="gacha-pts-label">POINTS</span><span class="gacha-pts-value">$1P</span></div><div class="gacha-grid"><div class="gacha-cell gacha-companion"><div class="gacha-cell-icon">👥</div><div class="gacha-cell-name">동료 소환</div><div class="gacha-cell-cost">5,000P</div><div class="gacha-cell-btn">{{button::가챠::gachaCompanion}}</div><div class="gacha-cell-btn" style="margin-top:6px;">{{button::500P 다시::gachaCompanionReroll}}</div><div style="margin-top:4px;font-size:0.68em;color:#6b7f95;line-height:1.25;">직전 동료 교체</div></div><div class="gacha-cell gacha-relic"><div class="gacha-cell-icon">🏺</div><div class="gacha-cell-name">유물 획득</div><div class="gacha-cell-cost">3,000P</div><div class="gacha-cell-btn">{{button::가챠::gachaRelic}}</div></div><div class="gacha-cell gacha-facility"><div class="gacha-cell-icon">🏛</div><div class="gacha-cell-name">시설 건설</div><div class="gacha-cell-cost">10,000P</div><div class="gacha-cell-btn">{{button::가챠::gachaFacility}}</div></div><div class="gacha-cell gacha-skill"><div class="gacha-cell-icon">✨</div><div class="gacha-cell-name">스킬 습득</div><div class="gacha-cell-cost">2,000P</div><div class="gacha-cell-btn">{{button::가챠::gachaSkill}}</div></div><div class="gacha-cell gacha-supply"><div class="gacha-cell-icon">📦</div><div class="gacha-cell-name">보급품</div><div class="gacha-cell-cost">200P</div><div class="gacha-cell-btn gacha-cell-btn-split">{{button::1회::gachaSupply}}{{button::2회::gachaSupplyTwice}}</div></div><div class="gacha-cell gacha-couple"><div class="gacha-cell-icon">💞</div><div class="gacha-cell-name">커플 아이템</div><div class="gacha-cell-cost">1,000P</div><div class="gacha-cell-btn">{{button::가챠::gachaCouple}}</div></div><div class="gacha-cell gacha-random"><div class="gacha-cell-icon">🎲</div><div class="gacha-cell-name">랜덤 가챠</div><div class="gacha-cell-cost">티켓 1장</div><div class="gacha-cell-btn">{{button::가챠::gachaRandom}}</div></div></div><div class="gacha-menu-footer">클릭하여 가챠를 진행하세요</div></div>
