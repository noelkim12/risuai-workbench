}

.tu-card {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.95), rgba(244, 249, 255, 0.85)) !important;
  border: 1px solid rgba(21, 101, 216, 0.28) !important;
  border-radius: 0 !important;
  clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
