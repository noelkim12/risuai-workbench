}
.gi-info-aux-state-on { color: #14a86a !important; font-weight: 800 !important; }
.gi-info-aux-state-off { color: #c91c1c !important; font-weight: 800 !important; }
.gi-info-aux-btn {
  background: linear-gradient(165deg, #fff, #eef6ff) !important;
  border: 1px solid rgba(21, 101, 216, 0.3) !important;
  color: #1565d8 !important;
  font-weight: 800 !important;
  border-radius: 0 !important;
