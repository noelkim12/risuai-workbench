/* ============================================================================
   변수 편집기 (디버그) — 가이드 패널 안 카드
   모든 버튼을 황갈색 톤으로 통일 (DEBUG 뱃지 톤: #fbbf24 배경 + #78350f 갈색 글씨)
   ============================================================================ */
.gi-varedit-card {
  margin-bottom: 10px;
}

/* 기본 버튼 (stepper / stat chip 비활성) — 연황 + 갈색 */
.gi-varedit-card button {
  background: #fef3c7;
  color: #78350f;
  border: 1px solid #f59e0b;
  border-radius: 5px;
  padding: 5px 4px;
  font-weight: 700;
  font-size: 0.72em;
  line-height: 1.25;
  cursor: pointer;
  transition: all 0.15s ease;
  font-family: inherit;
  width: 100%;
  text-align: center;
}

/* stat chip 의 button: 이모지 / 텍스트 2-line layout (lua 라벨의 \n 인식) */
.gi-varedit-chip button {
  white-space: pre-line;
  min-height: 42px;
  padding: 4px 2px;
}

.gi-varedit-card button:hover {
  background: #fde68a;
  border-color: #d97706;
  transform: translateY(-1px);
  box-shadow: 0 2px 4px rgba(217, 119, 6, 0.25);
}

.gi-varedit-card button:active {
  transform: translateY(0);
  box-shadow: inset 0 1px 2px rgba(217, 119, 6, 0.3);
}

/* 활성 chip (현재 선택된 stat) — 진한 황색 + 진한 그림자 */
.gi-varedit-chip-active button {
  background: #fbbf24;
  color: #78350f;
  border-color: #d97706;
  font-weight: 800;
  box-shadow: 0 2px 6px rgba(217, 119, 6, 0.4);
}

.gi-varedit-chip-active button:hover {
  background: #f59e0b;
  border-color: #b45309;
}

/* MAX/MIN 강조 (진한 톤) */
.gi-varedit-emphasis button {
  background: #fbbf24;
  color: #78350f;
  border-color: #d97706;
  font-weight: 800;
}

.gi-varedit-emphasis button:hover {
  background: #f59e0b;
  border-color: #b45309;
}

/* 아이템 ✕ 버튼 — 컴팩트 */
.gi-varedit-delete button {
  padding: 3px 8px;
  font-size: 0.78em;
  width: auto;
  min-width: 28px;
}

/* ============================================================================
   디버그/치트 패널 (5번째 사이드 토글)
   변수 편집기와 색상 톤은 같은 황갈색 계열이지만, 패널은 별도 분리.
   복구 도구 (선택지 복구 / 층 클리어 보정 / 강제 귀환) 전용.
   ============================================================================ */
