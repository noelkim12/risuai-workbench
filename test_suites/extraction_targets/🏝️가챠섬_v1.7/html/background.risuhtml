.sys-map-banner-north { top: 24% !important; }

.gacha-menu-panel {
  background: linear-gradient(160deg, rgba(255,255,255,0.94), rgba(235,243,251,0.9)) !important;
  border: 1px solid rgba(21, 101, 216, 0.3) !important;
  border-radius: 0 !important;
  clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
