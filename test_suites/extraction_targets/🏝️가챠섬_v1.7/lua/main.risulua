-- =============================================
-- STATE SAVE/RESTORE (per-message snapshot)
-- 매 AI 메시지 끝에 <=SAVE¦...=> 태그 부착 → 어느 시점이든 복원 가능
-- Reroll, 메시지 삭제, 시간 되돌리기 모두 자동 처리
-- =============================================

local SNAPSHOT_VARS = __variable_store.SNAPSHOT_VARS
-- 제외 (transient pre-roll, 매 onInput에서 fresh):
--   cv_combatResult/Roll/Rate, cv_nextFloorCondition, cv_nextDungeonType
-- 제외 (live state — dungeonNextFloor 버튼이 imperative 갱신, SAVE 복원 시 stale 1로 되돌아가는 버그 방지):
--   cv_currentFloor (버튼·자연 narrative 진입 모두 onOutput lock-in에서 sync, SAVE/LOAD에 의존 안 함)
-- 제외 (UI/meta — 트랜지언트 또는 재로드 시 자체 init):
--   cv_invOpen, cv_invCategory, cv_gachaPanelOpen, cv_forgeOpen, cv_forgeCategory, cv_guideOpen, cv_debugOpen, cv_skipNextRerollPoint
--   cv_seedCounter (PRNG entropy counter — monotonic increase 보장 위해 SAVE 제외)
--   cv_lastFallbackTip (STATUS_TIP fallback dedupe — transient)

-- =============================================
-- #345: SAVE V2 — 짧은 키 + 기본값 생략으로 평균 ~89% 감소
-- 옛 포맷: <=SAVE¦cv_hp:80¦cv_mana:60¦cv_hunger:70¦...=> (~1440 bytes, 모든 변수)
-- 신 포맷: <=S2¦h:80¦m:60¦u:70=> (~150 bytes, 변경된 변수만)
-- 옛 SAVE도 로드 시 인식 (legacy chat 호환) — writer는 V2만 사용
-- =============================================

-- 짧은 키 매핑 (stable — 절대 재배치 금지. 새 변수는 미사용 슬롯에 추가)
local SAVE_KEY_MAP = __variable_store.SAVE_KEY_MAP

-- 역방향 매핑 (한 번 빌드, parser에서 사용)
local SAVE_KEY_REVERSE = __variable_store.SAVE_KEY_REVERSE
for full, short in pairs(SAVE_KEY_MAP) do SAVE_KEY_REVERSE[short] = full end

-- 기본값 (skip-default 판정용 — INIT 블록과 일치)
local SAVE_DEFAULTS = __variable_store.SAVE_DEFAULTS

-- =============================================
-- #441 SEED-BASED SAVE — V2 인라인 압축 방식 (1.5 호환 + 토큰 절감)
-- 메시지 본문에는 짧은 <!--[SEED|sXXX]--> 마커만 박고, 실제 상태 데이터는
-- 별도 chat var (cv_saveSeedStore) 에 시드→상태테이블 매핑으로 저장.
-- 옛 채팅 (1.5 V2 SAVE) 은 loadLatestStateFromHistory 가 자동 폴백 → 마이그레이션.
-- 40턴마다 chat history 안 안 쓰이는 시드 GC (pruneUnusedSaveSeeds).
-- =============================================

