    _G["equipToggleSkill" .. idx] = function(triggerId)
        return __domain_equip.equipToggleByIdx(triggerId, "skill", idx)
    end
    _G["equipToggleRelic" .. idx] = function(triggerId)
        return __domain_equip.equipToggleByIdx(triggerId, "relic", idx)
    end
end

