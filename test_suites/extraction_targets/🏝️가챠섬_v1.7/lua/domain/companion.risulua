local __domain_var = require("domain.var")

local M = {}
local __impl = {}

-- ============================================================================
-- COMPANION GRID HTML BUILDER (사이드패널 👥 동료 탭용)
-- Lua가 한글명 + 영문 prefix 병렬 처리로 HTML 직접 빌드 (CBS 병렬 iter 한계 우회)
-- 결과는 cv_companionsGrid 채팅 변수에 저장, 정규식이 {{getvar}}로 출력
-- 매 onOutput에서 갱신 (SAVE에는 포함 X — 매번 재구성, save bloat 방지)
-- ============================================================================
function __impl.buildCompanionsGrid(triggerId)
    local kor_str = __domain_var.safeGetVar(triggerId, "cv_companions", "None")
    local eng_str = __domain_var.safeGetVar(triggerId, "cv_companionsEng", "None")

    local empty_html = '<div class="gi-empty">아직 동료가 없습니다</div>'

    if kor_str == "None" or kor_str == "" or kor_str == "null" then
        return empty_html
    end

    -- Parse 한글명 / 영문 prefix 리스트
    local kor_list = {}
    for k in kor_str:gmatch("([^,]+)") do
        local kt = k:match("^%s*(.-)%s*$")
        if kt and kt ~= "" then table.insert(kor_list, kt) end
    end
    local eng_list = {}
    if eng_str ~= "None" and eng_str ~= "" and eng_str ~= "null" then
        for e in eng_str:gmatch("([^,]+)") do
            local et = e:match("^%s*(.-)%s*$")
            if et and et ~= "" then table.insert(eng_list, et) end
        end
    end

    if #kor_list == 0 then return empty_html end

    -- 가챠 게임 풀-블리드 카드 디자인 (서브컬쳐 미소녀 가챠 스타일)
    -- ★ portrait 1:1.4 비율, 이미지 full bleed, 이름 오버레이 (라벨 따로 X)
    -- ★ 두꺼운 골드 그라데이션 보더 + 외부 글로우 box-shadow
    -- ★ 우상단 ⭐ 데코 (gacha 분위기)
    -- ★ 하단 페이드 + 골드 이름 (텍스트 글로우)
    -- 클린 가챠 카드: 2열 그리드, portrait 1:1.5, 골드 보더, 흰 이름
    -- ★ 레이아웃 인라인 (CSS 없어도 100% 작동)
    -- ★ class="gi-comp-card" — CSS 임포트 시 hover shimmer 효과 추가 (degrades gracefully)
    local parts = {'<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:12px;">'}
    for i = 1, #kor_list do
        local kor = kor_list[i]
        local eng = eng_list[i] or kor
        local img_url = ""
        pcall(function() img_url = cbs("{{path::" .. eng .. "_neutral.webp}}") or "" end)

        -- 자산 resolution 실패 감지: cbs()가 빈 문자열 또는 echo (path 미해결)
        local img_resolved = img_url ~= ""
            and img_url ~= (eng .. "_neutral.webp")
            and not img_url:find("{{path::", 1, true)

        -- 이미지 블록: placeholder 배경 + image overlay 2-layer
        -- 1) placeholder 배경 (image 실패 시 보임)
        -- 2) image div 위에 박힘 (cbs() resolved 또는 raw {{path::}} 매크로 — 양쪽 다 시도)
        --    image 박히면 placeholder 가려짐, 실패 시 placeholder 노출
        local placeholder_html = '<div style="' ..
            'position:absolute;top:0;left:0;width:100%;height:100%;' ..
            'display:flex;flex-direction:column;align-items:center;justify-content:center;' ..
            'background:linear-gradient(135deg,#2a2438 0%,#1a1828 50%,#0d0c18 100%);' ..
            'gap:6px;padding:8px;box-sizing:border-box;' ..
            '">' ..
            '<div style="font-size:2.4em;opacity:0.4;line-height:1;">🎴</div>' ..
            '<div style="font-size:0.7em;color:rgba(255,235,160,0.65);text-align:center;line-height:1.3;font-weight:600;word-break:break-word;">' .. eng .. '</div>' ..
            '<div style="font-size:0.55em;color:rgba(255,255,255,0.35);text-align:center;line-height:1.2;">(에셋 미로드)</div>' ..
            '</div>'
        -- cbs() 성공 시 resolved URL, 실패 시 raw 매크로 fallback (RisuAI nested 평가 시도)
        local resolved_url = img_resolved and img_url or ("{{path::" .. eng .. "_neutral.webp}}")
        local img_layer = '<div class="gi-comp-img" style="' ..
            'position:absolute;top:0;left:0;width:100%;height:100%;' ..
            'background-image:url(\'' .. resolved_url .. '\');' ..
            'background-size:cover;' ..
            'background-position:center;' ..
            '"></div>'
        local img_block = placeholder_html .. img_layer

        -- 외곽 카드 (골드 보더)
        parts[#parts+1] = '<div class="gi-comp-card" style="' ..
            'position:relative;' ..
            'border-radius:13px;' ..
            'padding:2.5px;' ..
            'background:linear-gradient(135deg,#fff4c4 0%,#ffd966 25%,#d4a84e 55%,#8b6e2f 90%,#5a4520 100%);' ..
            'box-shadow:0 5px 16px rgba(0,0,0,0.5),0 0 16px rgba(255,200,80,0.22),inset 0 0 0 1px rgba(0,0,0,0.4);' ..
            'overflow:hidden;' ..
            '">' ..
            -- 내부 이미지 컨테이너 (portrait 1:1.3)
            '<div style="' ..
            'position:relative;' ..
            'width:100%;' ..
            'padding-top:130%;' ..
            'border-radius:10.5px;' ..
            'overflow:hidden;' ..
            'background:#0a0d18;' ..
            '">' ..
            img_block ..
            -- 하단 이름 (한글, 흰색 중앙)
            '<div style="' ..
            'position:absolute;bottom:0;left:0;right:0;' ..
            'padding:18px 6px 8px;' ..
            'background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,0.65) 45%,rgba(0,0,0,0.92) 100%);' ..
            'text-align:center;' ..
            'pointer-events:none;' ..
            '">' ..
            '<div style="' ..
            'font-size:0.82em;' ..
            'font-weight:700;' ..
            'color:#ffffff;' ..
            'text-shadow:0 1px 3px #000,0 0 5px rgba(0,0,0,0.9);' ..
            'letter-spacing:0.5px;' ..
            '">' .. kor .. '</div>' ..
            '</div>' ..
            '</div>' ..
            '</div>'
    end
    parts[#parts+1] = '</div>'
    return table.concat(parts)
end

M.buildCompanionsGrid = __impl.buildCompanionsGrid

return M
