local __variable_store = require("state.variable_store")

local M = {}
local __impl = {}

-- #345: V2 (짧은 키 + skip-default) writer — #465 삭제됨 (SEED 시스템 #441 으로 대체).
-- #466: V1 parser (parseAndApplySaveString) 삭제됨 — 1.4.x → 1.5 마이그레이션 호환 코드. 1.5.n 신규 chat 영향 없음.

-- #345: V2 parser. 짧은 키 → full key 역매핑 + 미포함 변수는 default로 복원.
function __impl.parseAndApplySaveStringV2(triggerId, saveString)
    local dataPart = saveString:match("<=S2¦(.-)=>")
    if not dataPart then return false end
    -- 1) SAVE에서 받은 값들을 saveData[fullKey] = val 맵으로 수집
    local saveData = {}
    local pos = 1
    while pos <= #dataPart do
        local sepStart, sepEnd = dataPart:find("¦", pos, true)
        local pair
        if sepStart then
            pair = dataPart:sub(pos, sepStart - 1); pos = sepEnd + 1
        else
            pair = dataPart:sub(pos); pos = #dataPart + 1
        end
        if pair ~= "" then
            local colonPos = pair:find(":", 1, true)
            if colonPos then
                local shortKey = pair:sub(1, colonPos - 1)
                local val = pair:sub(colonPos + 1)
                local fullKey = __variable_store.SAVE_KEY_REVERSE[shortKey]
                -- short 매핑 없으면 shortKey가 full key (이전 SNAPSHOT 매핑 누락 대비)
                if not fullKey then
                    for _, k in ipairs(__variable_store.SNAPSHOT_VARS) do
                        if k == shortKey then fullKey = k; break end
                    end
                end
                if fullKey then saveData[fullKey] = val end
            end
        end
    end
    -- 2) SNAPSHOT_VARS 전체 순회 — saveData에 있으면 그 값, 없으면 default 적용
    --    (skip-default로 빠진 변수 = 그 시점 default였음 → default 복원)
    for _, key in ipairs(__variable_store.SNAPSHOT_VARS) do
        local val = saveData[key]
        if val == nil then val = __variable_store.SAVE_DEFAULTS[key] end
        if val ~= nil then setChatVar(triggerId, key, val) end
    end
    return true
end

M.parseAndApplySaveStringV2 = __impl.parseAndApplySaveStringV2

return M
