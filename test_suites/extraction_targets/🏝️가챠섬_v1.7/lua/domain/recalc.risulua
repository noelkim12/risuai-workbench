local __domain_entry = require("domain.entry")
local __domain_text = require("domain.text")
local __domain_var = require("domain.var")

local M = {}
local __impl = {}

-- 모든 시설 stat의 SLOT 필드 합산 → cv_maxSkillSlots / cv_maxRelicSlots 갱신 (시설은 장착 개념 없으니 전부 합산).
-- 기본 3에 합산. 사용자 요청: 5★+ 시설의 SLOT+1 효과는 무제한 중첩 (장착 시스템 외부).
function __impl.eqRecalcSlots(triggerId)
    local facDetails = __domain_var.safeGetVar(triggerId, "cv_facilityDetails", "None")
    local bonus = 0
    for _, entry in ipairs(__domain_text.eqSplitEntries(facDetails)) do
        local _, _, _, _, statStr = __domain_entry.eqParseEntry(entry)
        if statStr and statStr ~= "" then
            local s = __domain_var.eqStatParse(statStr)
            bonus = bonus + (s.SLOT or 0)
        end
    end
    local newMax = 3 + bonus
    if newMax < 3 then newMax = 3 end
    setChatVar(triggerId, "cv_maxSkillSlots", tostring(newMax))
    setChatVar(triggerId, "cv_maxRelicSlots", tostring(newMax))
end

M.eqRecalcSlots = __impl.eqRecalcSlots

return M
