local __domain_var = require("domain.var")

local M = {}
local __impl = {}

-- #497 hunger=0 시 매 onOutput 마다 HP -5 자동 차감 (system-wide — 던전/섬 무관).
--   기존 #477: 던전 안 advanceRound 시점에만 차감 (cv_dungeonActive 가드). 섬에서는 NEW_DAY 시점에만.
--   결정: 단순화 — 매 응답 1회 hunger=0 + cv_hp>0 이면 HP -5 차감. 위치 무관.
--   GAME OVER / DEFEAT 트리거는 별도 — cv_hp==0 도달해도 자동 발동 안 함. LLM 또는 사용자 처리.
function __impl._applyStarvationHpPerResponse(triggerId)
    local curHunger = tonumber(__domain_var.safeGetVar(triggerId, "cv_hunger", "100")) or 100
    if curHunger > 0 then return end
    local curHp = tonumber(__domain_var.safeGetVar(triggerId, "cv_hp", "100")) or 100
    if curHp <= 0 then return end
    local newHp = math.max(0, curHp - 5)
    setChatVar(triggerId, "cv_hp", tostring(newHp))
    print(string.format("[GachaIsland] HUNGER_STARVATION (#497): hunger=0 → HP %d → %d (-5, per response)", curHp, newHp))
end

M._applyStarvationHpPerResponse = __impl._applyStarvationHpPerResponse

return M
