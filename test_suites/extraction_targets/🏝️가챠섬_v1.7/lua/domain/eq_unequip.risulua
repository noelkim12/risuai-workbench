local __domain_list = require("domain.list")
local __domain_var = require("domain.var")

local M = {}
local __impl = {}

function __impl.eqUnequip(triggerId, kind, name)
    local listKey
    if kind == "skill" then listKey = "cv_equippedSkills"
    elseif kind == "relic" then listKey = "cv_equippedRelics"
    else return false, "unknown kind" end
    local cur = __domain_var.safeGetVar(triggerId, listKey, "None")
    if not __domain_list.eqInList(cur, name) then return false, "not equipped" end
    setChatVar(triggerId, listKey, __domain_list.eqRemoveFromList(cur, name))
    __domain_var.eqRecalcStats(triggerId)
    print(string.format("[GachaIsland] UNEQUIP %s: %s", kind, name))
    return true
end

M.eqUnequip = __impl.eqUnequip

return M
