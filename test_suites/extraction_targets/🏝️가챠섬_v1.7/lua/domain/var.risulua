local __variable_store = require("state.variable_store")
local __local_helpers = require("common.local_helpers")
local __domain_text = require("domain.text")
local __domain_base = require("domain.base")
local __domain_entry = require("domain.entry")
local __domain_number = require("domain.number")
local __domain_string = require("domain.string")

local M = {}
local __impl = {}

-- Helper: treat "null" string from RisuAI as nil/fallback
function __impl.safeGetVar(triggerId, varName, fallback)
    local val = getChatVar(triggerId, varName)
    if val == nil or val == "" or val == "null" then
        return fallback
    end
    return val
end

-- Helper: setChatVar 의 「현재 값과 같으면 안 쓴다」 버전.
-- 패널 닫기/플래그 리셋처럼 같은 값을 반복 setChat 하는 핫 경로에서 사용.
-- Risu 의 SAVE 갱신 + CBS 재평가 + dirty marking 부담을 줄임. 동작은 setChatVar 와 동일.
function __impl.smartSetChatVar(triggerId, key, value)
    local newVal = tostring(value)
    local cur = getChatVar(triggerId, key)
    if cur ~= newVal then
        setChatVar(triggerId, key, newVal)
    end
end

-- =============================================
-- PRNG SEED REFRESH (entropy fix)
-- RisuAI Lua가 트리거마다 모듈 재로드해 같은 os.time() seed 반복 사용 의심 →
-- math.random 시퀀스가 결정적이 되어 같은 인덱스만 뽑히는 편향 발생.
-- Lua 5.4 2-arg math.randomseed(x, y) → 128-bit 시드 (high 64 = os.time, low 64 = counter*7919)
-- chat-persistent counter로 매 호출 unique seed 보장 + warm-up으로 초기 상태 회피.
-- 모든 random 호출 (전투/층컨디션/던전 type/가챠) 직전에 호출.
-- =============================================
function __impl.refreshSeed(triggerId)
    local seedCounter = tonumber(__impl.safeGetVar(triggerId, "cv_seedCounter", "0")) or 0
    seedCounter = seedCounter + 1
    setChatVar(triggerId, "cv_seedCounter", tostring(seedCounter))
    -- #424 entropy 보강:
    --   high bits = os.time() * 1000003 + counter * 7919 (같은 초 입력에도 high 점프)
    --   low bits  = counter * 982451653 (counter +1 마다 ~10억 점프 → 카드 덱 시작점 멀리 이동)
    --   warm-up 5 → 20회 (초기 cluster 완전 회피)
    math.randomseed(os.time() * 1000003 + seedCounter * 7919, seedCounter * 982451653)
    for _ = 1, 20 do math.random() end
end

-- 헬퍼: 층 컨디션 25% 발생 + 5종 균등 pre-roll → (조건명, condRoll)
function __impl.rollFloorCondition()
    local condRoll = math.random(100)
    local cond
    if condRoll <= 25 then
        cond = FLOOR_CONDITIONS[math.random(#FLOOR_CONDITIONS)]
    else
        cond = "없음"
    end
    return cond, condRoll
end

-- 본체 + DLC 합산 풀 빌드 (캐싱 안 함 — 로어북 변동 즉시 반영)
-- DLC는 module 로어북에 `comment="DLC_COMPANION_POOL"` entry로 JSON 캐릭터 배열 등록.
-- `getLoreBooks`는 safe tier — onInput/onOutput에서 호출 가능.
function __impl.buildMergedPool(triggerId)
    -- #342: 캐싱 — lorebook fetch (getLoreBooks)가 비싼 작업이라 Companion 가챠마다 호출하면 부담.
    -- cv_companionPoolCache (SNAPSHOT 미등록, 휘발성)에 JSON 저장 → 같은 chat 안에선 첫 호출만 비용.
    -- 새 chat 시작 / 캐시 invalid 시 재빌드. DLC 동적 변경은 드문 케이스라 안전.
    local cached = __impl.safeGetVar(triggerId, "cv_companionPoolCache", "")
    if cached ~= "" and cached ~= "null" and cached ~= "None" then
        local okC, poolC = pcall(json.decode, cached)
        if okC and type(poolC) == "table" and #poolC > 0 then return poolC end
    end

    local pool = {}
    -- #362 cv_baseCharsOff=1 → COMPANION_POOL_BOT skip (DLC only). DLC tester / DLC-only run 용도.
    local baseOff = __impl.safeGetVar(triggerId, "cv_baseCharsOff", "0") == "1"
    if not baseOff then
        for _, c in ipairs(__variable_store.COMPANION_POOL_BOT) do table.insert(pool, c) end
    end

    -- 모든 module/local/global 로어북에서 comment 매치 entry 수집
    local ok, entries = pcall(getLoreBooks, triggerId, "DLC_COMPANION_POOL")
    if ok and type(entries) == "table" then
        local seen = {}
        for _, c in ipairs(pool) do seen[c.ko] = true end
        for _, e in ipairs(entries) do
            local okJson, dlc = pcall(json.decode, e.content or "")
            if okJson and type(dlc) == "table" then
                for _, c in ipairs(dlc) do
                    -- 형식 가드 + dedupe (여러 DLC가 같은 캐릭 박아도 중복 방지)
                    if type(c) == "table" and c.ko and c.en and not seen[c.ko] then
                        table.insert(pool, c)
                        seen[c.ko] = true
                    end
                end
            end
        end
    end

    -- 캐시 저장
    local okEnc, jsonStr = pcall(json.encode, pool)
    if okEnc and jsonStr then
        setChatVar(triggerId, "cv_companionPoolCache", jsonStr)
    end
    return pool
end

-- 미소환 동료 풀에서 1명 무작위 추첨 (#363: 원작별 origin 회피 로직 폐기 — 풀 다양화로 완전 랜덤 전환).
-- origin 필드는 데이터 정의에 그대로 유지 (DLC 호환). 추첨 로직만 origin-blind.
-- Returns: companion table {ko, en, origin} or nil (전원 소환 완료)
function __impl.pickRandomCompanion(triggerId)
    local POOL = __impl.buildMergedPool(triggerId)  -- 본체 + DLC(chat var) 합산 풀 (매 호출 1회 빌드)
    local raw = __impl.safeGetVar(triggerId, "cv_companions", "None")

    local summoned = {}
    if raw ~= "None" and raw ~= "" and raw ~= "null" then
        for name in raw:gmatch("([^,]+)") do
            name = name:match("^%s*(.-)%s*$")
            if name ~= "" then
                summoned[name] = true
            end
        end
    end

    -- 직전 추첨 결과 회피 (AI가 SYSTEM 태그 누락해서 cv_companions 갱신 실패한 경우의 안전망)
    local lastPick = __impl.safeGetVar(triggerId, "cv_lastGachaPick", "None")

    local fullPool = {}
    for _, c in ipairs(POOL) do
        if not summoned[c.ko] and c.ko ~= lastPick then
            fullPool[#fullPool + 1] = c
        end
    end

    -- 진단 로그 — 풀 상태 가시화 (본체/DLC 분리 표시)
    local summonedCount = 0
    for _ in pairs(summoned) do summonedCount = summonedCount + 1 end
    local poolSize = #POOL
    local dlcCount = poolSize - #__variable_store.COMPANION_POOL_BOT
    print(string.format("[GachaIsland] PICK_COMPANION_DEBUG: cv_companions='%s', lastPick='%s', summoned=%d, POOL_size=%d(bot=%d+dlc=%d), fullPool=%d", raw, lastPick, summonedCount, poolSize, #__variable_store.COMPANION_POOL_BOT, dlcCount, #fullPool))

    -- 3단 fallback:
    --   1) summoned + lastPick 회피 → fullPool. 비면
    --   2) summoned만 회피 (lastPick 풀어줌) → 다시 시도. 그것도 비면
    --   3) POOL 전체 (전원 영입 케이스 — duplicate 의도, AI 환불 narrative)
    if #fullPool == 0 then
        for _, c in ipairs(POOL) do
            if not summoned[c.ko] then
                fullPool[#fullPool + 1] = c
            end
        end
        print(string.format("[GachaIsland] FALLBACK_LV2: lastPick 풀고 재시도 → fullPool=%d", #fullPool))
    end
    if #fullPool == 0 then
        print(string.format("[GachaIsland] FALLBACK_LV3: 전원 영입 완료 → POOL 전체 (duplicate 가능, AI refund)"))
        return POOL[math.random(poolSize)]
    end

    -- #363: 원작 회피 제거. fullPool에서 완전 랜덤 추첨.
    return fullPool[math.random(#fullPool)]
end

-- 랜덤 가챠 타입 가중치: Supply 65% / Couple 5% / Skill 15% / Relic 8% / Companion 5% / Facility 2%
function __impl.rollRandomGachaType()
    local r = math.random(100)
    if     r <= 65 then return "Supply"
    elseif r <= 70 then return "Couple"
    elseif r <= 85 then return "Skill"
    elseif r <= 93 then return "Relic"
    elseif r <= 98 then return "Companion"
    else                return "Facility"
    end
end

-- 가챠 등급 확률 5/4/3/2/1성 = 1.5/5.5/15/30/48%. 동료는 등급 미적용.
function __impl.rollGachaTier()
    local r = math.random(1, 1000)
    if     r <= 15  then return 5
    elseif r <= 70  then return 4
    elseif r <= 220 then return 3
    elseif r <= 520 then return 2
    else                 return 1
    end
end

-- =============================================
-- GACHA BUTTON HANDLERS (가챠 버튼 채팅 전송)
-- =============================================

-- =============================================
-- 사이드 패널 (4 토글: 인벤 / 가챠 / 강화 / 가이드)
--   각 패널은 CSS radio 토글 (<label for=gi-side-*>) 로 작동. Lua 측 toggle 함수 제거 (#465 dead code 일소).
--   강화: 같은 등급 3개 → +1등급 합성. cv_forgeCategory (skill/relic/facility) 탭 전환.
--   맵 (#349 재구성): 사이드 패널에서 빼고 STATUS_PANEL 최상단 STATUS↔MAP 카테고리 토글로 이동.
-- =============================================

-- =============================================
-- #349 (#348 재구성): MAP은 STATUS_PANEL 최상단 카테고리 토글로 이동
-- 4방위 탐색 + 중앙 성소·던전 게이트 클릭 시 addChat(user)로 의도 전송.
-- AI는 region-specific lorebook 참조해 탐색 narration.
-- 탐색 1회 = HUNGER -10. 던전 게이트는 cv_dungeonGateState != "열림"일 때 alertError.
-- =============================================
function __impl._closeAllSidePanels(triggerId)
    __impl.smartSetChatVar(triggerId, "cv_invOpen",        "0")
    __impl.smartSetChatVar(triggerId, "cv_gachaPanelOpen", "0")
    __impl.smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_guideOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_debugOpen",      "0")
end

-- cv_*Details → entries 리스트
function __impl.parseForgeEntries(triggerId, cat)
    local cfg = CAT_CFG[cat]; if not cfg then return {} end
    local raw = __impl.safeGetVar(triggerId, cfg.detailsVar, "None")
    if raw == "None" or raw == "" or raw == "null" then return {} end
    local entries = {}
    local pos = 1
    while pos <= #raw do
        local s, e = raw:find(";;", pos, true)
        local entry = s and raw:sub(pos, s - 1) or raw:sub(pos)
        pos = s and (e + 1) or (#raw + 1)
        local parts, p2 = {}, 1
        while p2 <= #entry do
            local ss, ee = entry:find("||", p2, true)
            parts[#parts+1] = ss and entry:sub(p2, ss - 1) or entry:sub(p2)
            if not ss then break end
            p2 = ee + 1
        end
        if parts[1] and parts[1] ~= "" then
            -- #373 (Bug 3): effect (parts[4]) 도 추출 — 인벤 카드 표시에 사용
            entries[#entries+1] = {
                name = parts[1],
                desc = parts[2] or "",
                tier = tonumber(parts[3] or "1") or 1,
                effect = parts[4] or "",
                raw = entry,
            }
        end
    end
    return entries
end

-- cv_forgePickList<Cat><Slot> 9 변수 빌드 — 매 응답 onOutput / 슬롯 조작 후 호출
-- #373 (Bug 5): 다른 슬롯에 이미 배치된 항목 비활성화 (이름 기준 중복 방지).
-- equipped 항목도 비활성화 (장착 중인 스킬/유물은 강화 재료로 사용 불가 — 디자인 안전판)
function __impl.buildAllForgePickLists(triggerId)
    for _, cat in ipairs({"skill", "relic", "facility"}) do
        local cfg = CAT_CFG[cat]
        local entries = __impl.parseForgeEntries(triggerId, cat)
        local CapCat = cat:sub(1,1):upper() .. cat:sub(2)
        -- 장착 중인 이름 집합 (skill/relic 만 — facility 는 장착 개념 없음)
        local equippedSet = {}
        if cat == "skill" then
            local eq = __impl.safeGetVar(triggerId, "cv_equippedSkills", "None")
            if eq ~= "None" and eq ~= "" and eq ~= "null" then
                for n in eq:gmatch("([^,]+)") do equippedSet[n:match("^%s*(.-)%s*$")] = true end
            end
        elseif cat == "relic" then
            local eq = __impl.safeGetVar(triggerId, "cv_equippedRelics", "None")
            if eq ~= "None" and eq ~= "" and eq ~= "null" then
                for n in eq:gmatch("([^,]+)") do equippedSet[n:match("^%s*(.-)%s*$")] = true end
            end
        end
        for slot = 1, 3 do
            -- 다른 슬롯에 이미 들어간 이름 집합
            local takenSet = {}
            for s = 1, 3 do
                if s ~= slot then
                    local other = __impl.safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. s, "")
                    local otherName = other:match("^(.+)||%d+$")
                    if otherName then takenSet[otherName] = true end
                end
            end
            local pickList = ""
            for idx, entry in ipairs(entries) do
                if idx > 30 then break end
                local stars = string.rep("⭐", entry.tier)
                local label = entry.name .. " " .. stars
                if entry.tier >= 5 then
                    pickList = pickList .. '<span class="gi-forge-pick-disabled" title="5★은 강화할 수 없습니다">' .. label .. '</span>'
                elseif takenSet[entry.name] then
                    pickList = pickList .. '<span class="gi-forge-pick-disabled" title="이미 다른 슬롯에 배치됨">' .. label .. '</span>'
                elseif equippedSet[entry.name] then
                    pickList = pickList .. '<span class="gi-forge-pick-disabled" title="장착 중인 항목은 강화 재료로 사용 불가">' .. label .. '</span>'
                else
                    pickList = pickList .. '<span class="gi-forge-pick-item gi-forge-pick-tier-' .. entry.tier .. '">{{button::' .. label .. '::forgeSet' .. slot .. CapCat .. (idx-1) .. '}}</span>'
                end
            end
            if pickList == "" then
                pickList = '<div class="gi-forge-pick-empty">보유한 ' .. cfg.label .. '이 없습니다</div>'
            end
            setChatVar(triggerId, "cv_forgePickList" .. CapCat .. slot, pickList)
        end
    end
end

function __impl.setSlot(triggerId, slot, cat, idx)
    local entries = __impl.parseForgeEntries(triggerId, cat)
    if idx + 1 > #entries then return end
    local entry = entries[idx + 1]
    if entry.tier >= 5 then
        alertError(triggerId, "5★은 강화할 수 없습니다.")
        return
    end
    local CapCat = _capCat(cat)
    -- #373 (Bug 5): 다른 슬롯에 이미 같은 이름이 있으면 거부 (중복 방지)
    for s = 1, 3 do
        if s ~= slot then
            local other = __impl.safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. s, "")
            local otherName = other:match("^(.+)||%d+$")
            if otherName == entry.name then
                alertError(triggerId, "이미 다른 슬롯에 같은 항목이 있습니다.")
                return
            end
        end
    end
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. slot, entry.name .. "||" .. entry.tier)
    -- #373 (Bug 5): 패널 / 탭 유지 (사이드 패널 + 카테고리 탭) + pickList 닫힘 (active slot 해제)
    setChatVar(triggerId, "cv_forgeOpen",        "1")
    setChatVar(triggerId, "cv_forgeCategory",    cat)
    setChatVar(triggerId, "cv_forgeActiveSlot",  "0")
    -- pickList 재빌드 (다른 슬롯 동일 항목 비활성화 반영)
    __impl.buildAllForgePickLists(triggerId)
    -- #377 후속 (얼헌 refreshScreen 패턴): appendSave 의 setChat 만으로 ONE 재렌더 충분
    -- → reloadDisplay 제거 (double-render 로 인한 setvar 결과 cv=0 → 패널 닫힘 flicker 차단)
    __impl.appendSaveToCurrentMessage(triggerId)
end

-- 카테고리별 슬롯 초기화 — 활성 카테고리의 3 슬롯만 비움.
-- #373 (Bug 5): 패널 / 탭 상태 유지 위해 cv 상태 명시 + reloadDisplay
function __impl.clearCat(triggerId, cat)
    local CapCat = _capCat(cat)
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "1", "")
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "2", "")
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "3", "")
    setChatVar(triggerId, "cv_forgeOpen",       "1")
    setChatVar(triggerId, "cv_forgeCategory",   cat)
    setChatVar(triggerId, "cv_forgeActiveSlot", "0")
    __impl.buildAllForgePickLists(triggerId)
    -- #377 후속 (얼헌 refreshScreen 패턴): appendSave 의 setChat 만으로 ONE 재렌더 충분 → reloadDisplay 제거
    __impl.appendSaveToCurrentMessage(triggerId)
end

-- 카테고리별 강화 실행
function __impl.applyCat(triggerId, cat)
    local cfg = CAT_CFG[cat]; if not cfg then return end
    local CapCat = _capCat(cat)
    local s1 = __impl.safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. "1", "")
    local s2 = __impl.safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. "2", "")
    local s3 = __impl.safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. "3", "")
    if s1 == "" or s2 == "" or s3 == "" then
        alertError(triggerId, cfg.label .. " 슬롯 3개를 모두 채워주세요."); return
    end

    local function parseSlot(s)
        local name, tier = s:match("^(.+)||(%d+)$")
        return name, tonumber(tier or "1") or 1
    end
    local n1, t1 = parseSlot(s1)
    local n2, t2 = parseSlot(s2)
    local n3, t3 = parseSlot(s3)

    if t1 ~= t2 or t2 ~= t3 then
        alertError(triggerId, "같은 ⭐ 등급 3개를 선택해야 합니다."); return
    end
    if t1 >= 5 then
        alertError(triggerId, "5★은 더 강화할 수 없습니다."); return
    end

    local entries = __impl.parseForgeEntries(triggerId, cat)
    local stockByName = {}
    for _, e in ipairs(entries) do
        if e.tier == t1 then stockByName[e.name] = (stockByName[e.name] or 0) + 1 end
    end
    local need = {}
    for _, n in ipairs({n1, n2, n3}) do need[n] = (need[n] or 0) + 1 end
    for name, cnt in pairs(need) do
        if (stockByName[name] or 0) < cnt then
            alertError(triggerId, "보유 수량 부족: " .. name); return
        end
    end

    local consumedNeed = {}
    for _, n in ipairs({n1, n2, n3}) do consumedNeed[n] = (consumedNeed[n] or 0) + 1 end
    local kept = {}
    for _, e in ipairs(entries) do
        if e.tier == t1 and consumedNeed[e.name] and consumedNeed[e.name] > 0 then
            consumedNeed[e.name] = consumedNeed[e.name] - 1
        else
            kept[#kept+1] = e.raw
        end
    end
    setChatVar(triggerId, cfg.detailsVar, (#kept == 0) and "None" or table.concat(kept, ";;"))

    local oldList = __impl.safeGetVar(triggerId, cfg.listVar, "None")
    if oldList ~= "None" and oldList ~= "" and oldList ~= "null" then
        local nameRemove = {}
        for _, n in ipairs({n1, n2, n3}) do nameRemove[n] = (nameRemove[n] or 0) + 1 end
        local remaining = {}
        for nm in oldList:gmatch("([^,]+)") do
            nm = nm:match("^%s*(.-)%s*$")
            if nm ~= "" and nameRemove[nm] and nameRemove[nm] > 0 then
                nameRemove[nm] = nameRemove[nm] - 1
            elseif nm ~= "" then
                remaining[#remaining+1] = nm
            end
        end
        setChatVar(triggerId, cfg.listVar, (#remaining == 0) and "None" or table.concat(remaining, ", "))
    end

    -- 강화된 카테고리만 슬롯 초기화 (다른 카테고리 슬롯 보존)
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "1", "")
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "2", "")
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "3", "")
    __impl.appendSaveToCurrentMessage(triggerId)

    local newTier = t1 + 1
    local stars = string.rep("⭐", t1)
    local newStars = string.rep("⭐", newTier)
    local msg = string.format("%s %s 강화: %s 3개 합성 → %s 강화 [FORGE_REQUEST:%s|%d→%d|%s]",
        cfg.icon, cfg.label, stars, newStars, cat, t1, newTier, table.concat({n1, n2, n3}, " + "))
    -- #343: 비-가챠 addChat 핸들러는 cv_gachaPanelOpen=0 (이전 가챠 세션 잔재로 패널 자동 재오픈 방지)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    -- #373 (Bug 5): 강화 완료 = forge UX 종료 → 다음 AI 응답에서 사이드 패널 닫힘
    setChatVar(triggerId, "cv_forgeOpen",        "0")
    setChatVar(triggerId, "cv_forgeActiveSlot",  "0")
    addChat(triggerId, "user", msg)
end

-- AUX 모드 ON/OFF — chat 변수 cv_auxMode ("1" = ON 기본, "0" = OFF)
-- 글로벌 변수 setGlobalVar이 risu-trigger 컨텍스트에서 작동 불안정 → chat 변수로 안정화
-- #373 후속 (Bug 2): 가이드 패널 안의 버튼 → 가이드 유지 + 잔재 (가챠/인벤/강화) 닫음 + SAVE 강제 재렌더
function __impl._stayInGuide(triggerId)
    __impl.smartSetChatVar(triggerId, "cv_guideOpen",      "1")
    __impl.smartSetChatVar(triggerId, "cv_invOpen",        "0")
    __impl.smartSetChatVar(triggerId, "cv_gachaPanelOpen", "0")
    __impl.smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_debugOpen",      "0")
    __impl.appendSaveToCurrentMessage(triggerId)
end

function __impl._stayInDebug(triggerId)
    __impl.smartSetChatVar(triggerId, "cv_debugOpen",      "1")
    __impl.smartSetChatVar(triggerId, "cv_invOpen",        "0")
    __impl.smartSetChatVar(triggerId, "cv_gachaPanelOpen", "0")
    __impl.smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_guideOpen",      "0")
end

-- #343: 가챠 버튼 클릭 시 사이드 패널 유지 — addChat 재렌더 후에도 radio가 checked 상태로 복원되도록
-- cv_gachaPanelOpen=1 마킹. STATUS_PANEL out HTML이 var=1 일 때 #gi-side-gacha 라디오에 checked 부착.
-- #373 후속 (Bug 3): cv_panelStayOnce="gacha" 설정 → onOutput END 가 이번 응답만 stay 허용 후 자동 reset
--                  → 후속 응답마다 패널 자동 열림 잔재 차단
function __impl._markGachaPanelStay(triggerId)
    __impl.smartSetChatVar(triggerId, "cv_gachaPanelOpen", "1")
    __impl.smartSetChatVar(triggerId, "cv_panelStayOnce",  "gacha")
    -- #373 Bug 1 후속: 다른 패널들 잔재 닫음 (가챠 클릭 시 가이드/인벤/강화 패널이 동시 checked 되어 last-in-DOM 으로 잘못 잡히는 거 차단)
    __impl.smartSetChatVar(triggerId, "cv_invOpen",        "0")
    __impl.smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_guideOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_debugOpen",      "0")
    -- #344: 옛 chat 호환 — onOutput 안 돌고 가챠 버튼 먼저 누르는 경우(레거시) 대비
    -- 현재 chat에서 마지막 char 메시지 인덱스 찾아 cv_lastCharMsgId 설정. 게이트가 lastmessageid 대신 이걸 비교
    local chatLength = getChatLength(triggerId)
    for i = chatLength - 1, 0, -1 do
        local msg = getChat(triggerId, i)
        if msg and msg.role == "char" then
            setChatVar(triggerId, "cv_lastCharMsgId", tostring(i))
            break
        end
    end
end

-- 사이드 패널 닫기 (✕ 버튼 / backdrop 클릭 시 호출) — 채팅 전환·재방문 후 패널 auto-reopen 차단
-- 단순 <label for="gi-side-none"> 는 CSS 라디오 상태만 바꾸고 cv_*Open 변수는 그대로라
-- 다른 채팅 갔다 돌아오면 CBS 가 cv_*Open=1 보고 패널 재오픈. 명시적 reset 필요.
-- ✕ 버튼 / backdrop 클릭 시 chat var 만 클리어 (CSS 슬라이드 애니메이션 보존).
--   reloadDisplay 호출 시 DOM 재렌더링되어 CSS transition 끊김 → 호출 안 함.
--   appendSaveToCurrentMessage 의 setChat 도 마찬가지 → 호출 안 함 (다음 응답 onOutput 끝의 자동 SAVE 에 위임).
--   CSS 닫힘 애니메이션은 <label for="gi-side-none"> 의 라디오 변경이 담당.
function __impl.closeSidePanel(triggerId)
    __impl.smartSetChatVar(triggerId, "cv_invOpen",        "0")
    __impl.smartSetChatVar(triggerId, "cv_gachaPanelOpen", "0")
    __impl.smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_guideOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_debugOpen",      "0")
    __impl.smartSetChatVar(triggerId, "cv_panelStayOnce",  "")
end

-- 보급품 카테고리 1회 분 결정 (stage 1+ <생존> 보정 포함)
function __impl.pickSupplyCats(triggerId)
    local c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
    local c2

    local stage = tonumber(__impl.safeGetVar(triggerId, "cv_islandStage", "0")) or 0
    if stage >= 1 then
        local maxHp     = tonumber(__impl.safeGetVar(triggerId, "cv_maxHp",     "100")) or 100
        local curHp     = tonumber(__impl.safeGetVar(triggerId, "cv_hp",        "100")) or 100
        local maxMana   = tonumber(__impl.safeGetVar(triggerId, "cv_maxMana",   "100")) or 100
        local curMana   = tonumber(__impl.safeGetVar(triggerId, "cv_mana",      "100")) or 100
        local maxHunger = tonumber(__impl.safeGetVar(triggerId, "cv_maxHunger", "100")) or 100
        local curHunger = tonumber(__impl.safeGetVar(triggerId, "cv_hunger",    "100")) or 100

        local hpPct     = maxHp > 0     and (curHp / maxHp)         or 1
        local manaPct   = maxMana > 0   and (curMana / maxMana)     or 1
        local hungerPct = maxHunger > 0 and (curHunger / maxHunger) or 1

        if hpPct >= 1 and manaPct >= 1 and hungerPct >= 1 then
            c2 = GACHA_CAT2_SUPPLY[math.random(#GACHA_CAT2_SUPPLY)]
            print(string.format("[GachaIsland] SUPPLY_BIAS: stage%d 모든 스탯 만충 → 랜덤(%s)", stage, c2))
        else
            local lowest = "HP"
            local lowestPct = hpPct
            if manaPct < lowestPct then lowest = "MANA"; lowestPct = manaPct end
            if hungerPct < lowestPct then lowest = "HUNGER"; lowestPct = hungerPct end

            if     lowest == "HP"     then c2 = "HP회복"
            elseif lowest == "MANA"   then c2 = "마나회복"
            else                            c2 = "배고픔회복"
            end
            print(string.format("[GachaIsland] SUPPLY_BIAS: stage%d <생존> 보정 → %s (HP:%.0f%% MANA:%.0f%% HUNGER:%.0f%%)", stage, c2, hpPct*100, manaPct*100, hungerPct*100))
        end
    else
        c2 = GACHA_CAT2_SUPPLY[math.random(#GACHA_CAT2_SUPPLY)]
    end

    return c1, c2
end

-- #341: 랜덤 가챠 1회분 추첨 결과를 메시지 fragment로 빌드 (gachaRandom + gachaRandomAll 공유)
-- 반환: fragment string (예: "[GACHA_CATS:랜덤|Skill|...][GACHA_TIER:N]")
function __impl.buildFragment(triggerId)
    local typ = __impl.rollRandomGachaType()
    local c1, c2, c3 = "", "", ""
    if typ == "Relic" then
        c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
        c2 = GACHA_CAT2_RELIC[math.random(#GACHA_CAT2_RELIC)]
    elseif typ == "Facility" then
        c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
        c2 = GACHA_CAT2_FAC[math.random(#GACHA_CAT2_FAC)]
    elseif typ == "Skill" then
        c1 = GACHA_CAT2_SKILL1[math.random(#GACHA_CAT2_SKILL1)]
        c2 = GACHA_CAT2_SKILL2[math.random(#GACHA_CAT2_SKILL2)]
    elseif typ == "Supply" then
        c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
        c2 = GACHA_CAT2_SUPPLY[math.random(#GACHA_CAT2_SUPPLY)]
    elseif typ == "Couple" then
        c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
        c2 = GACHA_CAT2_COUPLE[math.random(#GACHA_CAT2_COUPLE)]
        c3 = GACHA_CAT3_COUPLE[math.random(#GACHA_CAT3_COUPLE)]
    end
    if c1 ~= "" then
        local tier = __impl.rollGachaTier()
        -- #425: 랜덤 가챠에서 Skill + 공격 sub-type 일 때 range axis 추첨
        local extra = ""
        if typ == "Skill" and c2 == "공격" then
            extra = "|" .. GACHA_CAT3_SKILL_RANGE[math.random(#GACHA_CAT3_SKILL_RANGE)]
        end
        if typ == "Couple" then
            extra = "|" .. c3
        end
        return "[GACHA_CATS:랜덤|" .. typ .. "|" .. c1 .. "|" .. c2 .. extra .. "][GACHA_TIER:" .. tier .. "]"
    else
        -- Companion: 서브 카테고리 없음 — Lua 사전 추첨
        local picked = __impl.pickRandomCompanion(triggerId)
        if picked then
            setChatVar(triggerId, "cv_lastGachaPick", picked.ko)
            print(string.format("[GachaIsland] RANDOM→COMPANION_PICK: %s (%s)", picked.ko, picked.en))
            return "[GACHA_CATS:랜덤|" .. typ .. "][GACHA_PICK:" .. picked.ko .. "|" .. picked.en .. "]"
        else
            return "[GACHA_CATS:랜덤|" .. typ .. "]"
        end
    end
end

-- =============================================
-- ROUND SYSTEM (Phase 1) — 라운드 카운터 + UI 패널 + advance 메커니즘
-- 던전 형식별 라운드 수: 결전형=1, 탐색/토벌/미로=3~10 (형식별 별도 범위)
-- 라운드 이벤트 시퀀스: cv_roundEvents에 "E|E|S|E|E" 형식 저장 (E=Event, S=Sanctuary, B=Boss)
-- 결전형: 1 라운드, 보스 1마리 multi-phase
-- =============================================
-- 라운드 시스템 — 4종 운용 (탐색형 / 토벌형 / 미로형 / 결전형)
-- 탐색형: 5~10 라운드, mid=S, last=B, 나머지 random (M 40% / T 25% / E 25% / I 10%)
-- 토벌형: 3~6 라운드, mid=S, last=B, 나머지 모두 M (몬스터만)
-- 미로형: 무한 라운드 (cv_totalRounds=0). 모든 라운드 E (탐색) 고정 (#436). 마나/허기만 소모. NO M/T/I.
-- 결전형: 1 라운드, B (보스 단일)
-- 이벤트 코드: M=몬스터 / E=탐색 / T=함정 / I=보급품 / S=성역 / B=보스 / X=출구
-- 성역 위치: mid = math.floor(total / 2) + 1 → 4→3, 5→3, 6→4, 7→4, 8→5, 9→5, 10→6
function __impl.rollRoundsForFloor(triggerId, dungeonType)
    __impl.refreshSeed(triggerId)
    local totalRounds
    local events = {}

    -- 형식별 비전투 이벤트 가중치 풀 (탐색형/미로형)
    local function pickRandomEvent(weights)
        local r = math.random(100)
        local acc = 0
        for _, w in ipairs(weights) do
            acc = acc + w.weight
            if r <= acc then return w.code end
        end
        return weights[#weights].code  -- fallback
    end

    if dungeonType == "결전형" then
        totalRounds = 1
        events = { "B" }
    elseif dungeonType == "탐색형" then
        -- 5~10 라운드. M 40% / T 25% / E 25% / I 10%
        totalRounds = math.random(5, 10)
        local mid = math.floor(totalRounds / 2) + 1
        local weights = {
            {code="M", weight=40}, {code="T", weight=25},
            {code="E", weight=25}, {code="I", weight=10},
        }
        for i = 1, totalRounds do
            if     i == mid          then events[i] = "S"
            elseif i == totalRounds  then events[i] = "B"
            else                          events[i] = pickRandomEvent(weights)
            end
        end
    elseif dungeonType == "토벌형" then
        -- 3~6 라운드, 나머지 모두 M
        totalRounds = math.random(3, 6)
        local mid = math.floor(totalRounds / 2) + 1
        for i = 1, totalRounds do
            if     i == mid          then events[i] = "S"
            elseif i == totalRounds  then events[i] = "B"
            else                          events[i] = "M"
            end
        end
    elseif dungeonType == "미로형" then
        -- #308 미로형 무한 라운드 시스템. cv_totalRounds=0 (무한 표시).
        -- cv_mazeEscapeCount: 매 advanceRound 시 cv_combatResult ∈ {대성공, 성공}이면 +1
        -- 3 도달 시 X (출구) 라운드 자동 발생
        -- #436: 미로형 = exploration-only. 모든 라운드 E (탐색). M/T/I 제거. 마나/허기만 소모.
        -- cv_mazeFailStreak: 보통/실패/대실패 누적 카운트. 다음 라운드 rate +5% per stack. 성공 시 reset (anti-stall).
        totalRounds = 0  -- 무한 표시
        setChatVar(triggerId, "cv_mazeEscapeCount", "0")
        setChatVar(triggerId, "cv_mazeFailStreak", "0")  -- #436
        events = { "E" }  -- #436 첫 라운드 E 고정 (이전: weighted E70/T15/M10/I5)
    else
        -- 미지정 fallback: 3/5/7 무작위 + 정중앙 S + 마지막 B
        local pool = { 3, 5, 7 }
        totalRounds = pool[math.random(#pool)]
        local mid = math.floor(totalRounds / 2) + 1
        for i = 1, totalRounds do
            if     i == mid          then events[i] = "S"
            elseif i == totalRounds  then events[i] = "B"
            else                          events[i] = "M"
            end
        end
    end

    setChatVar(triggerId, "cv_currentRound", "1")
    setChatVar(triggerId, "cv_totalRounds",  tostring(totalRounds))
    setChatVar(triggerId, "cv_roundEvents",  table.concat(events, "|"))
    setChatVar(triggerId, "cv_hungerDrainAppliedRound", "-1")  -- 새 던전/floor 진입 시 reset (이전 던전 잔재 차단)
    print(string.format("[GachaIsland] ROUNDS_ROLLED: %s floor, %d rounds, seq=%s",
        dungeonType, totalRounds, table.concat(events, "|")))
end

-- 라운드 패널 HTML 생성 (정규식이 {{getvar::cv_roundPanel}}로 출력)
function __impl.buildRoundPanel(triggerId)
    local dungeonActive = __impl.safeGetVar(triggerId, "cv_dungeonActive", "0")
    if dungeonActive ~= "1" then
        setChatVar(triggerId, "cv_roundPanel", "")
        return
    end
    local total = tonumber(__impl.safeGetVar(triggerId, "cv_totalRounds", "0")) or 0
    local cur   = tonumber(__impl.safeGetVar(triggerId, "cv_currentRound", "0")) or 0
    local evStr = __impl.safeGetVar(triggerId, "cv_roundEvents", "")
    local dType = __impl.safeGetVar(triggerId, "cv_activeDungeonType", "None")

    local events = {}
    for e in evStr:gmatch("([^|]+)") do events[#events+1] = e end

    -- #467 라운드 advance 직후 표시 lag — pendingSpawn=1 (advance 직후, 다음 라운드 monster 미spawn) 면
    --   visual cur 을 cur-1 로 표시 → "방금 끝낸 라운드" 가 current 로 보이게.
    --   cur=1 (첫 라운드 setup 직후) 은 예외 — advance 안 일어났음.
    -- #507: S/X/T/I/E (비전투) 라운드는 visual lag 적용 안 함 — pendingSpawn=1 이 SAVE_LOAD 로 복원돼도
    --   실제 cur 표시. 전투 라운드 (M/B) 만 「다음 monster spawn 대기」 라 visual lag 적용 의미 있음.
    -- #534: 미로형 = 모든 라운드 E 고정. advance 시 pendingSpawn=1 set 됨. 사용자가 narrate 한 round 와
    --   panel 의 round 가 일치하도록 미로형 도 visual lag 대상에 포함 (escape count 도 같이 lag).
    local pendingSpawn = __impl.safeGetVar(triggerId, "cv_pendingMonsterSpawn", "0") == "1"
    local _curEv = events[cur] or ""
    local _isMaze = dType == "미로형"
    local _applyLag = pendingSpawn and cur > 1 and (_curEv == "M" or _curEv == "B" or _isMaze)
    if _applyLag then
        cur = cur - 1
    end
    -- #308 미로형 무한 모드: total=0이라도 패널 빌드 (사용자 명세 "?" 표기)
    if evStr == "" or (total <= 0 and dType ~= "미로형") then
        setChatVar(triggerId, "cv_roundPanel", "")
        return
    end

    -- 미로형: displayTotal = #events (동적), 패널 트랙 끝에 "?" 슬롯 추가 (탈출 전까지)
    -- #534: escape count 는 lag 안 함 — 사용자가 narrate 한 round 의 성공 결과 (escape +1) 를 패널에 즉시 반영
    --   (cur 만 lag → "라운드 N (narrate 직후) — 진행 M/3" 형태로 표시)
    local mazeEscapeCount = tonumber(__impl.safeGetVar(triggerId, "cv_mazeEscapeCount", "0")) or 0
    local displayTotal = (dType == "미로형") and #events or total

    -- 이벤트 → 아이콘 매핑 (#305 신규: M/T/I/E 분리)
    local iconFor = function(ev, isPast, isCurrent)
        local icon = "⚔"
        if     ev == "S" then icon = "⛲"
        elseif ev == "B" then icon = "👑"
        elseif ev == "X" then icon = "🚪"
        elseif ev == "M" then icon = "⚔"  -- 몬스터 전투
        elseif ev == "T" then icon = "⚠"  -- 함정
        elseif ev == "I" then icon = "📦"  -- 보급품 발견
        elseif ev == "E" then icon = "🗺"  -- 탐색 (신규 의미: 비전투 자유 narration / 옛 E는 동일 아이콘으로 표시)
        end
        return icon
    end

    -- 형식별 헤더
    local headerLabel
    if     dType == "결전형" then headerLabel = "⚔ 결전 — 단일 라운드"
    elseif dType == "탐색형" then headerLabel = string.format("🗺 탐색 라운드 %d / %d", cur, total)
    elseif dType == "토벌형" then headerLabel = string.format("⚔ 토벌 라운드 %d / %d", cur, total)
    elseif dType == "미로형" then
        -- #308 미로형: 무한 라운드 + 탈출 진행도
        if mazeEscapeCount >= 3 then
            headerLabel = string.format("🌀 미로 라운드 %d — 🚪 출구!", cur)
        else
            headerLabel = string.format("🌀 미로 라운드 %d / ? — 탈출 진행 %d / 3", cur, mazeEscapeCount)
        end
    else                          headerLabel = string.format("던전 라운드 %d / %d", cur, total)
    end

    -- 라운드 트랙 (각 step)
    local steps = {}
    for i = 1, displayTotal do
        local ev = events[i] or "E"
        local icon = iconFor(ev)
        local state, opacity, scale, ring
        if i < cur then
            state = "done";    opacity = "0.45"; scale = "0.92"; ring = "transparent"
        elseif i == cur then
            state = "current"; opacity = "1";    scale = "1.15"; ring = "#ffd966"
        else
            state = "pending"; opacity = "0.7";  scale = "1";    ring = "transparent"
        end
        local bgColor
        if     ev == "S" then bgColor = "linear-gradient(135deg,#4ea3ff,#2b6bdb)"  -- 파랑 (성역)
        elseif ev == "B" then bgColor = "linear-gradient(135deg,#ff7a4e,#c93f1c)"  -- 빨강 (보스)
        elseif ev == "X" then bgColor = "linear-gradient(135deg,#b8a3ff,#5a3fc9)"  -- 보라 (출구)
        elseif ev == "M" then bgColor = "linear-gradient(135deg,#ff9870,#c95a32)"  -- 주황 (몬스터 전투)
        elseif ev == "T" then bgColor = "linear-gradient(135deg,#ffd166,#c98a1c)"  -- 황색 (함정)
        elseif ev == "I" then bgColor = "linear-gradient(135deg,#9eff9e,#3fa554)"  -- 녹색 (보급품)
        elseif ev == "E" then bgColor = "linear-gradient(135deg,#a0a8c0,#4a5070)"  -- 회청 (탐색)
        else                  bgColor = "linear-gradient(135deg,#5a5a6e,#2a2a3a)"  -- 회색 (미지정)
        end
        steps[#steps+1] = string.format(
            '<span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%%;background:%s;font-size:1.05em;line-height:1;opacity:%s;transform:scale(%s);box-shadow:0 0 0 2px %s,0 2px 6px rgba(0,0,0,0.4);transition:all 0.25s;">%s</span>',
            bgColor, opacity, scale, ring, icon
        )
    end
    -- #308 미로형: 카운트 < 3일 때 다음 라운드 "?" 미정 슬롯 추가 (사용자 명세)
    -- #329 화이트/블루 톤
    if dType == "미로형" and mazeEscapeCount < 3 then
        steps[#steps+1] = '<span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#e2e8f0,#cbd5e1);font-size:1.05em;line-height:1;opacity:0.7;color:#5a7b9a;font-weight:700;box-shadow:0 0 0 2px transparent,0 2px 6px rgba(45,108,176,0.15);transition:all 0.25s;">?</span>'
    end
    -- 화살표 연결 (sep)
    local sep = '<span style="opacity:0.6;font-size:0.9em;color:#5a7b9a;">›</span>'
    local trackHtml = table.concat(steps, sep)

    local panelHtml = string.format(
        '<div style="margin:8px auto 6px;max-width:680px;padding:10px 14px;border-radius:12px;background:rgba(245,251,255,0.97);border:1.5px solid rgba(45,108,176,0.45);box-shadow:0 4px 20px rgba(45,108,176,0.12),0 0 15px rgba(45,108,176,0.08);"><div style="font-size:0.78em;font-weight:700;color:#2d6cb0;letter-spacing:0.4px;margin-bottom:8px;text-shadow:0 0 8px rgba(45,108,176,0.2);">%s</div><div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:center;">%s</div></div>',
        headerLabel, trackHtml
    )
    setChatVar(triggerId, "cv_roundPanel", panelHtml)
end

-- =============================================
-- MONSTER SYSTEM (Phase 2) — HP 추적 + 층 스케일링 + 등급별 baseline + 다수 몬스터 패널
-- 데미지 공식: 스킬 데미지 = mana_cost × 2 (entry [15] / [3])
-- 받는 피해: cv_combatResult 실패/대실패 시 entry [15] HP Damage Table × 층 단계 자동 적용
-- (몬스터 공격력은 별도 변수 X — 받는 피해로 치환)
-- =============================================
-- #361: 4-tier 층 구간(저층/중층/고층/무한층) 전면 폐기 → 점진적 선형 multiplier.
--   공식: 1 + (floor - 1) × 0.15 (사용자 결정 — 직관 "10층=2배" 대비 약간 완만한 곡선)
--   1층=1.0 / 10층=2.35 / 50층=8.35 / 100층=15.85 / 500층=75.85
--   유저 데미지는 floor 무영향. 몬스터 HP만 ×m → 결과적으로 점점 단단해짐 ("묵시적 방어력").
--   처치 보상 (MONSTER_BASELINE.point × m) 도 자연 증가하여 가챠 비용 대비 균형 유지.
function __impl.floorMultiplier(floor)
    floor = tonumber(floor) or 1
    if floor < 1 then floor = 1 end
    return 1.0 + (floor - 1) * 0.15
end

-- 현재 라운드 이벤트 + 형식에 맞춰 몬스터 스폰
-- 결과: cv_currentMonsters = "tier|hp|maxHp|name;;tier|hp|maxHp|name"
function __impl.spawnMonstersForRound(triggerId)
    local active = __impl.safeGetVar(triggerId, "cv_dungeonActive", "0")
    if active ~= "1" then
        setChatVar(triggerId, "cv_currentMonsters", "")
        return
    end
    local dType = __impl.safeGetVar(triggerId, "cv_activeDungeonType", "None")
    local floor = tonumber(__impl.safeGetVar(triggerId, "cv_currentFloor", "1")) or 1
    local cur   = tonumber(__impl.safeGetVar(triggerId, "cv_currentRound", "1")) or 1
    local evStr = __impl.safeGetVar(triggerId, "cv_roundEvents", "")
    local events = {}
    for e in evStr:gmatch("([^|]+)") do events[#events+1] = e end
    local ev = events[cur] or "E"
    local mult = __impl.floorMultiplier(floor)
    __impl.refreshSeed(triggerId)

    local spawns = {}  -- {tier=..., name=...} list
    -- #305 새 이벤트 코드: M=몬스터 / E=탐색 / T=함정 / I=보급품 / S=성역 / B=보스 / W=wave / X=출구
    -- 옛 채팅 호환: E (구 의미: 확률적 일반 이벤트) 도 동일 분기 (탐색형 30% 전투 / 미로형 100% 비전투 #436)
    -- #436 legacy maze guard: 미로형 = exploration-only. M/T/I 라운드는 모두 E (탐색)로 처리 (구 채팅 호환).
    if dType == "미로형" and (ev == "M" or ev == "T" or ev == "I") then
        setChatVar(triggerId, "cv_currentMonsters", "")
        print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (legacy maze ev=%s → E exploration #436)", cur, ev))
        return
    end
    if ev == "S" or ev == "X" or ev == "T" or ev == "I" then
        -- 비전투 라운드 (성역 / 출구 / 함정 / 보급품)
        setChatVar(triggerId, "cv_currentMonsters", "")
        print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (%s) — non-combat", cur, ev))
        return
    elseif ev == "B" then
        spawns[1] = { tier = "boss", name = placeholderName("boss", 1) }
    elseif ev == "M" then
        -- #305 M = 명시적 몬스터 전투 라운드. 엘리트 20% 확률 (등장 시 엘리트 1마리만).
        if math.random(100) <= 20 then
            spawns[1] = { tier = "elite", name = placeholderName("elite", 1) }
        else
            local count = 1
            if     dType == "토벌형" then
                count = math.random(2, 3)
            elseif dType == "탐색형" then
                local roll = math.random(100)
                if     roll <= 70 then count = 1
                elseif roll <= 95 then count = 2
                else                  count = 3
                end
            end
            -- 미로형 / 기타: 1마리
            for i = 1, count do
                spawns[#spawns+1] = { tier = "normal", name = placeholderName("normal", i) }
            end
        end
    elseif ev == "E" then
        -- 옛 채팅 호환: E (구 의미) — 형식별 확률 분기
        --   탐색형 30% 전투 / 미로형 100% 비전투 (#436) / 토벌형 100% 전투 / 기타 0%
        --   신규 채팅에서는 E = 명시적 탐색(비전투)이지만 룰 일관성 위해 이 분기는 유지
        local nonCombatChance = 100
        if     dType == "탐색형" then nonCombatChance = 70
        elseif dType == "미로형" then nonCombatChance = 100  -- #436: 미로형 = exploration-only, 절대 spawn 안 함
        elseif dType == "토벌형" then nonCombatChance = 0
        end
        if math.random(100) <= nonCombatChance then
            setChatVar(triggerId, "cv_currentMonsters", "")
            print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (E %s 비전투) — supply/trap/sanity", cur, dType))
            return
        end
        spawns[#spawns+1] = { tier = "normal", name = placeholderName("normal", 1) }
    else
        -- 미지정 이벤트 → 비전투 처리 (안전판)
        setChatVar(triggerId, "cv_currentMonsters", "")
        print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (%s unknown) — non-combat fallback", cur, ev))
        return
    end

    -- 직렬화: tier|hp|maxHp|name (HP는 baseline × floor multiplier, round-up)
    local parts = {}
    for _, m in ipairs(spawns) do
        local base = MONSTER_BASELINE[m.tier] or MONSTER_BASELINE.normal
        local maxHp = math.ceil(base.hp * mult)
        parts[#parts+1] = string.format("%s|%d|%d|%s", m.tier, maxHp, maxHp, m.name)
    end
    setChatVar(triggerId, "cv_currentMonsters", table.concat(parts, ";;"))
    print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (%s) floor %d ×%.1f — %s", cur, ev, floor, mult, table.concat(parts, ";; ")))
end

-- 몬스터 HP 패널 HTML (분수 HP 바 스타일, 각자 따로 표시)
function __impl.buildMonsterPanel(triggerId)
    local active = __impl.safeGetVar(triggerId, "cv_dungeonActive", "0")
    if active ~= "1" then
        setChatVar(triggerId, "cv_monsterPanel", "")
        return
    end
    local mStr = __impl.safeGetVar(triggerId, "cv_currentMonsters", "")
    if mStr == "" then
        setChatVar(triggerId, "cv_monsterPanel", "")
        return
    end

    local bars = {}
    for entry in mStr:gmatch("([^;][^;]*)") do
        if entry ~= "" and entry ~= ";" then
            local tier, hp, maxHp, name = entry:match("([^|]+)|([^|]+)|([^|]+)|(.+)")
            if tier and hp and maxHp and name then
                local hpN  = tonumber(hp) or 0
                local maxN = tonumber(maxHp) or 1
                local pct  = math.max(0, math.min(100, math.floor(hpN / maxN * 100)))
                local label, barCol, ringCol
                if     tier == "boss"   then label = "⭐⭐⭐ "; barCol = "linear-gradient(90deg,#ff4e3a,#c91c1c)"; ringCol = "rgba(255,80,60,0.6)"
                elseif tier == "elite"  then label = "⭐⭐ ";   barCol = "linear-gradient(90deg,#b88aff,#7a3fc9)"; ringCol = "rgba(184,138,255,0.55)"
                else                         label = "⭐ ";    barCol = "linear-gradient(90deg,#d4a574,#8b6e2f)"; ringCol = "rgba(212,165,116,0.5)"
                end
                -- #329 화이트/블루 톤 (몬스터 등급별 색상은 의미 유지)
                local dead = hpN <= 0
                local nameStyle = dead and "color:#94a3b8;text-decoration:line-through;" or "color:#1e4d8b;"
                bars[#bars+1] = string.format(
                    '<div style="margin:4px 0;padding:6px 10px;background:#ffffff;border:1px solid %s;border-radius:8px;box-shadow:0 2px 6px rgba(45,108,176,0.08);"><div style="display:flex;align-items:center;justify-content:space-between;font-size:0.78em;%s margin-bottom:4px;"><span style="font-weight:700;">%s%s</span><span style="font-family:monospace;font-size:0.92em;color:#5a7b9a;opacity:0.85;">%d / %d</span></div><div style="position:relative;height:10px;background:rgba(45,108,176,0.08);border-radius:5px;overflow:hidden;border:1px solid rgba(45,108,176,0.15);"><div style="position:absolute;top:0;left:0;height:100%%;width:%d%%;background:%s;transition:width 0.5s cubic-bezier(0.25,0.46,0.45,0.94);box-shadow:0 0 8px %s;"></div></div></div>',
                    ringCol, nameStyle, label, name, hpN, maxN, pct, barCol, ringCol
                )
            end
        end
    end
    if #bars == 0 then
        setChatVar(triggerId, "cv_monsterPanel", "")
        return
    end
    local panel = string.format(
        '<div style="margin:6px auto;max-width:680px;padding:10px 12px;border-radius:12px;background:rgba(245,251,255,0.97);border:1.5px solid rgba(45,108,176,0.45);box-shadow:0 4px 20px rgba(45,108,176,0.12),0 0 15px rgba(45,108,176,0.08);"><div style="font-size:0.76em;font-weight:700;color:#2d6cb0;letter-spacing:0.4px;margin-bottom:6px;text-shadow:0 0 8px rgba(45,108,176,0.2);">⚔ 조우 몬스터</div>%s</div>',
        table.concat(bars, "")
    )
    setChatVar(triggerId, "cv_monsterPanel", panel)
end

-- 라운드 advance: AI가 [SYSTEM|ROUND_CLEAR] 출력 시 cv_currentRound +1
-- 마지막 라운드 도달 시 자동 멈춤 (층 클리어 처리는 별도 [SYSTEM|FLOOR:N] 태그가 담당)
-- 다음 라운드의 몬스터 자동 스폰
-- #308 미로형 분기: 무한 라운드 + cv_mazeEscapeCount 카운트 시스템
function __impl.advanceRound(triggerId)
    local cur   = tonumber(__impl.safeGetVar(triggerId, "cv_currentRound", "0")) or 0
    local total = tonumber(__impl.safeGetVar(triggerId, "cv_totalRounds",  "0")) or 0
    local dType = __impl.safeGetVar(triggerId, "cv_activeDungeonType", "None")

    -- #308 미로형 무한 라운드 분기
    if dType == "미로형" then
        -- #431 X 라운드 도달 후 또 advance 호출 차단 (무한 X 추가 위험 방지)
        local _evStr = __impl.safeGetVar(triggerId, "cv_roundEvents", "")
        local _events = {}
        for e in _evStr:gmatch("([^|]+)") do _events[#_events+1] = e end
        local _curEv = _events[cur] or ""
        if _curEv == "X" then
            print(string.format("[GachaIsland] MAZE_ADVANCE BLOCKED (#431): round %d ev=X 이미 출구 도달 — 또 advance 차단 (END SEQUENCE 출력만 허용)", cur))
            return
        end

        local result = __impl.safeGetVar(triggerId, "cv_combatResult", "보통")
        local count = tonumber(__impl.safeGetVar(triggerId, "cv_mazeEscapeCount", "0")) or 0
        local failStreak = tonumber(__impl.safeGetVar(triggerId, "cv_mazeFailStreak", "0")) or 0
        -- 성공 굴림 = 카운트 +1 (대성공/성공만) + failStreak reset
        -- 보통/실패/대실패 = 마나/허기 narrate + failStreak +1 (#436 anti-stall — 다음 라운드 +5%/stack)
        if result == "대성공" or result == "성공" then
            count = count + 1
            setChatVar(triggerId, "cv_mazeEscapeCount", tostring(count))
            setChatVar(triggerId, "cv_mazeFailStreak", "0")  -- #436 reset
            print(string.format("[GachaIsland] MAZE_COUNT: +1 (result=%s) → %d/3, failStreak reset", result, count))
        else
            failStreak = failStreak + 1
            setChatVar(triggerId, "cv_mazeFailStreak", tostring(failStreak))
            print(string.format("[GachaIsland] MAZE_COUNT: 유지 %d/3 (result=%s — 마나/허기 narrate, failStreak=%d → next rate +%d%%)", count, result, failStreak, failStreak * 5))
        end

        -- cv_currentRound + cv_roundEvents 동적 추가
        local newCur = cur + 1
        local evStr = __impl.safeGetVar(triggerId, "cv_roundEvents", "")

        -- 카운트 3 도달 → 다음 라운드를 X (출구)로 강제
        if count >= 3 then
            evStr = (evStr == "") and "X" or (evStr .. "|X")
            setChatVar(triggerId, "cv_roundEvents",  evStr)
            setChatVar(triggerId, "cv_currentRound", tostring(newCur))
            setChatVar(triggerId, "cv_totalRounds",  tostring(newCur))  -- 표시용
            -- #495: 미로 X = 비전투 출구. pendingSpawn flag 끄기 (set=1 이면 #454 가드가 FLOOR_END_AUTO 차단)
            setChatVar(triggerId, "cv_pendingMonsterSpawn", "0")
            print(string.format("[GachaIsland] MAZE_ESCAPE: 카운트 3 도달 → 라운드 %d X (출구) 자동 진입", newCur))

            -- 미로형 탈출 보너스 POINT: 진행한 라운드 × 500P × floor multiplier
            local _floor = tonumber(__impl.safeGetVar(triggerId, "cv_currentFloor", "0")) or 0
            local _mult = __impl.floorMultiplier(_floor)
            local _bonus = math.ceil(newCur * 500 * _mult)
            local _ptsClean = (__impl.safeGetVar(triggerId, "cv_points", "0")):gsub(",", "")
            local _curPts = tonumber(_ptsClean) or 0
            local _newPts = _curPts + _bonus
            local _fmt = tostring(_newPts):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
            setChatVar(triggerId, "cv_points", _fmt)
            print(string.format("[GachaIsland] MAZE_ESCAPE_BONUS (#417): %d rounds × 500P × m=%.2f → +%dP (total %s)", newCur, _mult, _bonus, _fmt))

            -- 메시지에 NOTIFY 카드 append (사용자 가시성)
            local _lastIdx = getChatLength(triggerId) - 1
            local _msg = getChat(triggerId, _lastIdx)
            if _msg and _msg.data then
                local _notify = string.format("\n[SYSTEM|NOTIFY:🗝 미로 탈출 보너스 +%dP (%d 라운드 탐험)]", _bonus, newCur)
                setChat(triggerId, _lastIdx, _msg.data .. _notify)
            end

            -- #497: starvation HP 차감은 onOutput 마다 1회로 통합 (호출 제거)
            return
        end

        -- #436: 카운트 미달 → 다음 라운드 E (탐색) 고정. M/T/I 모두 제거.
        evStr = (evStr == "") and "E" or (evStr .. "|E")
        setChatVar(triggerId, "cv_roundEvents", evStr)
        setChatVar(triggerId, "cv_currentRound", tostring(newCur))
        -- spawn 보류 (E는 비전투지만 일관성 위해 flag set — spawnMonstersForRound가 E + 미로형 = cv_currentMonsters="" 처리)
        setChatVar(triggerId, "cv_pendingMonsterSpawn", "1")
        print(string.format("[GachaIsland] MAZE_ADVANCE (#436): round %d → %d, ev=E (exploration-only), escape=%d/3, failStreak=%d", cur, newCur, count, failStreak))
        -- #497: starvation HP 차감은 onOutput 마다 1회로 통합 (호출 제거)
        return
    end

    -- 일반 던전 (탐색/토벌/결전/방어): 기존 로직
    if total <= 0 then return end
    if cur >= total then
        print(string.format("[GachaIsland] ROUND_ADVANCE: 마지막 라운드 (%d/%d), advance 안 함", cur, total))
        return
    end
    local newCur = cur + 1
    setChatVar(triggerId, "cv_currentRound", tostring(newCur))
    print(string.format("[GachaIsland] ROUND_ADVANCE: %d → %d (of %d) (spawn deferred)", cur, newCur, total))
    -- #383: 새 라운드 몬스터 spawn 보류 → 다음 editRequest hook 시 처리
    -- (LLM이 같은 응답에서 다음 라운드 narrate 시 placeholder "적/적 2" 노출 차단)
    setChatVar(triggerId, "cv_pendingMonsterSpawn", "1")
    -- #497: starvation HP 차감은 onOutput 마다 1회로 통합 (호출 제거)
end

-- stat string "ATK:5,DEF:3,..." → table {ATK=5,DEF=3,...}. nil/빈문자열 → 빈 table.
function __impl.eqStatParse(statStr)
    local t = {ATK=0, DEF=0, LUCK=0, MAXHP=0, MAXMANA=0, MAXHUNGER=0, SLOT=0}
    if not statStr or statStr == "" or statStr == "null" then return t end
    for k, v in statStr:gmatch("([A-Z]+):(%-?%d+)") do
        t[k] = tonumber(v) or 0
    end
    return t
end

-- stat table → string "ATK:5,DEF:3,..." (0인 키 생략). 모두 0이면 빈 문자열.
function __impl.eqStatSerialize(t)
    if not t then return "" end
    local parts = {}
    for _, k in ipairs(EQUIP_STAT_KEYS) do
        local v = t[k] or 0
        if v ~= 0 then
            table.insert(parts, k .. ":" .. tostring(v))
        end
    end
    return table.concat(parts, ",")
end

-- EFFECT 텍스트에서 stat 추출 (마이그레이션용). "ATK +5", "DEF +10", "LUCK +5", "MAX HP +25" 등
function __impl.eqStatExtractFromEffect(effect)
    local t = {ATK=0, DEF=0, LUCK=0, MAXHP=0, MAXMANA=0, MAXHUNGER=0, SLOT=0}
    if not effect or effect == "" then return t end
    local txt = effect
    -- 한글/영문 다양한 표기 정규화: "ATK +5" / "공격력 +5" / "공격 +5"
    for v in txt:gmatch("ATK%s*([%+%-]?%s*%d+)") do t.ATK = t.ATK + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("공격력?%s*([%+%-]?%s*%d+)") do t.ATK = t.ATK + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("DEF%s*([%+%-]?%s*%d+)") do t.DEF = t.DEF + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("방어력?%s*([%+%-]?%s*%d+)") do t.DEF = t.DEF + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("LUCK%s*([%+%-]?%s*%d+)") do t.LUCK = t.LUCK + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("행운%s*([%+%-]?%s*%d+)") do t.LUCK = t.LUCK + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("MAX%s*HP%s*([%+%-]?%s*%d+)") do t.MAXHP = t.MAXHP + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*HP%s*([%+%-]?%s*%d+)") do t.MAXHP = t.MAXHP + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*체력%s*([%+%-]?%s*%d+)") do t.MAXHP = t.MAXHP + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("MAX%s*MANA%s*([%+%-]?%s*%d+)") do t.MAXMANA = t.MAXMANA + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*MANA%s*([%+%-]?%s*%d+)") do t.MAXMANA = t.MAXMANA + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*마나%s*([%+%-]?%s*%d+)") do t.MAXMANA = t.MAXMANA + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("MAX%s*HUNGER%s*([%+%-]?%s*%d+)") do t.MAXHUNGER = t.MAXHUNGER + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*HUNGER%s*([%+%-]?%s*%d+)") do t.MAXHUNGER = t.MAXHUNGER + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*허기%s*([%+%-]?%s*%d+)") do t.MAXHUNGER = t.MAXHUNGER + (tonumber((v:gsub("%s+",""))) or 0) end
    -- 슬롯 +1 (시설용)
    for v in txt:gmatch("장착%s*슬롯%s*([%+%-]?%s*%d+)") do t.SLOT = t.SLOT + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("SLOT%s*([%+%-]?%s*%d+)") do t.SLOT = t.SLOT + (tonumber((v:gsub("%s+",""))) or 0) end
    return t
end

-- detailsStr에서 targetName entry의 stat table 반환 (없으면 nil)
-- #373 Bug 3 후속: 5번째 stat 필드 없으면 (legacy / GACHA_STAT_ABSORB 직전 항목만 처리해 누락된 옛 항목)
-- 4번째 EFFECT 텍스트에서 자동 추출 (ATK +18, LUCK +7 등) → 장착 시 능력치 정상 반영
function __impl.eqGetEntryStat(detailsStr, targetName)
    for _, entry in ipairs(eqSplitEntries(detailsStr)) do
        local n, _, _, eff, statStr = eqParseEntry(entry)
        if n and eqExtractBase(n) == targetName then
            if statStr and statStr ~= "" and statStr ~= "null" then
                return __impl.eqStatParse(statStr)
            elseif eff and eff ~= "" then
                -- fallback: EFFECT 텍스트에서 stat 추출
                return __impl.eqStatExtractFromEffect(eff)
            end
            return __impl.eqStatParse(nil)  -- 모두 비어있으면 0
        end
    end
    return nil
end

-- detailsStr에서 특정 name entry의 stat 필드를 statTable로 갱신 (entry 자체 in-place 수정)
-- 기존 5필드 없으면 추가, 있으면 교체. detailsStr 새 문자열 반환.
function __impl.eqUpdateEntryStat(detailsStr, targetName, statTable)
    local entries = eqSplitEntries(detailsStr)
    local changed = false
    for i, entry in ipairs(entries) do
        local n, d, t, eff = eqParseEntry(entry)
        if n and eqExtractBase(n) == targetName then
            local statStr = __impl.eqStatSerialize(statTable)
            local newEntry = (n or "") .. "||" .. (d or "") .. "||" .. (t or "1") .. "||" .. (eff or "") .. "||" .. statStr
            entries[i] = newEntry
            changed = true
            break
        end
    end
    if not changed then return detailsStr end
    if #entries == 0 then return "None" end
    return table.concat(entries, ";;")
end

-- 장착된 스킬+유물의 stat 합산 → cv_attack/defense/luck/maxHp/maxMana/maxHunger 갱신
-- 시설 stat은 슬롯 한도 계산에만 사용 (별도 함수 eqRecalcSlots).
function __impl.eqRecalcStats(triggerId)
    local atkBase = tonumber(__impl.safeGetVar(triggerId, "cv_attack_base",  "5"))   or 5
    local defBase = tonumber(__impl.safeGetVar(triggerId, "cv_defense_base", "5"))   or 5
    local lckBase = tonumber(__impl.safeGetVar(triggerId, "cv_luck_base",    "0"))   or 0
    local hpBase  = tonumber(__impl.safeGetVar(triggerId, "cv_maxHp_base",   "100")) or 100
    local mnBase  = tonumber(__impl.safeGetVar(triggerId, "cv_maxMana_base", "100")) or 100
    local hgBase  = tonumber(__impl.safeGetVar(triggerId, "cv_maxHunger_base","100")) or 100

    local atk, def, lck, mhp, mmn, mhg = atkBase, defBase, lckBase, hpBase, mnBase, hgBase

    local skillDetails = __impl.safeGetVar(triggerId, "cv_skillDetails", "None")
    local relicDetails = __impl.safeGetVar(triggerId, "cv_relicDetails", "None")
    local equippedSk   = __impl.safeGetVar(triggerId, "cv_equippedSkills", "None")
    local equippedRl   = __impl.safeGetVar(triggerId, "cv_equippedRelics", "None")

    if equippedSk ~= "None" and equippedSk ~= "" and equippedSk ~= "null" then
        for n in equippedSk:gmatch("([^,]+)") do
            n = n:match("^%s*(.-)%s*$")
            local s = __impl.eqGetEntryStat(skillDetails, n)
            if s then
                atk = atk + s.ATK;       def = def + s.DEF;       lck = lck + s.LUCK
                mhp = mhp + s.MAXHP;     mmn = mmn + s.MAXMANA;   mhg = mhg + s.MAXHUNGER
            end
        end
    end
    if equippedRl ~= "None" and equippedRl ~= "" and equippedRl ~= "null" then
        for n in equippedRl:gmatch("([^,]+)") do
            n = n:match("^%s*(.-)%s*$")
            local s = __impl.eqGetEntryStat(relicDetails, n)
            if s then
                atk = atk + s.ATK;       def = def + s.DEF;       lck = lck + s.LUCK
                mhp = mhp + s.MAXHP;     mmn = mmn + s.MAXMANA;   mhg = mhg + s.MAXHUNGER
            end
        end
    end

    -- #483 시설 stat 자동 합산 (보유 = 발동, 장착 개념 없음)
    --   기존: eqRecalcSlots 가 시설의 SLOT 필드만 처리. ATK/DEF/LUCK/MAXHP/MAXMANA/MAXHUNGER 는 합산 누락.
    --   #353 EQUIP SYSTEM 도입 시 스킬/유물 장착 합산만 작성, 시설 (장착 X) 은 깜빡함. 사용자 보고로 fix.
    --   시설은 모든 entry 의 stat 누적 합산. EFFECT 폴백 (#373) 도 지원.
    local facDetails = __impl.safeGetVar(triggerId, "cv_facilityDetails", "None")
    if facDetails ~= "None" and facDetails ~= "" and facDetails ~= "null" then
        for _, entry in ipairs(eqSplitEntries(facDetails)) do
            local n, _, _, eff, statStr = eqParseEntry(entry)
            if n then
                local s
                if statStr and statStr ~= "" and statStr ~= "null" then
                    s = __impl.eqStatParse(statStr)
                elseif eff and eff ~= "" then
                    s = __impl.eqStatExtractFromEffect(eff)
                end
                if s then
                    atk = atk + (s.ATK or 0);       def = def + (s.DEF or 0);       lck = lck + (s.LUCK or 0)
                    mhp = mhp + (s.MAXHP or 0);     mmn = mmn + (s.MAXMANA or 0);   mhg = mhg + (s.MAXHUNGER or 0)
                    -- SLOT 은 eqRecalcSlots 가 별도 처리 — 여기선 합산 안 함 (중복 방지)
                end
            end
        end
    end

    -- 음수 방어 (base 자체가 0 이하인 경우 가챠 stat이 음수 효과면 0으로)
    if atk < 0 then atk = 0 end
    if def < 0 then def = 0 end
    if lck < 0 then lck = 0 end
    if mhp < 1 then mhp = 1 end
    if mmn < 1 then mmn = 1 end
    if mhg < 1 then mhg = 1 end

    __impl.smartSetChatVar(triggerId, "cv_attack",    tostring(atk))
    __impl.smartSetChatVar(triggerId, "cv_defense",   tostring(def))
    __impl.smartSetChatVar(triggerId, "cv_luck",      tostring(lck))
    __impl.smartSetChatVar(triggerId, "cv_maxHp",     tostring(mhp))
    __impl.smartSetChatVar(triggerId, "cv_maxMana",   tostring(mmn))
    __impl.smartSetChatVar(triggerId, "cv_maxHunger", tostring(mhg))

    -- 현재 HP/MANA/HUNGER가 새 최대치 초과 시 clamp
    local curHp = tonumber(__impl.safeGetVar(triggerId, "cv_hp",     "100")) or 100
    local curMn = tonumber(__impl.safeGetVar(triggerId, "cv_mana",   "100")) or 100
    local curHg = tonumber(__impl.safeGetVar(triggerId, "cv_hunger", "100")) or 100
    if curHp > mhp then setChatVar(triggerId, "cv_hp",     tostring(mhp)) end
    if curMn > mmn then setChatVar(triggerId, "cv_mana",   tostring(mmn)) end
    if curHg > mhg then setChatVar(triggerId, "cv_hunger", tostring(mhg)) end

    print(string.format("[GachaIsland] EQUIP_RECALC: ATK=%d DEF=%d LUCK=%d MAXHP=%d MAXMANA=%d MAXHUNGER=%d (base %d/%d/%d/%d/%d/%d)",
        atk, def, lck, mhp, mmn, mhg, atkBase, defBase, lckBase, hpBase, mnBase, hgBase))
end

-- =============================================================================
-- INVENTORY HTML PRE-BUILD + 동적 equipToggle 함수
-- cv_skillInvHtml / cv_relicInvHtml = onOutput / equip 후 Lua 가 카드 HTML 빌드.
-- 버튼 트리거 = equipToggleSkill0..29 / equipToggleRelic0..29 (인덱스는 cv_*Details ;; 순서).
-- =============================================================================

-- HTML escape (& < > " ' 만 처리 — name/desc/effect 사용자 데이터 안전화)
function __impl.htmlEscape(s)
    if not s or s == "" then return "" end
    s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&#39;")
    return s
end

function __impl.buildInvHtml(triggerId)
    for _, kind in ipairs({"skill", "relic"}) do
        local CapKind = kind:sub(1,1):upper() .. kind:sub(2)
        local entries = __impl.parseForgeEntries(triggerId, kind)
        local listKey = (kind == "skill") and "cv_equippedSkills" or "cv_equippedRelics"
        local maxKey  = (kind == "skill") and "cv_maxSkillSlots" or "cv_maxRelicSlots"
        local labelKor = (kind == "skill") and "스킬" or "유물"

        local equippedSet = {}
        local equippedCount = 0
        local eq = __impl.safeGetVar(triggerId, listKey, "None")
        if eq ~= "None" and eq ~= "" and eq ~= "null" then
            for n in eq:gmatch("([^,]+)") do
                n = n:match("^%s*(.-)%s*$")
                if n ~= "" then
                    equippedSet[n] = true
                    equippedCount = equippedCount + 1
                end
            end
        end
        local maxSlots = __impl.safeGetVar(triggerId, maxKey, "3")

        local html
        if #entries == 0 then
            html = '<div class="gi-empty">아직 ' .. labelKor .. '이 없습니다</div>'
        else
            html = '<div class="inv-equip-header"><span class="inv-equip-label">⚙ 장착</span><span class="inv-equip-count">'
                .. equippedCount .. ' / ' .. maxSlots .. '</span></div><div class="gi-list">'
            for idx, entry in ipairs(entries) do
                if idx > 30 then break end
                local stars = string.rep("⭐", entry.tier)
                local isEquipped = equippedSet[entry.name] == true
                html = html .. '<div class="gi-card gi-card-' .. kind .. ' gi-card-tier-' .. entry.tier .. '">'
                html = html .. '<span class="gi-card-stars gi-card-stars-' .. entry.tier .. '">' .. stars .. '</span>'
                html = html .. '<div class="gi-card-name">' .. __impl.htmlEscape(entry.name) .. '</div>'
                html = html .. '<div class="gi-card-desc">' .. __impl.htmlEscape(entry.desc) .. '</div>'
                if entry.effect and entry.effect ~= "" then
                    html = html .. '<div class="gi-card-effect">' .. __impl.htmlEscape(entry.effect) .. '</div>'
                end
                html = html .. '<div class="gi-card-equip-row">'
                if isEquipped then
                    -- #475 ✅ → ⚔ : ✅ 는 regex [43] 「불릿 줄바꿈 강제」 패턴에 매칭되어
                    --                badge 앞에 <br> 가 강제 삽입되어 박스 상단 빈 공백 + 크기 어긋남 발생.
                    --                ⚔ 는 해당 패턴 미포함 → 줄바꿈 안 됨, 해제 버튼과 동일 라인 정상 배치.
                    html = html .. '<span class="gi-card-equipped-badge">⚔ 장착중</span>'
                    html = html .. '{{button::🔓 해제::equipToggle' .. CapKind .. (idx-1) .. '}}'
                else
                    html = html .. '{{button::🔒 장착::equipToggle' .. CapKind .. (idx-1) .. '}}'
                end
                html = html .. '</div></div>'
            end
            html = html .. '</div>'
        end
        setChatVar(triggerId, "cv_" .. kind .. "InvHtml", html)
    end
end

-- #373 (Bug 3 strict): AI 컨텍스트용 equipped-only details 빌드
-- cv_equippedSkillDetails / cv_equippedRelicDetails — 장착 중인 항목만 ;;-구분 details 문자열
-- 매 응답 onOutput + equipToggleByIdx + migration 직후 호출 (cv_*Details 변경 직후 반드시 호출)
function __impl.buildEquippedDetails(triggerId)
    for _, kind in ipairs({"skill", "relic"}) do
        local listKey   = (kind == "skill") and "cv_equippedSkills"   or "cv_equippedRelics"
        local outKey    = (kind == "skill") and "cv_equippedSkillDetails" or "cv_equippedRelicDetails"
        local eq = __impl.safeGetVar(triggerId, listKey, "None")
        if eq == "None" or eq == "" or eq == "null" then
            setChatVar(triggerId, outKey, "None")
        else
            local equippedSet = {}
            for n in eq:gmatch("([^,]+)") do
                n = n:match("^%s*(.-)%s*$")
                if n ~= "" then equippedSet[n] = true end
            end
            local entries = __impl.parseForgeEntries(triggerId, kind)
            local kept = {}
            for _, e in ipairs(entries) do
                if equippedSet[e.name] then
                    kept[#kept+1] = e.raw
                end
            end
            setChatVar(triggerId, outKey, (#kept == 0) and "None" or table.concat(kept, ";;"))
        end
    end
end

function __impl._varEditFormatPoints(n)
    local s = tostring(n):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    s = s:gsub("^,", "")
    return s
end

function __impl._varEditReadValue(triggerId, key)
    if key == "cv_points" then
        -- gsub multi-return 이 tonumber 의 base 인자로 들어가지 않도록 local binding 필수
        local raw = __impl.safeGetVar(triggerId, "cv_points", "0")
        local cleaned = raw:gsub(",", "")
        return tonumber(cleaned) or 0
    end
    return tonumber(__impl.safeGetVar(triggerId, key, "0")) or 0
end

function __impl._varEditMaxValue(triggerId, key)
    if key == "cv_hp" then
        return tonumber(__impl.safeGetVar(triggerId, "cv_maxHp", "100")) or 100
    elseif key == "cv_mana" then
        return tonumber(__impl.safeGetVar(triggerId, "cv_maxMana", "100")) or 100
    elseif key == "cv_hunger" then
        return tonumber(__impl.safeGetVar(triggerId, "cv_maxHunger", "100")) or 100
    end
    return nil
end

function __impl._varEditWriteValue(triggerId, key, val)
    val = _varEditClamp(key, val)
    local maxV = __impl._varEditMaxValue(triggerId, key)
    if maxV then val = math.min(maxV, val) end
    if key == "cv_points" then
        setChatVar(triggerId, key, __impl._varEditFormatPoints(val))
    else
        setChatVar(triggerId, key, tostring(val))
        -- ATK/DEF/LUCK 는 onOutput 끝의 eqRecalcStats 가 cv_*_base + equipped 로 재계산해 cv_attack 등을 덮어씀.
        -- 사용자 의도 (변수 편집기 표시값 = 영구 반영) 위해 base 도 같이 set.
        if key == "cv_attack" or key == "cv_defense" or key == "cv_luck" then
            setChatVar(triggerId, key .. "_base", tostring(val))
        end
    end
end

function __impl._varEditApplyDelta(triggerId, delta)
    local target = __impl.safeGetVar(triggerId, "cv_varEditTarget", "")
    if target == "" or not VAR_EDIT_UNITS[target] then return end
    local cur = __impl._varEditReadValue(triggerId, target)
    __impl._varEditWriteValue(triggerId, target, cur + delta)
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    __impl.buildVarEditHtml(triggerId)
    __impl.appendSaveToCurrentMessage(triggerId)
end

function __impl._varEditApplyDeltaByUnit(triggerId, unitKey, sign)
    local target = __impl.safeGetVar(triggerId, "cv_varEditTarget", "")
    if target == "" or not VAR_EDIT_UNITS[target] then return end
    local delta = (VAR_EDIT_UNITS[target][unitKey] or 0) * sign
    if delta == 0 then return end
    __impl._varEditApplyDelta(triggerId, delta)
end

function __impl._varEditSelect(triggerId, key)
    setChatVar(triggerId, "cv_varEditTarget", key)
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    __impl.buildVarEditHtml(triggerId)
end

function __impl.varEditSelectPoints(triggerId)   __impl._varEditSelect(triggerId, "cv_points")  end

function __impl.varEditSelectHp(triggerId)       __impl._varEditSelect(triggerId, "cv_hp")      end

function __impl.varEditSelectMana(triggerId)     __impl._varEditSelect(triggerId, "cv_mana")    end

function __impl.varEditSelectHunger(triggerId)   __impl._varEditSelect(triggerId, "cv_hunger")  end

function __impl.varEditSelectAttack(triggerId)   __impl._varEditSelect(triggerId, "cv_attack")  end

function __impl.varEditSelectDefense(triggerId)  __impl._varEditSelect(triggerId, "cv_defense") end

function __impl.varEditSelectLuck(triggerId)     __impl._varEditSelect(triggerId, "cv_luck")    end

function __impl._varEditRemoveDetailByName(detailsStr, targetName)
    if not detailsStr or detailsStr == "" or detailsStr == "None" or detailsStr == "null" then
        return detailsStr or ""
    end
    local kept = {}
    for entry in (detailsStr .. ";;"):gmatch("(.-);;") do
        if entry ~= "" then
            local name = entry:match("^([^|]*)") or ""
            name = name:match("^%s*(.-)%s*$")
            if name ~= targetName then
                kept[#kept+1] = entry
            end
        end
    end
    return table.concat(kept, ";;")
end

function __impl._varEditDeleteItemByIdx(triggerId, idx)
    local curItems = __impl.safeGetVar(triggerId, "cv_items", "")
    local items = _varEditSplitItems(curItems)
    if idx < 1 or idx > #items then return end
    local removed = items[idx]
    table.remove(items, idx)
    local newItems
    if #items == 0 then
        newItems = "None"
    else
        local raws = {}
        for _, it in ipairs(items) do raws[#raws+1] = it.raw end
        newItems = table.concat(raws, ", ")
    end
    setChatVar(triggerId, "cv_items", newItems)
    local curDetails = __impl.safeGetVar(triggerId, "cv_itemDetails", "")
    local newDetails = __impl._varEditRemoveDetailByName(curDetails, removed.base)
    if newDetails == "" then newDetails = "None" end
    setChatVar(triggerId, "cv_itemDetails", newDetails)
    print(string.format("[GachaIsland] VAR_EDIT_DELETE_ITEM: idx=%d name='%s' → cv_items='%s'", idx, removed.base, newItems))
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    __impl.buildVarEditHtml(triggerId)
    __impl.appendSaveToCurrentMessage(triggerId)
end

function __impl.buildVarEditHtml(triggerId)
    local target  = __impl.safeGetVar(triggerId, "cv_varEditTarget", "")
    local isOpen  = __impl.safeGetVar(triggerId, "cv_varEditOpen",   "0") == "1"
    local openAttr = isOpen and " open" or ""

    local html = '<details' .. openAttr .. ' class="gi-info-aux-card gi-varedit-card" style="padding:0;overflow:hidden;border-radius:8px;border:1px solid #fcd34d;">'
    html = html .. '<summary style="padding:10px 12px;cursor:pointer;font-weight:700;background:linear-gradient(90deg,#fef3c7 0%,#fde68a 100%);color:#78350f;list-style:none;display:flex;align-items:center;gap:8px;font-size:0.95em;">'
        .. '<span style="font-size:1.1em;">🛠️</span><span>변수 편집기</span>'
        .. '<span style="font-size:0.7em;font-weight:500;background:#fbbf24;color:#78350f;padding:1px 6px;border-radius:3px;margin-left:2px;">DEBUG</span>'
        .. '<span style="margin-left:auto;font-size:0.7em;color:#92400e;opacity:0.7;">▼ 펼치기</span>'
        .. '</summary>'

    html = html .. '<div style="padding:12px;background:#fffbeb;">'

    html = html .. '<div style="font-size:0.7em;color:#92400e;opacity:0.8;margin-bottom:6px;font-style:italic;">ⓘ 퍼스트 메시지에서는 작동하지 않음</div>'
    html = html .. '<div style="font-size:0.78em;color:#78350f;font-weight:700;margin-bottom:5px;letter-spacing:0.02em;">📍 편집 대상</div>'
    html = html .. '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-bottom:12px;">'
    for _, key in ipairs(VAR_EDIT_TARGET_ORDER) do
        local label = VAR_EDIT_TARGET_LABEL[key]
        local triggerName = "varEditSelect" .. key:sub(4,4):upper() .. key:sub(5)
        local activeClass = (target == key) and " gi-varedit-chip-active" or ""
        html = html .. '<div class="gi-varedit-chip' .. activeClass .. '">'
            .. '{{button::' .. label .. '::' .. triggerName .. '}}'
            .. '</div>'
    end
    html = html .. '</div>'

    if target ~= "" and VAR_EDIT_UNITS[target] then
        local label = VAR_EDIT_TARGET_LABEL[target] or target
        local labelInline = (label:gsub("\n", " "))  -- 현재 값 display 는 한 줄 유지
        local cur = __impl._varEditReadValue(triggerId, target)
        local maxV = __impl._varEditMaxValue(triggerId, target)
        local valStr
        if target == "cv_points" then
            valStr = __impl._varEditFormatPoints(cur) .. " P"
        elseif maxV then
            valStr = tostring(cur) .. " / " .. tostring(maxV)
        else
            valStr = tostring(cur)
        end
        local units = VAR_EDIT_UNITS[target]
        local fmtUnit = __impl._varEditFormatPoints
        html = html .. '<div style="background:#ffffff;border:1px solid #fcd34d;border-radius:8px;padding:10px 12px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;">'
            .. '<span style="font-weight:700;color:#78350f;font-size:0.9em;">' .. labelInline .. '</span>'
            .. '<span style="font-family:ui-monospace,Consolas,monospace;font-size:1.05em;font-weight:700;color:#78350f;background:#fef3c7;padding:3px 10px;border-radius:4px;border:1px solid #fbbf24;">' .. valStr .. '</span>'
            .. '</div>'
        html = html .. '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-bottom:10px;">'
            .. '<div>{{button::+' .. fmtUnit(units.sml) .. '::varEditPlusSml}}</div>'
            .. '<div>{{button::+' .. fmtUnit(units.med) .. '::varEditPlusMed}}</div>'
            .. '<div>{{button::+' .. fmtUnit(units.big) .. '::varEditPlusBig}}</div>'
            .. '<div class="gi-varedit-emphasis">{{button::MAX::varEditSetMax}}</div>'
            .. '<div>{{button::−' .. fmtUnit(units.sml) .. '::varEditMinusSml}}</div>'
            .. '<div>{{button::−' .. fmtUnit(units.med) .. '::varEditMinusMed}}</div>'
            .. '<div>{{button::−' .. fmtUnit(units.big) .. '::varEditMinusBig}}</div>'
            .. '<div class="gi-varedit-emphasis">{{button::MIN::varEditSetMin}}</div>'
            .. '</div>'
    else
        html = html .. '<div style="background:#ffffff;border:1px dashed #fbbf24;border-radius:8px;padding:14px;text-align:center;color:#92400e;font-size:0.85em;margin-bottom:10px;">▲ 편집할 stat 을 선택하세요</div>'
    end

    html = html .. '<div style="font-size:0.78em;color:#78350f;font-weight:700;margin-bottom:5px;letter-spacing:0.02em;">📦 보유 아이템 <span style="font-weight:500;opacity:0.7;">(cv_items)</span></div>'
    local items = _varEditSplitItems(__impl.safeGetVar(triggerId, "cv_items", ""))
    if #items == 0 then
        html = html .. '<div style="text-align:center;color:#a16207;font-size:0.82em;padding:10px;background:#ffffff;border-radius:6px;border:1px dashed #fbbf24;">없음</div>'
    else
        html = html .. '<div style="display:flex;flex-direction:column;gap:3px;">'
        for idx, it in ipairs(items) do
            if idx > 20 then break end
            html = html .. '<div style="display:flex;align-items:center;justify-content:space-between;gap:6px;background:#ffffff;padding:5px 8px;border-radius:5px;border:1px solid #fcd34d;">'
                .. '<span style="font-size:0.85em;color:#1f2937;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;">' .. __impl.htmlEscape(it.raw) .. '</span>'
                .. '<div class="gi-varedit-delete">{{button::✕::varEditDeleteItem' .. idx .. '}}</div>'
                .. '</div>'
        end
        if #items > 20 then
            html = html .. '<div style="font-size:0.72em;color:#a16207;text-align:center;padding:4px;font-style:italic;">(상위 20개만 표시 — 추가 entry 는 다음 응답에서 표시)</div>'
        end
        html = html .. '</div>'
    end

    html = html .. '</div>'
    html = html .. '</details>'
    setChatVar(triggerId, "cv_varEditHtml", html)
end

-- STATUS_TIP fallback — AI가 [STATUS_TIP:...] 누락 시 상태 기반 다양한 메시지 picker
-- (단일 hardcoded fallback이 매번 같은 메시지로 반복 노출되던 문제 해소: 동료/유저 입장 「복붙」 인상 제거)
function __impl.generateFallbackTip(triggerId)
    local hp        = tonumber(__impl.safeGetVar(triggerId, "cv_hp",        "100")) or 100
    local maxHp     = tonumber(__impl.safeGetVar(triggerId, "cv_maxHp",     "100")) or 100
    local mana      = tonumber(__impl.safeGetVar(triggerId, "cv_mana",      "100")) or 100
    local maxMana   = tonumber(__impl.safeGetVar(triggerId, "cv_maxMana",   "100")) or 100
    local hunger    = tonumber(__impl.safeGetVar(triggerId, "cv_hunger",    "100")) or 100
    local maxHunger = tonumber(__impl.safeGetVar(triggerId, "cv_maxHunger", "100")) or 100
    local pointsStr = (__impl.safeGetVar(triggerId, "cv_points", "0")):gsub(",", "")
    local points    = tonumber(pointsStr) or 0
    local dungeonActive = __impl.safeGetVar(triggerId, "cv_dungeonActive", "0") == "1"

    local hpPct     = (maxHp     > 0) and (hp     / maxHp     * 100) or 100
    local manaPct   = (maxMana   > 0) and (mana   / maxMana   * 100) or 100
    local hungerPct = (maxHunger > 0) and (hunger / maxHunger * 100) or 100

    local pool = {}

    -- 위급 상황 (HP / MANA / HUNGER)
    if hpPct < 25 then
        table.insert(pool, "체력이 위태위태~ 한 대만 더 맞으면 큰일나겠는걸요?")
        table.insert(pool, "이대로 가다간 그림이 좀 처참해질 것 같은데요~?")
    end
    if manaPct < 30 then
        table.insert(pool, "마나가 슬슬 바닥인데, 충전은 누구랑 하실 거예요~?")
        table.insert(pool, "마나 없으면 스킬도 못 쓰시잖아요~ 동료한테 부탁 좀 해보시지요?")
    end
    if hungerPct < 30 then
        table.insert(pool, "허기 좀 챙기시지요~ 굶어 쓰러지면 그것도 그림이긴 하겠지만요?")
        table.insert(pool, "뭐라도 좀 드시는 게 좋을 텐데... 보급품 가챠라도 한 번 굴려보시지요?")
    end

    -- 던전 진행 상황
    if dungeonActive then
        table.insert(pool, "여기까지 내려오셨는데, 후퇴하실 건가요? 한 층 더 욕심내실 건가요~?")
        table.insert(pool, "던전 깊숙이 들어오셨네요~ 마지막에 누가 웃을지 궁금해지는데요?")
        table.insert(pool, "지금 귀환할까요, 아니면 욕심 한 번 더 부려볼까요~?")
    end

    -- 포인트 상황
    if points >= 10000 then
        table.insert(pool, "포인트 두둑하시네요~ 시설 한 번 지어보시는 건 어떠세요?")
        table.insert(pool, "포인트가 넉넉한데, 뭐 굴려보실 건가요~?")
    end
    if points < 1000 and not dungeonActive then
        table.insert(pool, "포인트가 영 부족해 보이는데, 던전 다녀오셔야겠는걸요?")
        table.insert(pool, "지갑이 가벼우신 것 같은데, 던전이 부르고 있는 것 같지 않으세요~?")
    end

    -- 모든 상태가 평이할 때 일반 fallback (6종 random)
    if #pool == 0 then
        pool = {
            "오늘은 또 어떤 운을 시험해보실 작정이세요~?",
            "가챠라는 게 묘하지요~ 오늘은 어느 쪽으로 굴려보실 건가요?",
            "흠~ 슬슬 다음 수를 둘 차례인 것 같은데요?",
            "지루할 틈이 없으시죠? 가챠섬은 항상 새로운 게 일어나니까요~",
            "한 번에 너무 많은 걸 노리지는 마세요~ ...아니면 그것도 그림일까요?",
            "어떤 선택을 하시든, 저는 옆에서 지켜볼 뿐이에요~ ♪",
        }
    end

    -- 직전 fallback과 동일한 항목 회피 (연속 같은 fallback 노출 차단)
    local lastFallback = __impl.safeGetVar(triggerId, "cv_lastFallbackTip", "")
    local picked = pool[math.random(#pool)]
    if #pool >= 2 and picked == lastFallback then
        local tries = 0
        while picked == lastFallback and tries < 5 do
            picked = pool[math.random(#pool)]
            tries = tries + 1
        end
    end
    setChatVar(triggerId, "cv_lastFallbackTip", picked)
    return picked
end

function __impl.loadLatestStateFromHistory(triggerId)
    local chatLength = getChatLength(triggerId)
    if chatLength < 2 then return false end
    -- #440 reroll/swipe/lazy-delete 가드: user msg 경계까지 backtrack 후 그 전 char msg 만 신뢰.
    -- Risu 의 lazy delete 또는 swipe variant 보존 시 chatLength-2 가 잘못된 char msg (옛 변형) 일 수 있음.
    -- 정상 흐름에선 chatLength-2 = user 라서 user_boundary 가 즉시 잡힘 → 기존 동작과 동일.
    local userBoundary = nil
    for i = chatLength - 2, 0, -1 do
        local msg = getChat(triggerId, i)
        if msg and msg.role == "user" then
            userBoundary = i
            break
        end
    end
    local startIdx = userBoundary and (userBoundary - 1) or (chatLength - 2)
    for i = startIdx, 0, -1 do
        local msg = getChat(triggerId, i)
        if msg and msg.role == "char" and msg.data then
            -- #441 SEED 우선 (신규 포맷) → 못 찾으면 V2 폴백 (1.5 호환) → 마지막 V1 (옛 채팅)
            local seedName = msg.data:match("<!%-%-%[SEED%|([^%]]+)%]%-%->")
            if seedName then
                if __impl.applySaveSeedState(triggerId, seedName) then
                    print(string.format("[GachaIsland] SAVE_LOAD: SEED restored from msg %d (seed=%s, userBoundary=%s, chatLen=%d)", i, seedName, tostring(userBoundary), chatLength))
                    return true
                else
                    print(string.format("[GachaIsland] SAVE_LOAD: SEED %s at msg %d not in store — fallback to V2", seedName, i))
                end
            end
            local sv2 = msg.data:match("(<=S2¦.-=>)")
            if sv2 then
                if parseAndApplySaveStringV2(triggerId, sv2) then
                    print(string.format("[GachaIsland] SAVE_LOAD: V2(legacy 1.5) restored from msg %d (userBoundary=%s)", i, tostring(userBoundary)))
                end
                return true
            end
            -- #466: V1 fallback 제거됨 (1.4.x → 1.5 마이그레이션 코드). SEED + V2 fallback 만 유지.
        end
    end
    return false
end

function __impl.getSaveSeedStore(triggerId)
    local raw = __impl.safeGetVar(triggerId, "cv_saveSeedStore", "")
    if raw == "" or raw == "null" then return { data = {} } end
    local ok, decoded = pcall(json.decode, raw)
    if not ok or type(decoded) ~= "table" then return { data = {} } end
    if type(decoded.data) ~= "table" then decoded.data = {} end
    return decoded
end

function __impl.saveSaveSeedStore(triggerId, store)
    local ok, encoded = pcall(json.encode, store)
    if ok and encoded then
        setChatVar(triggerId, "cv_saveSeedStore", encoded)
    end
end

function __impl.makeSaveSeed(triggerId)
    local charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local store = __impl.getSaveSeedStore(triggerId)
    for _ = 1, 20 do
        local seed = "s"
        for _ = 1, 24 do
            local idx = math.random(1, #charset)
            seed = seed .. charset:sub(idx, idx)
        end
        if not store.data[seed] then return seed end
    end
    -- 충돌 fallback: 더 긴 시드
    local fb = "s"
    for _ = 1, 40 do
        local idx = math.random(1, #charset)
        fb = fb .. charset:sub(idx, idx)
    end
    return fb
end

function __impl.rememberSaveSeedState(triggerId, seed, stateTable)
    local store = __impl.getSaveSeedStore(triggerId)
    store.data[seed] = stateTable
    __impl.saveSaveSeedStore(triggerId, store)
end

function __impl.collectReferencedSaveSeeds(triggerId)
    local refs = {}
    local len = getChatLength(triggerId)
    for i = 0, len - 1 do
        local msg = getChat(triggerId, i)
        if msg and type(msg.data) == "string" then
            for seed in msg.data:gmatch("<!%-%-%[SEED%|([^%]]+)%]%-%->") do
                refs[seed] = true
            end
        end
    end
    return refs
end

-- #476: protectSeed 인자 추가. generateSaveSeedTag 가 새 seed 를 chat 에 박기 전 GC 가
--   발동되면 collectReferencedSaveSeeds 가 chat 만 scan 해 새 seed 를 못 찾고 prune → 다음
--   onOutput 의 SAVE_LOAD 가 not-in-store fallback → 직전 turn 상태 손실 (escape count 등).
--   40턴마다 GC interval 도달 시 정확히 그 응답의 STATE 가 loss → 사용자 보고 매칭.
--   Fix: protectSeed 가 nil 아니면 refs 에 강제 등록 → prune 면제.
function __impl.pruneUnusedSaveSeeds(triggerId, protectSeed)
    local store = __impl.getSaveSeedStore(triggerId)
    local refs = __impl.collectReferencedSaveSeeds(triggerId)
    if protectSeed then refs[protectSeed] = true end
    local removed = 0
    local refCount = 0
    for _ in pairs(refs) do refCount = refCount + 1 end
    for seed in pairs(store.data) do
        if not refs[seed] then
            store.data[seed] = nil
            removed = removed + 1
        end
    end
    if removed > 0 then __impl.saveSaveSeedStore(triggerId, store) end
    print(string.format("[GachaIsland] SAVE_SEED_GC: removed %d unused seeds (active refs: %d, protected: %s)", removed, refCount, protectSeed or "-"))
end

-- 현재 cv_* → state 테이블 (skip-default 적용)
function __impl.collectSnapshotStateTable(triggerId)
    local state = {}
    for _, key in ipairs(SNAPSHOT_VARS) do
        local val = __impl.safeGetVar(triggerId, key, nil)
        local def = SAVE_DEFAULTS[key]
        if val ~= nil and val ~= def then
            state[key] = val
        end
    end
    return state
end

-- 시드 생성 + 상태 저장 + 마커 문자열 반환
function __impl.generateSaveSeedTag(triggerId)
    local state = __impl.collectSnapshotStateTable(triggerId)
    local seed = __impl.makeSaveSeed(triggerId)
    __impl.rememberSaveSeedState(triggerId, seed, state)

    -- GC 카운터
    local gc = tonumber(__impl.safeGetVar(triggerId, "cv_saveSeedGcCounter", "0")) or 0
    gc = gc + 1
    if gc >= SAVE_SEED_GC_INTERVAL then
        -- #476: 방금 만든 seed 는 아직 chat 에 안 박혔으므로 명시적으로 protect.
        --       protect 안 하면 GC 가 이번 turn 의 새 seed 도 prune → 다음 SAVE_LOAD 가 한 턴 전 상태로 복원.
        __impl.pruneUnusedSaveSeeds(triggerId, seed)
        gc = 0
    end
    setChatVar(triggerId, "cv_saveSeedGcCounter", tostring(gc))

    return "<!--[SEED|" .. seed .. "]-->"
end

-- 시드 이름 → 저장된 상태 복원 (SNAPSHOT_VARS 순회 + default 폴백)
-- #445 GLOBAL (not local) — loadLatestStateFromHistory (위쪽 정의) 에서 forward reference 로 호출하므로
--   local 이면 nil value 에러 발생. local 키워드 제거하여 _ENV 의 global function 으로 등록.
function __impl.applySaveSeedState(triggerId, seed)
    local store = __impl.getSaveSeedStore(triggerId)
    if not store.data then return false end
    local stateUpdates = store.data[seed]
    if type(stateUpdates) ~= "table" then return false end
    for _, key in ipairs(SNAPSHOT_VARS) do
        local val = stateUpdates[key]
        if val == nil then val = SAVE_DEFAULTS[key] end
        if val ~= nil then setChatVar(triggerId, key, val) end
    end
    return true
end

-- GLOBAL (not local) — forward-called from _dungeonFloorSetup (L1515) and _forgeApplyCat (L600)
-- 둘 다 lex 시점에 local 미선언 → global 조회로 컴파일됨 → local로 선언하면 _ENV에 없어서 nil 에러
function __impl.appendSaveToCurrentMessage(triggerId)
    local lastIdx = getChatLength(triggerId) - 1
    if lastIdx < 0 then return end
    local msg = getChat(triggerId, lastIdx)
    if not msg or msg.role ~= "char" then return end
    local original = msg.data or ""
    -- 기존 SAVE 모두 제거 후 새 SEED 마커 부착 (V1 / V2 / SEED 셋 다 제거)
    local cleaned = original
        :gsub("\n*<=SAVE¦.-=>", "")
        :gsub("\n*<=S2¦.-=>", "")
        :gsub("\n*<!%-%-%[SEED%|[^%]]+%]%-%->", "")
    -- #441: V2 인라인 압축 → SEED 마커. 실제 상태는 cv_saveSeedStore 안 (chat var).
    local seedTag = __impl.generateSaveSeedTag(triggerId)
    local newContent = cleaned .. "\n" .. seedTag
    if newContent ~= original then
        setChat(triggerId, lastIdx, newContent)
    end
end

-- =============================================
-- DEBUG / 치트 / 복구 도구
-- 사용자가 AI 태그 누락 / 라운드 stuck / 던전 꼬임 등으로 상태가 어긋났을 때
-- 사이드 패널 5번째 토글 (🔧 디버그/치트) 안 버튼으로 직접 복구.
-- =============================================
function __impl._giFindLastCharMessage(triggerId)
    for idx = getChatLength(triggerId) - 1, 0, -1 do
        local msg = getChat(triggerId, idx)
        if msg and (msg.role == "char" or msg.role == "assistant" or msg.role == "bot") then
            return idx, msg
        end
    end
    return nil, nil
end

function __impl._giCleanTip(tip)
    tip = tostring(tip or "")
    tip = tip:gsub("[%[%]|<>\r\n]", " "):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    if tip == "" then tip = "복구 도구가 상태를 동기화했습니다." end
    return tip
end

function __impl._giBuildStatusPanel(triggerId, tip)
    local function gv(name, fb) return __impl.safeGetVar(triggerId, name, fb) end
    local function num(s, fb)
        local cleaned = tostring(s or ""):gsub(",", "")
        return tonumber(cleaned) or fb
    end
    local day        = gv("cv_day", "1")
    local hpV        = num(gv("cv_hp",     "100"), 100)
    local maxHpV     = num(gv("cv_maxHp",  "100"), 100)
    local manaV      = num(gv("cv_mana",   "100"), 100)
    local maxManaV   = num(gv("cv_maxMana","100"), 100)
    local hungerV    = num(gv("cv_hunger", "100"), 100)
    local maxHungerV = num(gv("cv_maxHunger","100"), 100)
    local pointsStr  = gv("cv_points", "0")
    local items      = gv("cv_items",      "None")
    local skills     = gv("cv_equippedSkills", "None")
    local relics     = gv("cv_equippedRelics", "None")
    local facilities = gv("cv_facilities", "None")
    local companions = gv("cv_companions", "None")
    local floorN     = gv("cv_floor", "0")
    local gateState  = gv("cv_dungeonGateState", "열림")
    local stageNum   = num(gv("cv_islandStage", "0"), 0)
    local atkV       = num(gv("cv_attack",  "5"), 5)
    local defV       = num(gv("cv_defense", "5"), 5)
    local luckV      = num(gv("cv_luck",    "0"), 0)
    local hpPct      = (maxHpV     > 0) and math.floor(hpV     / maxHpV     * 100) or 0
    local manaPct    = (maxManaV   > 0) and math.floor(manaV   / maxManaV   * 100) or 0
    local hungerPct  = (maxHungerV > 0) and math.floor(hungerV / maxHungerV * 100) or 0
    local STAGE_NAMES = {[0]="황무지",[1]="개척지",[2]="마을",[3]="요새",[4]="왕국",[5]="성지"}
    local stageName = STAGE_NAMES[stageNum] or "황무지"
    return string.format(
        "[STATUS_PANEL]DAY:%s|HP:%d|MAXHP:%d|HPPCT:%d|MANA:%d|MAXMANA:%d|MANAPCT:%d|HUNGER:%d|MAXHUNGER:%d|HUNGERPCT:%d|POINTS:%sP|ATK:%d|DEF:%d|LUCK:%d|ITEMS:%s|SKILLS:%s|RELICS:%s|FACILITIES:%s|COMPANIONS:%s|FLOOR:%s|GATE:%s|STAGE:%s|TIP:%s[/STATUS_PANEL]",
        day, hpV, maxHpV, hpPct, manaV, maxManaV, manaPct, hungerV, maxHungerV, hungerPct,
        pointsStr, atkV, defV, luckV, items, skills, relics, facilities, companions, floorN, gateState, __impl._giCleanTip(tip)
    )
end

function __impl._giRefreshLastStatusPanel(triggerId, tip)
    local idx, msg = __impl._giFindLastCharMessage(triggerId)
    if not idx or not msg then return false end
    local cleaned = msg.data or ""
    cleaned = cleaned
        :gsub("\n*<=SAVE¦.-=>", "")
        :gsub("\n*<=S2¦.-=>", "")
        :gsub("\n*<!%-%-%[SEED%|[^%]]+%]%-%->", "")
        :gsub("%[STATUS_TIP:[^%]]*%]", "")
        :gsub("%[STATUS_PANEL%].-%[/STATUS_PANEL%]", "")
        :gsub("%s+$", "")
    setChat(triggerId, idx, cleaned .. "\n\n" .. __impl._giBuildStatusPanel(triggerId, tip))
    return true
end

function __impl._giAppendMarkerToLastChar(triggerId, marker)
    local idx, msg = __impl._giFindLastCharMessage(triggerId)
    if not idx or not msg then return nil end
    local data = (msg.data or ""):gsub("\n*<!%-%-%[SEED%|[^%]]+%]%-%->", "")
    if not data:find(marker, 1, true) then
        data = data:gsub("%s+$", "") .. "\n\n" .. marker
        setChat(triggerId, idx, data)
    end
    return idx
end

function __impl._giRemoveChoiceMarkersFromLastChar(triggerId)
    local idx, msg = __impl._giFindLastCharMessage(triggerId)
    if not idx or not msg then return end
    local data = msg.data or ""
    data = data:gsub("%[DUNGEON_CHOICE%]", "")
               :gsub("%[DEBUG_DUNGEON_CHOICE%]", "")
               :gsub("%[SANCTUARY_CHOICE%]", "")
               :gsub("\n\n\n+", "\n\n")
               :gsub("%s+$", "")
    setChat(triggerId, idx, data)
end

function __impl._giAddGachaTicket(triggerId, qty)
    qty = math.max(1, tonumber(qty) or 1)
    local curItems = __impl.safeGetVar(triggerId, "cv_items", "None")
    local parts = {}
    local found = false
    local totalTickets = qty
    if curItems ~= "None" and curItems ~= "" and curItems ~= "null" then
        for entry in curItems:gmatch("([^,]+)") do
            local nm = entry:match("^%s*(.-)%s*$")
            local n = nm:match("^가챠 티켓%s+x(%d+)$")
            if n or nm == "가챠 티켓" then
                local cur = tonumber(n) or 1
                totalTickets = cur + qty
                table.insert(parts, "가챠 티켓 x" .. totalTickets)
                found = true
            elseif nm ~= "" then
                table.insert(parts, nm)
            end
        end
    end
    if not found then
        table.insert(parts, "가챠 티켓 x" .. qty)
        totalTickets = qty
    end
    setChatVar(triggerId, "cv_items", table.concat(parts, ", "))
    local ticketDetail = "가챠 티켓 x" .. totalTickets .. "||랜덤 가챠 1회 사용권. 5종 중 임의 1개.||1||티켓 1장으로 랜덤 가챠를 1회 실행"
    local rawDetails = __impl.safeGetVar(triggerId, "cv_itemDetails", "None")
    local entries = _giSplitDetails(rawDetails)
    local out = {}
    local replaced = false
    for _, entry in ipairs(entries) do
        local name = entry:match("^([^|]+)||") or entry
        local base = (name:match("^(.-)%s+x%d+$") or name):match("^%s*(.-)%s*$")
        if base == "가챠 티켓" then
            if not replaced then
                table.insert(out, ticketDetail)
                replaced = true
            end
        else
            table.insert(out, entry)
        end
    end
    if not replaced then table.insert(out, ticketDetail) end
    setChatVar(triggerId, "cv_itemDetails", table.concat(out, ";;"))
end

function __impl._giRefreshDerivedUi(triggerId)
    __impl.buildRoundPanel(triggerId)
    __impl.buildMonsterPanel(triggerId)
    __impl.buildAllForgePickLists(triggerId)
    __impl.buildInvHtml(triggerId)
    __impl.buildEquippedDetails(triggerId)
    __impl.eqRecalcStats(triggerId)
end

