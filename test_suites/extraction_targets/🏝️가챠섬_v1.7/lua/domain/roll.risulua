local __domain_var = require("domain.var")

local M = {}
local __impl = {}

-- =============================================
-- #446 rollCombatResult — cv_combatResult / Roll / Rate / Basic / Ulti 결정 헬퍼.
-- onInput (사용자 직접 타이핑) + onOutput 끝 (다음 응답용 안전망 pre-roll) 양쪽에서 호출.
-- 사용 배경: Risu 가 addChat 으로 추가된 user msg (버튼 클릭 등) 에는 onInput 발동 안 함.
-- 그 결과 미로 진행 중 cv_combatResult 가 옛 값 고정 → mazeFailStreak 보정 + 진행 자체 영구 막힘.
-- onOutput 끝에서도 호출하여 매 응답 끝에 다음용 result 새로 결정 (failStreak 반영 보장).
-- 호출자가 refreshSeed 책임 — 헬퍼는 PRNG 상태 그대로 사용.
-- =============================================
function __impl.rollCombatResult(triggerId)
    local maxHp     = tonumber(__domain_var.safeGetVar(triggerId, "cv_maxHp",     "100")) or 100
    local curHp     = tonumber(__domain_var.safeGetVar(triggerId, "cv_hp",        "100")) or 100
    local maxMana   = tonumber(__domain_var.safeGetVar(triggerId, "cv_maxMana",   "100")) or 100
    local curMana   = tonumber(__domain_var.safeGetVar(triggerId, "cv_mana",      "100")) or 100
    local maxHunger = tonumber(__domain_var.safeGetVar(triggerId, "cv_maxHunger", "100")) or 100
    local curHunger = tonumber(__domain_var.safeGetVar(triggerId, "cv_hunger",    "100")) or 100
    local floor     = tonumber(__domain_var.safeGetVar(triggerId, "cv_currentFloor", "0")) or 0

    local rate = 60  -- #424 base 55→60

    -- HP/MANA/HUNGER 패널티
    local hpPct = maxHp > 0 and (curHp / maxHp * 100) or 0
    if    hpPct < 20 then rate = rate - 20
    elseif hpPct < 40 then rate = rate - 10 end

    local manaPct = maxMana > 0 and (curMana / maxMana * 100) or 0
    if    curMana == 0   then rate = rate - 20
    elseif manaPct < 30  then rate = rate - 10 end

    local hungerPct = maxHunger > 0 and (curHunger / maxHunger * 100) or 0
    if    curHunger == 0  then rate = rate - 15
    elseif hungerPct < 15 then rate = rate - 10
    elseif hungerPct < 30 then rate = rate - 5 end

    -- 동료 보너스 (+2%/명, max 4)
    local companions = __domain_var.safeGetVar(triggerId, "cv_companions", "None")
    if companions ~= "None" and companions ~= "" then
        local n = 0
        for _ in companions:gmatch("[^,]+") do n = n + 1 end
        if n > 4 then n = 4 end
        rate = rate + n * 2
    end

    rate = rate - (floor - 1) * 0.2  -- 층수 페널티

    local islandStage = tonumber(__domain_var.safeGetVar(triggerId, "cv_islandStage", "0")) or 0
    if islandStage >= 3 then rate = rate + 10 end

    -- 미로형 +30 + failStreak * 5
    local activeDType = __domain_var.safeGetVar(triggerId, "cv_activeDungeonType", "None")
    if activeDType == "미로형" then
        rate = rate + 30
        local failStreak = tonumber(__domain_var.safeGetVar(triggerId, "cv_mazeFailStreak", "0")) or 0
        if failStreak > 0 then
            rate = rate + failStreak * 5
            print(string.format("[GachaIsland] MAZE_FAIL_STREAK_BONUS (#436): failStreak=%d → rate +%d%%", failStreak, failStreak * 5))
        end
    end

    -- #504: LUCK 1 = rate +1% (이전 10 당 1% → ATK/DEF 와 동등하게 1당 1%)
    local luckVal = tonumber(__domain_var.safeGetVar(triggerId, "cv_luck", "0")) or 0
    if luckVal > 0 then rate = rate + luckVal end

    -- #447: rate 가 floor 페널티 (-0.2/층) 로 float 가능 → math.floor 로 정수화 (string.format %d 에러 차단).
    local finalRate   = math.floor(math.max(5, math.min(95, rate)))
    local roll        = math.random(1, 100)
    local critSuccess = math.floor(finalRate * 0.15)
    local success     = math.floor(finalRate * 0.5)
    local normal      = math.floor(finalRate + (100 - finalRate) * 0.5)
    local fail        = math.floor(finalRate + (100 - finalRate) * 0.85)

    local result
    if    roll <= critSuccess then result = "대성공"
    elseif roll <= success    then result = "성공"
    elseif roll <= normal     then result = "보통"
    elseif roll <= fail       then result = "실패"
    else                           result = "대실패" end

    setChatVar(triggerId, "cv_combatResult", result)
    setChatVar(triggerId, "cv_combatRoll",   tostring(roll))
    setChatVar(triggerId, "cv_combatRate",   tostring(finalRate))
    print(string.format("[GachaIsland] COMBAT_ROLL: %d/100 → %s (Rate: %d%%)", roll, result, finalRate))

    -- 일반 공격 (#444): 보통 -20 / 실패 +10 / 대실패 +10
    local basicNormalEnd = math.max(success + 1, normal - 20)
    local basicFailEnd   = math.max(basicNormalEnd + 1, fail - 10)
    local basicResult
    if     roll <= critSuccess     then basicResult = "대성공"
    elseif roll <= success          then basicResult = "성공"
    elseif roll <= basicNormalEnd   then basicResult = "보통"
    elseif roll <= basicFailEnd     then basicResult = "실패"
    else                                 basicResult = "대실패" end
    setChatVar(triggerId, "cv_combatResultBasic", basicResult)

    -- 궁극기 (#444): 대성공 +10 / 성공 +10 / 보통 -20
    local ultiCritEnd    = math.min(success - 1, critSuccess + 10)
    local ultiSuccessEnd = math.min(normal - 1,  success + 20)
    local ultiResult
    if     roll <= ultiCritEnd     then ultiResult = "대성공"
    elseif roll <= ultiSuccessEnd   then ultiResult = "성공"
    elseif roll <= normal           then ultiResult = "보통"
    elseif roll <= fail             then ultiResult = "실패"
    else                                 ultiResult = "대실패" end
    setChatVar(triggerId, "cv_combatResultUlti", ultiResult)

    if basicResult ~= result or ultiResult ~= result then
        print(string.format("[GachaIsland] RESULT_VARIANTS (#444): roll=%d → 스킬=%s / 일반 공격=%s / 궁극기=%s", roll, result, basicResult, ultiResult))
    end
end

M.rollCombatResult = __impl.rollCombatResult

return M
