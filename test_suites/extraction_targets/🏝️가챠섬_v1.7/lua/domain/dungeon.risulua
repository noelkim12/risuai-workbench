local __domain_var = require("domain.var")

local M = {}
local __impl = {}

-- =============================================
-- DUNGEON CHOICE BUTTON HANDLERS (던전 클리어 후 / 성역 진입 시)
-- 가챠 버튼과 동일하게 채팅창에 자동 입력하여 다음 응답을 유도.
-- =============================================

-- 던전 종료 상태를 강제 동기화 (AI가 DUNGEON_EXIT 태그 누락해도 안전)
function __impl.forceCloseDungeon(triggerId)
    __domain_var.smartSetChatVar(triggerId, "cv_dungeonActive",         "0")
    __domain_var.smartSetChatVar(triggerId, "cv_dungeonGateState",      "닫힘")
    __domain_var.smartSetChatVar(triggerId, "cv_currentFloor",          "0")
    __domain_var.smartSetChatVar(triggerId, "cv_activeFloorCondition",  "없음")
    __domain_var.smartSetChatVar(triggerId, "cv_activeDungeonType",     "None")
    __domain_var.smartSetChatVar(triggerId, "cv_sanctuarySpawnedFloor", "0")
    __domain_var.smartSetChatVar(triggerId, "cv_sanctuarySpawnedMsg",   "-1")  -- #452
    __domain_var.smartSetChatVar(triggerId, "cv_sanctuaryConsumed",     "0")   -- #452
    -- 라운드 시스템 + 몬스터 리셋
    __domain_var.smartSetChatVar(triggerId, "cv_currentRound",          "0")
    __domain_var.smartSetChatVar(triggerId, "cv_totalRounds",           "0")
    __domain_var.smartSetChatVar(triggerId, "cv_roundEvents",           "")
    __domain_var.smartSetChatVar(triggerId, "cv_roundPanel",            "")
    __domain_var.smartSetChatVar(triggerId, "cv_currentMonsters",       "")
    __domain_var.smartSetChatVar(triggerId, "cv_monsterPanel",          "")
    __domain_var.smartSetChatVar(triggerId, "cv_pendingMonsterSpawn",   "0")  -- #455 pending spawn flag reset
    __domain_var.smartSetChatVar(triggerId, "cv_mazeEscapeCount",       "0")  -- #308 미로형 카운트 리셋
    __domain_var.smartSetChatVar(triggerId, "cv_mazeFailStreak",        "0")  -- #436 미로 anti-stall 리셋
    print("[GachaIsland] forceCloseDungeon: 모든 던전 state 초기화 (라운드 + 몬스터 + 미로 카운트/streak 포함)")
end

-- 던전 층 셋업 공통 로직 (dungeonNextFloor + mapEnterDungeon 공용)
-- floor +1, 컨디션 pre-roll, 타입 추첨 (2-back exclusion), 라운드 시퀀스, 첫 라운드 몬스터, 패널 빌드, SAVE 갱신
-- Returns: pickedDType (호출자가 [DUNGEON_TYPE:X] 태그에 사용)
-- Global function — mapEnterDungeon(L413)이 forward-call하므로 local 불가
function __impl._dungeonFloorSetup(triggerId)
    -- 층 +1
    local cur = tonumber(__domain_var.safeGetVar(triggerId, "cv_currentFloor", "0")) or 0
    local nextFloor = cur + 1
    setChatVar(triggerId, "cv_currentFloor", tostring(nextFloor))

    -- 새 floor → 성역 출현 카운터 리셋 (floor당 1회만 허용)
    setChatVar(triggerId, "cv_sanctuarySpawnedFloor", "0")
    setChatVar(triggerId, "cv_sanctuarySpawnedMsg",   "-1")  -- #452
    setChatVar(triggerId, "cv_sanctuaryConsumed",     "0")   -- #452

    -- 층 컨디션 pre-roll — onInput이 버튼 클릭에는 발동 안 하므로 여기서 직접 처리
    __domain_var.refreshSeed(triggerId)
    local nextCond, condRoll = __domain_var.rollFloorCondition()
    setChatVar(triggerId, "cv_nextFloorCondition",   nextCond)
    setChatVar(triggerId, "cv_activeFloorCondition", nextCond)
    print(string.format("[GachaIsland] FLOOR_CONDITION_PREROLL: %d/100 → %s", condRoll, nextCond))

    -- 던전 type 추첨 — 2-back exclusion (직전 + 직직전 회피)
    __domain_var.refreshSeed(triggerId)
    local dungeonTypes = { "탐색형", "토벌형", "미로형", "결전형" }
    local last = __domain_var.safeGetVar(triggerId, "cv_lastDungeonType", "None")
    local prev = __domain_var.safeGetVar(triggerId, "cv_prevDungeonType", "None")
    local dPool = {}
    for _, t in ipairs(dungeonTypes) do
        if t ~= last and t ~= prev then table.insert(dPool, t) end
    end
    -- 안전판: 풀이 빈 경우 (4종 - 2 exclude = 2 보장이라 발생 안 함) 전체 풀 사용
    if #dPool == 0 then
        for _, t in ipairs(dungeonTypes) do table.insert(dPool, t) end
    end
    -- Fisher-Yates shuffle
    for i = #dPool, 2, -1 do
        local j = math.random(i)
        dPool[i], dPool[j] = dPool[j], dPool[i]
    end
    local pickedDType = dPool[math.random(#dPool)]

    setChatVar(triggerId, "cv_prevDungeonType",   last)
    setChatVar(triggerId, "cv_nextDungeonType",   pickedDType)
    setChatVar(triggerId, "cv_activeDungeonType", pickedDType)
    setChatVar(triggerId, "cv_lastDungeonType",   pickedDType)

    print(string.format("[GachaIsland] _dungeonFloorSetup: floor %d→%d, type=%s (avoid: last=%s, prev=%s)",
        cur, nextFloor, pickedDType, last, prev))

    -- 라운드 시스템: 라운드 시퀀스 + 첫 라운드 몬스터 + 패널
    rollRoundsForFloor(triggerId, pickedDType)
    spawnMonstersForRound(triggerId)
    buildRoundPanel(triggerId)
    buildMonsterPanel(triggerId)
    -- #455: 첫 라운드 spawn 이미 직접 완료 → pendingSpawn flag clear (옛 carry-over 차단)
    setChatVar(triggerId, "cv_pendingMonsterSpawn", "0")

    -- #305: 직전 봇 응답의 SAVE를 갱신
    __domain_var.appendSaveToCurrentMessage(triggerId)

    return pickedDType
end

M.forceCloseDungeon = __impl.forceCloseDungeon
M._dungeonFloorSetup = __impl._dungeonFloorSetup

return M
