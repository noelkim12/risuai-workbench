local M = {}
local __impl = {}

-- entry "name||desc||tier||effect||stat" → 5 returns (모두 string 또는 nil)
function __impl.eqParseEntry(entry)
    if not entry or entry == "" then return nil, nil, "1", nil, nil end
    local parts = {}
    local pos = 1
    while pos <= #entry do
        local s, e = entry:find("||", pos, true)
        if s then
            table.insert(parts, entry:sub(pos, s - 1))
            pos = e + 1
        else
            table.insert(parts, entry:sub(pos))
            break
        end
    end
    local name   = parts[1]
    local desc   = parts[2]
    local tier   = parts[3] or "1"
    local effect = parts[4]
    local stat   = parts[5]
    if effect == "" then effect = nil end
    if stat   == "" then stat   = nil end
    return name, desc, tier, effect, stat
end

M.eqParseEntry = __impl.eqParseEntry

return M
