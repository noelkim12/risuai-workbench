local __variable_store = require("state.variable_store")
local __domain_var = require("domain.var")

local M = {}
local __impl = {}

function __impl.discoverCharacters(triggerId)
    -- 캐시 hit: 같은 trigger 호출 → loadLoreBooks() 스킵 (100-500ms 절감)
    if __variable_store.AUX_LORE_CACHE.valid then
        return __variable_store.AUX_LORE_CACHE.chars, __variable_store.AUX_LORE_CACHE.emotions, __variable_store.AUX_LORE_CACHE.sexuals
    end

    local ok, lore_data = pcall(function() return loadLoreBooks(triggerId) end)
    if not ok or not lore_data or type(lore_data) ~= "table" then
        return {}, {}, {}
    end
    local all_text = ""
    for _, item in ipairs(lore_data) do
        if type(item) == "table" and item.data then
            all_text = all_text .. "\n" .. tostring(item.data) .. "\n"
        end
    end

    -- Helper: parse comma-separated list under a "### Header" section
    local function parse_section(header_pattern)
        local results = {}
        local seen = {}
        for block in all_text:gmatch(header_pattern .. "[^\n]*\n([^\n]+)") do
            for item in block:gmatch("([^,]+)") do
                item = item:gsub("^%s+", ""):gsub("%s+$", "")
                if item ~= "" and not seen[item] then
                    seen[item] = true
                    table.insert(results, item)
                end
            end
        end
        return results
    end

    -- Source 1: Characters Image Command List 섹션 (본체 + DLC 변형 둘 다 캐치)
    -- 본체: "### Characters Image Command List"
    -- DLC : "### Additional Characters Image Command List" (Additional 접두사)
    -- 그 외 prefix 있어도 catch: "###" 다음에 무엇이든 → "Characters Image Command List"
    local char_names = parse_section("###[^\n]-Characters%s+Image%s+Command%s+List")
    local chars = {}
    local seen = {}
    for _, name in ipairs(char_names) do
        if not seen[name] then
            seen[name] = true
            table.insert(chars, { english = name, aliases = {} })
        end
    end

    -- Source 2: 개별 캐릭터 로어북의 "[Companion Profile: X]" 패턴 (Image List 미등록 char 보강)
    -- 단, 풀네임 토큰 중 하나라도 Source 1 (Image List) prefix와 매칭되면 SKIP
    -- 이유: "[Companion Profile: Sorasaki Hina]" + Image List에 "Hina"만 있는 경우
    --       "Sorasaki"를 phantom prefix로 추가하면 실제 에셋 없는 prefix가 chars에 들어가 AUX가 잘못 출력
    --       (e.g., AUX가 "Hina"보다 더 구체적인 "Sorasaki"를 선호 → <img="Sorasaki_X"> 환각)
    local source1_count = #chars
    for full_name in all_text:gmatch("%[Companion Profile:%s*([^%]\n]+)%]") do
        full_name = full_name:gsub("^%s+", ""):gsub("%s+$", "")
        if full_name ~= "" then
            -- 풀네임의 어떤 토큰이든 이미 Image List에 있는지 확인
            local already_known = false
            for token in full_name:gmatch("%S+") do
                if seen[token] then
                    already_known = true
                    break
                end
            end

            if not already_known then
                -- Image List에 매칭 없는 진짜 신규 char → 첫 단어를 prefix로 추가
                local prefix = full_name:match("^(%S+)") or full_name
                if not prefix:match("^[A-Za-z][A-Za-z0-9_]*$") then
                    prefix = full_name:gsub("%s+", "_")
                end
                if not seen[prefix] then
                    seen[prefix] = true
                    table.insert(chars, { english = prefix, aliases = {} })
                end
            end
        end
    end

    -- 한국어 별칭 매핑 (동명이인 충돌 방지 — e.g., 카자미 히나 vs 소라사키 히나)
    -- "- Name: <Eng full> (<Korean>)" 패턴으로 eng_prefix ← 한국어 매핑
    -- 영문 풀네임 토큰 중 chars 리스트(prefix)에 있는 것 우선, 없으면 first word
    local prefix_set = {}
    for _, c in ipairs(chars) do prefix_set[c.english] = c end
    for eng_full, kor in all_text:gmatch("%- Name:%s*([^%(\n]+)%s*%(([^%)\n]+)%)") do
        eng_full = eng_full:gsub("^%s+", ""):gsub("%s+$", "")
        kor = kor:gsub("^%s+", ""):gsub("%s+$", "")
        if kor ~= "" and eng_full ~= "" then
            local matched = nil
            for token in eng_full:gmatch("%S+") do
                if prefix_set[token] then matched = token; break end
            end
            if not matched then matched = eng_full:match("^(%S+)") end
            if matched and prefix_set[matched] then
                -- 풀네임 + 마지막 단어(개인명) + mid_part(마지막 단어 제외 prefix) 별칭 등록
                -- "카자미 히나" → ["카자미 히나", "히나", "카자미"]. 동명이인 충돌 시 conflict 감지됨
                -- #390: mid_part 추가 — narration 의 실제 표기 ("아르토리아 얼터") 매칭 (이전엔 풀네임/last만 등록되어 mid 표기 → aux LLM 자연어 추론 의존)
                local candidates = { kor }
                local last_word = kor:match("(%S+)$")
                if last_word and last_word ~= kor and #last_word > 0 then
                    table.insert(candidates, last_word)
                end
                local mid_part = kor:match("^(.+)%s+%S+$")
                if mid_part and mid_part ~= kor and mid_part ~= last_word and #mid_part > 0 then
                    table.insert(candidates, mid_part)
                end
                for _, alias in ipairs(candidates) do
                    local already = false
                    for _, a in ipairs(prefix_set[matched].aliases) do
                        if a == alias then already = true; break end
                    end
                    if not already then
                        table.insert(prefix_set[matched].aliases, alias)
                    end
                end
            end
        end
    end

    -- Emotion + sexual 리스트도 같은 lorebook에서 파싱
    local emotions = parse_section("###%s*Emotion%s+List")
    local sexuals = parse_section("###%s*sexual%s+Command%s+List")

    -- =============================================
    -- #405 GAMEMASTER GUARD — 동료로 뽑힌 상태에서만 이미지 태그 허용
    -- 게임마스터는 시스템 voice (SYS_NARR/SYS_ADVICE/TIP) 이라 가챠 전부터 narration 에 등장.
    -- 그러나 그녀의 portrait (Gamemaster_*) 는 동료로 뽑힌 후에만 표시되어야 함.
    -- cv_companions 에 "게임마스터" 없으면 AUX chars 에서 제거 → AUX 가 tag 안 함.
    -- =============================================
    do
        local companions = __domain_var.safeGetVar(triggerId, "cv_companions", "None")
        local hasGM = companions ~= "None" and companions:find("게임마스터", 1, true) ~= nil
        if not hasGM then
            for i = #chars, 1, -1 do
                if chars[i].english == "Gamemaster" then
                    table.remove(chars, i)
                end
            end
        end
    end

    -- DEBUG: source별 발견 카운트 + alias 매핑 카운트
    local aliased = 0
    for _, c in ipairs(chars) do
        if c.aliases and #c.aliases > 0 then aliased = aliased + 1 end
    end
    print(string.format("[GachaIsland][AUX_DEBUG] chars=%d (Image_List=%d, Companion_Profile_added=%d, aliased=%d) emotions=%d sexuals=%d",
        #chars, source1_count, #chars - source1_count, aliased, #emotions, #sexuals))

    -- #358: 캐시 저장 (같은 trigger 내 반복 호출 시 재사용)
    __variable_store.AUX_LORE_CACHE.chars = chars
    __variable_store.AUX_LORE_CACHE.emotions = emotions
    __variable_store.AUX_LORE_CACHE.sexuals = sexuals
    __variable_store.AUX_LORE_CACHE.valid = true

    return chars, emotions, sexuals
end

M.discoverCharacters = __impl.discoverCharacters

return M
