local __domain_equip = require("domain.equip")
local __domain_list = require("domain.list")
local __domain_eq_unequip = require("domain.eq_unequip")
local __domain_var = require("domain.var")

local M = {}

local onButtonClick

onButtonClick = async(function(id, data, aux_generate_combined)
    -- =============================================
    -- #353 EQUIP TOGGLE DISPATCHER (CBS button payload)
    -- {{button::라벨::equipToggle||skill||스킬이름}} 형태로 호출.
    -- payload 형식: "equipToggle||{skill|relic}||이름"
    -- =============================================
    if type(data) == "string" then
        local action, kind, name = data:match("^(equipToggle)||(%w+)||(.+)$")
        if action and kind and name then
            name = name:match("^%s*(.-)%s*$") or name
            local listKey = (kind == "skill") and "cv_equippedSkills" or "cv_equippedRelics"
            local cur = __domain_var.safeGetVar(id, listKey, "None")
            if __domain_list.eqInList(cur, name) then
                local ok, reason = __domain_eq_unequip.eqUnequip(id, kind, name)
                if not ok then alertError(id, "해제 실패: " .. (reason or "")) end
            else
                local ok, reason = __domain_equip.eqEquip(id, kind, name)
                if not ok then
                    if reason == "slot full" then
                        local maxKey = (kind == "skill") and "cv_maxSkillSlots" or "cv_maxRelicSlots"
                        local maxV = __domain_var.safeGetVar(id, maxKey, "3")
                        alertError(id, "장착 슬롯이 가득 찼습니다 (" .. maxV .. "/" .. maxV .. "). 먼저 다른 것을 해제하세요.")
                    elseif reason == "not owned" then
                        alertError(id, "보유하지 않은 항목입니다.")
                    else
                        alertError(id, "장착 실패: " .. (reason or ""))
                    end
                end
            end
            return
        end
    end

    if data ~= "gacha_aux_retag" then return end

    -- AUX OFF 시 버튼 클릭해도 차단 (이중 안전망 — display 숨김 + click 차단)
    if __domain_var.safeGetVar(id, "cv_auxMode", "1") == "0" then
        alertError(id, "보조모델 OFF 상태입니다. 설정에서 ON 후 다시 시도하세요.")
        return
    end

    local chatLength = getChatLength(id)
    if chatLength == 0 then return end
    local lastMsg = getChat(id, chatLength - 1)
    if not lastMsg or lastMsg.role ~= "char" then return end
    local content = (type(lastMsg.data) == "string") and lastMsg.data or ""
    if content == "" then return end

    alertNormal(id, "🔄 에셋 리롤 중...")

    -- #358 DLC fix: 리롤 시 lorebook 캐시 무효화
    -- → DLC 모듈을 세션 중 추가/제거한 사용자가 리롤로 새 DLC 캐릭 인식 가능
    -- 다음 aux 호출에서 loadLoreBooks() fresh fetch (DLC entries 포함된 최신 lore 반영)
    AUX_LORE_CACHE.valid = false

    -- 1) STATUS_PANEL + SAVE 보존
    local panel_tag = content:match("(%[STATUS_PANEL%].-%[/STATUS_PANEL%])")
    local save_tag  = content:match("(<=SAVE¦.-=>)")

    -- 2) narrative 추출 (기존 <img>, STATUS_PANEL, SAVE 모두 제거)
    local narrative = content
    narrative = narrative:gsub("%[STATUS_PANEL%].-%[/STATUS_PANEL%]", "")
    narrative = narrative:gsub("<=SAVE¦.-=>", "")
    narrative = narrative:gsub('<img="[^"]*">', '')
    narrative = narrative:gsub("\n\n\n+", "\n\n"):gsub("^%s+", ""):gsub("%s+$", "")

    if narrative == "" then
        alertError(id, "리롤 실패: narrative 비어있음")
        return
    end

    -- 3) aux 재호출 (image tags + tip 통합 — reroll에선 tip 무시, 기존 STATUS_PANEL 유지)
    local tagged, _ = aux_generate_combined(id, narrative)
    if not tagged or tagged == "" then
        alertError(id, "리롤 실패: aux 응답 없음")
        return
    end

    -- 4) 재결합 (기존 STATUS_PANEL + SAVE 부착 — TIP은 기존 그대로 유지)
    local rebuilt = tagged
    if panel_tag then rebuilt = rebuilt .. "\n\n" .. panel_tag end
    if save_tag  then rebuilt = rebuilt .. "\n" .. save_tag end

    setChat(id, chatLength - 1, rebuilt)
    pcall(function() reloadDisplay(id) end)
    alertNormal(id, "✅ 에셋 리롤 완료")
end)

M.onButtonClick = onButtonClick

return M
