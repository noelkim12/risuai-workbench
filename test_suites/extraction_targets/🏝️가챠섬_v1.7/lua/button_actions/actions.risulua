-- 중앙 — 던전 게이트 입장 (열려있을 때만 의미 있음)
local function mapEnterDungeon(triggerId)
    local gate = __domain_var.safeGetVar(triggerId, "cv_dungeonGateState", "열림")
    if gate ~= "열림" then
        alertError(triggerId, "던전 게이트가 닫혀 있습니다 (" .. gate .. "). 다음 날을 기다리세요.")
        return
    end
    __domain_var._closeAllSidePanels(triggerId)
    -- #353: cv_dungeonActive 즉시 set (lorebook 던전 GM 가이드 조건부 활성을 위한 pre-set).
    setChatVar(triggerId, "cv_dungeonActive", "1")
    setChatVar(triggerId, "cv_dungeonGateState", "도전중")

    -- #453: 던전 재진입 시 cv_floor (누적 클리어 최고층) 부터 이어가기.
    --   forceCloseDungeon 은 cv_currentFloor 를 0 으로 reset 하지만, mapEnterDungeon 진입 시
    --   cv_floor 값으로 다시 set → _dungeonFloorSetup 의 cur+1 로 자연스럽게 cv_floor+1 시작.
    --   효과: 5층 클리어 후 성소 다녀와도 다음 entry 는 floor 6 부터 (보스 HP 자동 스케일).
    --   첫 진입 (cv_floor=0) 은 기존과 동일하게 floor 1 부터.
    local clearedFloor = tonumber(__domain_var.safeGetVar(triggerId, "cv_floor", "0")) or 0
    setChatVar(triggerId, "cv_currentFloor", tostring(clearedFloor))

    -- 셋업: 컨디션 / 타입 / 라운드 시퀀스 / 몬스터 / 패널 (dungeonNextFloor와 동일)
    -- cv_currentFloor = clearedFloor → _dungeonFloorSetup 가 +1 → clearedFloor + 1 시작.
    local pickedDType = __domain_dungeon._dungeonFloorSetup(triggerId)

    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    addChat(triggerId, "user", "⚔ 던전 게이트를 통해 던전에 진입한다.[DUNGEON_TYPE:" .. pickedDType .. "]")
end

M.mapEnterDungeon = mapEnterDungeon

