-- #362 기본 캐릭터 포함/제외 토글 — 가챠풀 캐시 invalidate 후 reloadDisplay
-- ON  (cv_baseCharsOff=0): COMPANION_POOL_BOT + DLC 동료 (기본)
-- OFF (cv_baseCharsOff=1): DLC 동료만 (DLC 테스터 / DLC-only 운영용)
local function baseCharsON(triggerId)
    setChatVar(triggerId, "cv_baseCharsOff", "0")
