-- #341: 보유한 가챠 티켓 전부 한 번에 사용
-- cv_items에서 "가챠 티켓 xN" 매칭 → N회 추첨 → 한 user 메시지에 모두 부착
local function gachaRandomAll(triggerId)
    __domain_var.refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    -- 보유 수량 추출
    local items = __domain_var.safeGetVar(triggerId, "cv_items", "None")
    local count = 0
    if items ~= "None" and items ~= "" and items ~= "null" then
        for entry in items:gmatch("([^,]+)") do
            local nm = entry:match("^%s*(.-)%s*$")
            local n = nm:match("^가챠 티켓%s+x(%d+)$")
            if n then
                count = tonumber(n) or 0
                break
            elseif nm == "가챠 티켓" then
                count = 1
                break
            end
        end
    end
    if count <= 0 then
        alertError(triggerId, "보유한 가챠 티켓이 없습니다.")
        return
    end
    if count == 1 then
        local frag = buildRandomGachaFragment(triggerId)
        addChat(triggerId, "user", "🎲 랜덤 가챠를 돌린다." .. frag)
        return
    end
    -- N >= 2: N개 fragment 조립
    local lines = {}
    local frags = {}
    for i = 1, count do
        lines[#lines+1] = "🎲 랜덤 가챠를 돌린다."
        frags[#frags+1] = buildRandomGachaFragment(triggerId)
    end
    local msg = table.concat(lines, "\n") .. table.concat(frags, "")
    addChat(triggerId, "user", msg)
    print(string.format("[GachaIsland] RANDOM_ALL: 가챠 티켓 %d장 한 번에 사용", count))
end

M.gachaRandomAll = gachaRandomAll

local function dungeonReturn(triggerId)
    forceCloseDungeon(triggerId)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    -- #433: #431 후 [SYSTEM|DUNGEON_EXIT] 자연 처리 폐기로 SAVE 갱신 fallback 사라짐.
    -- forceCloseDungeon이 메모리상 cv_dungeonActive=0 등 reset해도 다음 onOutput의 SAVE_LOAD가
    -- 직전 AI msg SAVE (cv_dungeonActive=1)로 되돌려서 던전 활성 상태 잔존. 직전 AI msg SAVE를 갱신.
    __domain_var.appendSaveToCurrentMessage(triggerId)
    addChat(triggerId, "user", "🏠 성소로 귀환한다.")
end

M.dungeonReturn = dungeonReturn

local function dungeonNextFloor(triggerId)
    -- 가드: 던전 진행 중이 아니면 무시 (DUNGEON_CHOICE 잘못 출력 / 부적절한 클릭 차단)
    local active = __domain_var.safeGetVar(triggerId, "cv_dungeonActive", "0")
    if active ~= "1" then
        -- #469: silent skip 대신 사용자 alert — 무반응 원인 명확히 표시
        local gate = __domain_var.safeGetVar(triggerId, "cv_dungeonGateState", "?")
        alertError(triggerId, string.format("다음 층 진입 불가:\n던전이 비활성 상태입니다.\n\ncv_dungeonActive=%s, cv_dungeonGateState=%s\n\n던전 외부에서 클릭되었거나 던전이 이미 종료된 상태입니다.", active, gate))
        print("[GachaIsland] dungeonNextFloor SKIPPED: 던전 진행 중 아님 (cv_dungeonActive=" .. active .. ", cv_dungeonGateState=" .. gate .. ")")
        return
    end

    local pickedDType = __domain_dungeon._dungeonFloorSetup(triggerId)

    -- [DUNGEON_TYPE:...] 태그로 user msg에 강제 부착 → AI는 verbatim 사용 (GACHA_PICK 패턴)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    addChat(triggerId, "user", "⬇ 다음 층으로 진입한다.[DUNGEON_TYPE:" .. pickedDType .. "]")
end

M.dungeonNextFloor = dungeonNextFloor

local function sanctuaryReturn(triggerId)
    forceCloseDungeon(triggerId)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    __domain_var.appendSaveToCurrentMessage(triggerId)  -- #433 동일 이유 (dungeonReturn 참조)
    addChat(triggerId, "user", "🏠 던전을 빠져나가 성소로 귀환한다.")
end

M.sanctuaryReturn = sanctuaryReturn

local function sanctuaryRecharge(triggerId)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    -- #452: user 가 충전 클릭 → consume flag set. 이후 같은 floor 에서 [SANCTUARY_CHOICE] 재출력 시 strip.
    setChatVar(triggerId, "cv_sanctuaryConsumed", "1")
    -- consumed=1 을 마지막 char msg seed 에 박아둠. 안 그러면 다음 SAVE_LOAD 가 직전 char msg 의 옛 seed (consumed=0) 로 덮어써 #506 가드가 SKIP → 라운드 advance 차단.
    __domain_var.appendSaveToCurrentMessage(triggerId)
    addChat(triggerId, "user", "💎 던전 내 성역에서 마나를 충전한다.")
end

M.sanctuaryRecharge = sanctuaryRecharge

