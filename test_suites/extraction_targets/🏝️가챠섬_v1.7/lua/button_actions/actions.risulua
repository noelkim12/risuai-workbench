-- 보급품 가챠 2회 — 한 user 메시지에 [GACHA_CATS] 두 개 부착, 「보급품 가챠를 돌린다」 두 줄 표시
-- AI는 「가챠 규칙」 entry의 [MULTI GACHA_CATS] 룰에 따라 두 번 결과 + 비용 2× 차감 (총 400P)
local function gachaSupplyTwice(triggerId)
    __domain_var.refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    local c1a, c2a = pickSupplyCats(triggerId)
    local c1b, c2b = pickSupplyCats(triggerId)
    local tierA = __domain_var.rollGachaTier()
    local tierB = __domain_var.rollGachaTier()
    local msg = "📦 보급품 가챠를 돌린다.\n📦 보급품 가챠를 돌린다." ..
        "[GACHA_CATS:보급품|" .. c1a .. "|" .. c2a .. "][GACHA_TIER:" .. tierA .. "]" ..
        "[GACHA_CATS:보급품|" .. c1b .. "|" .. c2b .. "][GACHA_TIER:" .. tierB .. "]"
    addChat(triggerId, "user", msg)
end

M.gachaSupplyTwice = gachaSupplyTwice

