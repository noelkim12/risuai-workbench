local function gachaCompanion(triggerId)
    __domain_var.refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    -- AI에 위임하지 않고 Lua가 직접 추첨해 [GACHA_PICK:한글|English] 강제
    local picked = __domain_var.pickRandomCompanion(triggerId)
    if picked then
        setChatVar(triggerId, "cv_lastGachaPick", picked.ko)
        addChat(triggerId, "user", "👥 동료 소환 가챠를 돌린다.[GACHA_PICK:" .. picked.ko .. "|" .. picked.en .. "]")
        print(string.format("[GachaIsland] COMPANION_PICK: %s (%s) origin=%s", picked.ko, picked.en, picked.origin))
    else
        -- pickRandomCompanion은 이제 항상 picked 리턴 (nil 안 옴) — 이 분기는 도달 불가능, 안전판
        addChat(triggerId, "user", "👥 동료 소환 가챠를 돌린다.")
        print("[GachaIsland] COMPANION_PICK: pickRandomCompanion returned nil unexpectedly")
    end
end

M.gachaCompanion = gachaCompanion

local function gachaCompanionReroll(triggerId)
    __domain_var.refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)

    if __domain_var.safeGetVar(triggerId, "cv_dungeonActive", "0") == "1" then
        alertError(triggerId, "던전 안에서는 동료 다시 뽑기를 사용할 수 없습니다.")
        return
    end

    local oldKo, oldEn = _rerollFindLastCompanion(triggerId)
    if not oldKo or oldKo == "" or oldKo == "None" or oldKo == "null" then
        alertError(triggerId, "다시 뽑을 최근 동료가 없습니다.")
        return
    end

    local curPoints = _rerollParsePoints(__domain_var.safeGetVar(triggerId, "cv_points", "0"))
    if curPoints < 500 then
        alertError(triggerId, "포인트가 부족합니다. 다시 뽑기에는 500P가 필요합니다.")
        return
    end

    local picked = _rerollPickReplacement(triggerId, oldKo)
    if not picked then
        alertError(triggerId, "교체 가능한 미소환 동료가 없습니다.")
        return
    end

    if not _rerollReplaceCompanion(triggerId, oldKo, picked) then
        alertError(triggerId, "기존 동료를 찾지 못해 다시 뽑기를 중단했습니다.")
        return
    end

    setChatVar(triggerId, "cv_points", _rerollFormatPoints(curPoints - 500))
    setChatVar(triggerId, "cv_skipNextRerollPoint", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "gacha")

    -- #537 CRITICAL: 직전 char msg 의 SAVE 갱신 — onOutput SAVE_LOAD 가 cv_companions 를 옛 동료로
    -- 덮어쓰지 않도록 reroll 상태 (바이켄 + 도바킨, points -500 등) 를 prior msg seed 에 박음.
    -- dungeonReturn 과 동일 패턴 — state-mutating 버튼 후 addChat 전 필수.
    __domain_var.appendSaveToCurrentMessage(triggerId)

    addChat(triggerId, "user", "👥 동료 다시 뽑기를 실행한다. 직전 소환 동료 " .. oldKo .. "를 계약 해제하고 500P로 새 동료를 다시 뽑는다.[GACHA_REROLL:" .. oldKo .. "|" .. (oldEn or "") .. "][GACHA_REROLL_PAID:500P][GACHA_PICK:" .. picked.ko .. "|" .. picked.en .. "]")
    print(string.format("[GachaIsland] COMPANION_REROLL: %s -> %s (%s), POINT %d -> %d", oldKo, picked.ko, picked.en, curPoints, curPoints - 500))
end

M.gachaCompanionReroll = gachaCompanionReroll

