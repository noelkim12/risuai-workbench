local function varEditSetMax(triggerId)
    local target = __domain_var.safeGetVar(triggerId, "cv_varEditTarget", "")
    if target == "" then return end
    local maxV = _varEditMaxValue(triggerId, target)
    if maxV then
        _varEditWriteValue(triggerId, target, maxV)
    elseif target == "cv_points" then
        _varEditWriteValue(triggerId, target, 999999999)
    else
        _varEditWriteValue(triggerId, target, 999)
    end
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    __domain_var.buildVarEditHtml(triggerId)
    __domain_var.appendSaveToCurrentMessage(triggerId)
end

M.varEditSetMax = varEditSetMax

local function varEditSetMin(triggerId)
    local target = __domain_var.safeGetVar(triggerId, "cv_varEditTarget", "")
    if target == "" then return end
    _varEditWriteValue(triggerId, target, 0)
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    __domain_var.buildVarEditHtml(triggerId)
    __domain_var.appendSaveToCurrentMessage(triggerId)
end

M.varEditSetMin = varEditSetMin

local function debugShowDungeonChoice(triggerId)
    _stayInDebug(triggerId)
    if __domain_var.safeGetVar(triggerId, "cv_dungeonActive", "0") ~= "1" then
        alertError(triggerId, "던전 진행 중이 아닙니다.")
        return
    end
    local idx = _giAppendMarkerToLastChar(triggerId, "[DEBUG_DUNGEON_CHOICE]")
    if not idx then
        alertError(triggerId, "복구할 최근 응답을 찾지 못했습니다.")
        return
    end
    __domain_var.appendSaveToCurrentMessage(triggerId)
    reloadDisplay(triggerId)
    alertNormal(triggerId, "층 클리어 선택지를 복구했습니다.")
end

M.debugShowDungeonChoice = debugShowDungeonChoice

local function debugShowSanctuaryChoice(triggerId)
    _stayInDebug(triggerId)
    if __domain_var.safeGetVar(triggerId, "cv_dungeonActive", "0") ~= "1" then
        alertError(triggerId, "던전 진행 중이 아닙니다.")
        return
    end
    local idx = _giAppendMarkerToLastChar(triggerId, "[SANCTUARY_CHOICE]")
    if not idx then
        alertError(triggerId, "복구할 최근 응답을 찾지 못했습니다.")
        return
    end
    setChatVar(triggerId, "cv_sanctuarySpawnedFloor", __domain_var.safeGetVar(triggerId, "cv_currentFloor", "0"))
    setChatVar(triggerId, "cv_sanctuarySpawnedMsg", tostring(idx))
    setChatVar(triggerId, "cv_sanctuaryConsumed", "0")
    __domain_var.appendSaveToCurrentMessage(triggerId)
    reloadDisplay(triggerId)
    alertNormal(triggerId, "성역 선택지를 복구했습니다.")
end

M.debugShowSanctuaryChoice = debugShowSanctuaryChoice

local function debugFloorClearReward(triggerId)
    _stayInDebug(triggerId)
    if __domain_var.safeGetVar(triggerId, "cv_dungeonActive", "0") ~= "1" then
        alertError(triggerId, "던전 진행 중이 아닙니다.")
        return
    end
    local curFloor = tonumber(__domain_var.safeGetVar(triggerId, "cv_currentFloor", "0")) or 0
    if curFloor <= 0 then
        alertError(triggerId, "현재 층 정보가 없습니다.")
        return
    end
    local cleared = tonumber(__domain_var.safeGetVar(triggerId, "cv_floor", "0")) or 0
    if curFloor > cleared then
        setChatVar(triggerId, "cv_floor", tostring(curFloor))
    end
    setChatVar(triggerId, "cv_currentMonsters", "")
    setChatVar(triggerId, "cv_monsterPanel", "")
    setChatVar(triggerId, "cv_pendingMonsterSpawn", "0")
    local dType = __domain_var.safeGetVar(triggerId, "cv_activeDungeonType", "None")
    if dType == "미로형" then
        setChatVar(triggerId, "cv_mazeEscapeCount", "3")
        setChatVar(triggerId, "cv_mazeFailStreak", "0")
    elseif dType == "탐색형" or dType == "토벌형" or dType == "결전형" then
        local total = tonumber(__domain_var.safeGetVar(triggerId, "cv_totalRounds", "0")) or 0
        if total <= 0 then total = 1; setChatVar(triggerId, "cv_totalRounds", "1") end
        setChatVar(triggerId, "cv_currentRound", tostring(total))
    end
    buildRoundPanel(triggerId)
    _giAddGachaTicket(triggerId, 1)
    _giRefreshDerivedUi(triggerId)
    _giRefreshLastStatusPanel(triggerId, "복구 완료: 현재 층 클리어와 가챠 티켓 1장이 반영되었습니다.")
    _giAppendMarkerToLastChar(triggerId, "[DEBUG_DUNGEON_CHOICE]")
    __domain_var.appendSaveToCurrentMessage(triggerId)
    reloadDisplay(triggerId)
    alertNormal(triggerId, "현재 층 클리어 보정과 선택지 복구를 적용했습니다.")
end

M.debugFloorClearReward = debugFloorClearReward

local function debugForceDungeonReturn(triggerId)
    _stayInDebug(triggerId)
    local maxHp = tonumber(__domain_var.safeGetVar(triggerId, "cv_maxHp", "100")) or 100
    local hp = tonumber(__domain_var.safeGetVar(triggerId, "cv_hp", tostring(maxHp))) or maxHp
    local heal = math.max(1, math.floor(maxHp * 0.30))
    setChatVar(triggerId, "cv_hp", tostring(math.min(maxHp, hp + heal)))
    forceCloseDungeon(triggerId)
    __domain_var._closeAllSidePanels(triggerId)
    _giRemoveChoiceMarkersFromLastChar(triggerId)
    _giRefreshDerivedUi(triggerId)
    _giRefreshLastStatusPanel(triggerId, "복구 완료: 던전 상태를 종료하고 성소로 동기화했습니다.")
    __domain_var.appendSaveToCurrentMessage(triggerId)
    reloadDisplay(triggerId)
    alertNormal(triggerId, "던전 상태를 종료하고 성소로 동기화했습니다.")
end

M.debugForceDungeonReturn = debugForceDungeonReturn

return M
