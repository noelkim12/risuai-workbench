local M = {}

local parseInventory
local serializeInventory
local normalizeItemName
local splitEntries
local extractBaseName
local detailsHasName
local appendDetail
local removeDetailByName
local syncStackableInDetails
local isPlaceholder
local _isPlaceholder

function parseInventory(invStr)
        local inv = {}
        local order = {}
        if not invStr or invStr == "None" or invStr == "" or invStr == "null" then
            return inv, order
        end
        for entry in invStr:gmatch("([^,]+)") do
            entry = entry:match("^%s*(.-)%s*$")
            local name, qty = entry:match("^(.+)%s+x(%d+)$")
            if name and qty then
                name = name:match("^%s*(.-)%s*$")
                if name ~= "..." and name ~= "null" then
                    inv[name] = tonumber(qty)
                    table.insert(order, name)
                end
            else
                entry = entry:match("^%s*(.-)%s*$")
                if entry ~= "" and entry ~= "null" and entry ~= "..." then
                    inv[entry] = 1
                    table.insert(order, entry)
                end
            end
        end
        return inv, order
    end

function serializeInventory(inv, order, STACKABLE_ITEMS)
        local parts = {}
        for _, name in ipairs(order) do
            if inv[name] and inv[name] > 0 then
                if STACKABLE_ITEMS[name] then
                    -- 가챠 티켓 같은 stackable: counter 표기 유지
                    table.insert(parts, name .. " x" .. inv[name])
                else
                    -- 일반 single-use 아이템: 이름만 (스킬·유물처럼)
                    table.insert(parts, name)
                end
            end
        end
        if #parts == 0 then return "None" end
        return table.concat(parts, ", ")
    end

function normalizeItemName(s)
        if not s then return "" end
        s = s:gsub("[「」『』\"']", "")
        s = s:gsub("%s+", " ")
        s = s:match("^%s*(.-)%s*$") or ""
        return s
    end

function splitEntries(detailsStr)
        local out = {}
        if not detailsStr or detailsStr == "None" or detailsStr == "" or detailsStr == "null" then
            return out
        end
        local pos = 1
        while pos <= #detailsStr do
            local s, e = detailsStr:find(";;", pos, true)
            if s then
                table.insert(out, detailsStr:sub(pos, s - 1))
                pos = e + 1
            else
                table.insert(out, detailsStr:sub(pos))
                break
            end
        end
        return out
    end

function extractBaseName(rawName)
        if not rawName then return "" end
        local base = rawName:match("^(.-)%s+x%d+$") or rawName
        return base:match("^%s*(.-)%s*$") or base
    end

function detailsHasName(detailsStr, targetName, extractBaseName, splitEntries)
        for _, entry in ipairs(splitEntries(detailsStr)) do
            local existName = entry:match("^([^|]+)||") or entry:match("^([^|]+)$")
            if existName and extractBaseName(existName) == targetName then
                return true
            end
        end
        return false
    end

function appendDetail(detailsStr, name, desc, tier, effect)
        local tn = tonumber(tier) or 1
        if tn < 1 or tn > 5 then tn = 1 end
        local newEntry = name .. "||" .. desc .. "||" .. tostring(tn)
        if effect and effect ~= "" then
            newEntry = newEntry .. "||" .. effect
        end
        if not detailsStr or detailsStr == "None" or detailsStr == "" or detailsStr == "null" then
            return newEntry
        end
        return detailsStr .. ";;" .. newEntry
    end

function removeDetailByName(detailsStr, targetName, extractBaseName, splitEntries)
        if not detailsStr or detailsStr == "None" or detailsStr == "" or detailsStr == "null" then
            return "None"
        end
        local entries = {}
        for _, entry in ipairs(splitEntries(detailsStr)) do
            local existName = entry:match("^([^|]+)||") or entry:match("^([^|]+)$")
            if not (existName and extractBaseName(existName) == targetName) then
                table.insert(entries, entry)
            end
        end
        if #entries == 0 then return "None" end
        return table.concat(entries, ";;")
    end

function syncStackableInDetails(detailsStr, invTable, extractBaseName, splitEntries, STACKABLE_ITEMS)
        if not detailsStr or detailsStr == "None" or detailsStr == "" or detailsStr == "null" then
            return detailsStr
        end
        local entries = splitEntries(detailsStr)
        local changed = false
        local outEntries = {}
        for _, entry in ipairs(entries) do
            local n, d = entry:match("^([^|]+)||(.*)$")
            if not n then n = entry:match("^([^|]+)$"); d = nil end
            if n then
                local base = extractBaseName(n)
                if STACKABLE_ITEMS[base] then
                    local count = invTable[base] or 0
                    if count > 0 then
                        local newName = base .. " x" .. count
                        if n ~= newName then
                            entry = newName .. (d and ("||" .. d) or "")
                            changed = true
                        end
                        table.insert(outEntries, entry)
                    else
                        -- count 0 → 제거
                        changed = true
                    end
                else
                    table.insert(outEntries, entry)
                end
            else
                table.insert(outEntries, entry)
            end
        end
        if not changed then return detailsStr end
        if #outEntries == 0 then return "None" end
        return table.concat(outEntries, ";;")
    end

function isPlaceholder(name, tier)
                    local label = ({normal="적", elite="엘리트", boss="보스"})[tier] or "적"
                    return name == label or name:match("^" .. label .. "%s+%d+$") ~= nil
                end

function _isPlaceholder(name, tier)
                        local label = ({normal="적", elite="엘리트", boss="보스"})[tier] or "적"
                        return name == label or name:match("^" .. label .. "%s+%d+$") ~= nil
                    end

M.parseInventory = parseInventory
M.serializeInventory = serializeInventory
M.normalizeItemName = normalizeItemName
M.splitEntries = splitEntries
M.extractBaseName = extractBaseName
M.detailsHasName = detailsHasName
M.appendDetail = appendDetail
M.removeDetailByName = removeDetailByName
M.syncStackableInDetails = syncStackableInDetails
M.isPlaceholder = isPlaceholder
M._isPlaceholder = _isPlaceholder

return M
