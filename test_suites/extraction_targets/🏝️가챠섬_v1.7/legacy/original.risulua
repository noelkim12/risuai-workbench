-- 본체 + DLC 합산 풀 빌드 (캐싱 안 함 — 로어북 변동 즉시 반영)
-- DLC는 module 로어북에 `comment="DLC_COMPANION_POOL"` entry로 JSON 캐릭터 배열 등록.
-- `getLoreBooks`는 safe tier — onInput/onOutput에서 호출 가능.
local function buildMergedPool(triggerId)
    -- #342: 캐싱 — lorebook fetch (getLoreBooks)가 비싼 작업이라 Companion 가챠마다 호출하면 부담.
    -- cv_companionPoolCache (SNAPSHOT 미등록, 휘발성)에 JSON 저장 → 같은 chat 안에선 첫 호출만 비용.
    -- 새 chat 시작 / 캐시 invalid 시 재빌드. DLC 동적 변경은 드문 케이스라 안전.
    local cached = safeGetVar(triggerId, "cv_companionPoolCache", "")
    if cached ~= "" and cached ~= "null" and cached ~= "None" then
        local okC, poolC = pcall(json.decode, cached)
        if okC and type(poolC) == "table" and #poolC > 0 then return poolC end
    end

    local pool = {}
    -- #362 cv_baseCharsOff=1 → COMPANION_POOL_BOT skip (DLC only). DLC tester / DLC-only run 용도.
    local baseOff = safeGetVar(triggerId, "cv_baseCharsOff", "0") == "1"
    if not baseOff then
        for _, c in ipairs(COMPANION_POOL_BOT) do table.insert(pool, c) end
    end

    -- 모든 module/local/global 로어북에서 comment 매치 entry 수집
    local ok, entries = pcall(getLoreBooks, triggerId, "DLC_COMPANION_POOL")
    if ok and type(entries) == "table" then
        local seen = {}
        for _, c in ipairs(pool) do seen[c.ko] = true end
        for _, e in ipairs(entries) do
            local okJson, dlc = pcall(json.decode, e.content or "")
            if okJson and type(dlc) == "table" then
                for _, c in ipairs(dlc) do
                    -- 형식 가드 + dedupe (여러 DLC가 같은 캐릭 박아도 중복 방지)
                    if type(c) == "table" and c.ko and c.en and not seen[c.ko] then
                        table.insert(pool, c)
                        seen[c.ko] = true
                    end
                end
            end
        end
    end

    -- 캐시 저장
    local okEnc, jsonStr = pcall(json.encode, pool)
    if okEnc and jsonStr then
        setChatVar(triggerId, "cv_companionPoolCache", jsonStr)
    end
    return pool
end

-- 미소환 동료 풀에서 1명 무작위 추첨 (#363: 원작별 origin 회피 로직 폐기 — 풀 다양화로 완전 랜덤 전환).
-- origin 필드는 데이터 정의에 그대로 유지 (DLC 호환). 추첨 로직만 origin-blind.
-- Returns: companion table {ko, en, origin} or nil (전원 소환 완료)
local function pickRandomCompanion(triggerId)
    local POOL = buildMergedPool(triggerId)  -- 본체 + DLC(chat var) 합산 풀 (매 호출 1회 빌드)
    local raw = safeGetVar(triggerId, "cv_companions", "None")

    local summoned = {}
    if raw ~= "None" and raw ~= "" and raw ~= "null" then
        for name in raw:gmatch("([^,]+)") do
            name = name:match("^%s*(.-)%s*$")
            if name ~= "" then
                summoned[name] = true
            end
        end
    end

    -- 직전 추첨 결과 회피 (AI가 SYSTEM 태그 누락해서 cv_companions 갱신 실패한 경우의 안전망)
    local lastPick = safeGetVar(triggerId, "cv_lastGachaPick", "None")

    local fullPool = {}
    for _, c in ipairs(POOL) do
        if not summoned[c.ko] and c.ko ~= lastPick then
            fullPool[#fullPool + 1] = c
        end
    end

    -- 진단 로그 — 풀 상태 가시화 (본체/DLC 분리 표시)
    local summonedCount = 0
    for _ in pairs(summoned) do summonedCount = summonedCount + 1 end
    local poolSize = #POOL
    local dlcCount = poolSize - #COMPANION_POOL_BOT
    print(string.format("[GachaIsland] PICK_COMPANION_DEBUG: cv_companions='%s', lastPick='%s', summoned=%d, POOL_size=%d(bot=%d+dlc=%d), fullPool=%d", raw, lastPick, summonedCount, poolSize, #COMPANION_POOL_BOT, dlcCount, #fullPool))

    -- 3단 fallback:
    --   1) summoned + lastPick 회피 → fullPool. 비면
    --   2) summoned만 회피 (lastPick 풀어줌) → 다시 시도. 그것도 비면
    --   3) POOL 전체 (전원 영입 케이스 — duplicate 의도, AI 환불 narrative)
    if #fullPool == 0 then
        for _, c in ipairs(POOL) do
            if not summoned[c.ko] then
                fullPool[#fullPool + 1] = c
            end
        end
        print(string.format("[GachaIsland] FALLBACK_LV2: lastPick 풀고 재시도 → fullPool=%d", #fullPool))
    end
    if #fullPool == 0 then
        print(string.format("[GachaIsland] FALLBACK_LV3: 전원 영입 완료 → POOL 전체 (duplicate 가능, AI refund)"))
        return POOL[math.random(poolSize)]
    end

    -- #363: 원작 회피 제거. fullPool에서 완전 랜덤 추첨.
    return fullPool[math.random(#fullPool)]
end

-- 랜덤 가챠 타입 가중치: Supply 65% / Couple 5% / Skill 15% / Relic 8% / Companion 5% / Facility 2%
local function rollRandomGachaType()
    local r = math.random(100)
    if     r <= 65 then return "Supply"
    elseif r <= 70 then return "Couple"
    elseif r <= 85 then return "Skill"
    elseif r <= 93 then return "Relic"
    elseif r <= 98 then return "Companion"
    else                return "Facility"
    end
end

-- 가챠 등급 확률 5/4/3/2/1성 = 1.5/5.5/15/30/48%. 동료는 등급 미적용.
local function rollGachaTier()
    local r = math.random(1, 1000)
    if     r <= 15  then return 5
    elseif r <= 70  then return 4
    elseif r <= 220 then return 3
    elseif r <= 520 then return 2
    else                 return 1
    end
end

-- =============================================
-- GACHA BUTTON HANDLERS (가챠 버튼 채팅 전송)
-- =============================================

-- =============================================
-- 사이드 패널 (4 토글: 인벤 / 가챠 / 강화 / 가이드)
--   각 패널은 CSS radio 토글 (<label for=gi-side-*>) 로 작동. Lua 측 toggle 함수 제거 (#465 dead code 일소).
--   강화: 같은 등급 3개 → +1등급 합성. cv_forgeCategory (skill/relic/facility) 탭 전환.
--   맵 (#349 재구성): 사이드 패널에서 빼고 STATUS_PANEL 최상단 STATUS↔MAP 카테고리 토글로 이동.
-- =============================================

-- =============================================
-- #349 (#348 재구성): MAP은 STATUS_PANEL 최상단 카테고리 토글로 이동
-- 4방위 탐색 + 중앙 성소·던전 게이트 클릭 시 addChat(user)로 의도 전송.
-- AI는 region-specific lorebook 참조해 탐색 narration.
-- 탐색 1회 = HUNGER -10. 던전 게이트는 cv_dungeonGateState != "열림"일 때 alertError.
-- =============================================
local function _closeAllSidePanels(triggerId)
    smartSetChatVar(triggerId, "cv_invOpen",        "0")
    smartSetChatVar(triggerId, "cv_gachaPanelOpen", "0")
    smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    smartSetChatVar(triggerId, "cv_guideOpen",      "0")
    smartSetChatVar(triggerId, "cv_debugOpen",      "0")
end

function exploreWestForest(triggerId)
    refreshSeed(triggerId)
    _closeAllSidePanels(triggerId)
    addChat(triggerId, "user", "🌲 서쪽 숲을 탐색한다.[EXPLORE:서쪽숲]")
end

function exploreEastDesert(triggerId)
    refreshSeed(triggerId)
    _closeAllSidePanels(triggerId)
    addChat(triggerId, "user", "🏜 동쪽 사막을 탐색한다.[EXPLORE:동쪽사막]")
end

function exploreSouthBeach(triggerId)
    refreshSeed(triggerId)
    _closeAllSidePanels(triggerId)
    addChat(triggerId, "user", "🌊 남쪽 해변을 탐색한다.[EXPLORE:남쪽해변]")
end

function exploreNorthMountain(triggerId)
    refreshSeed(triggerId)
    _closeAllSidePanels(triggerId)
    addChat(triggerId, "user", "🏔 북쪽 산맥을 탐색한다.[EXPLORE:북쪽산맥]")
end

-- 중앙 — 성소로 귀환 (어디서든)
function mapGoToSanctuary(triggerId)
    _closeAllSidePanels(triggerId)
    addChat(triggerId, "user", "🏠 성소로 귀환한다.")
end

-- 중앙 — 던전 게이트 입장 (열려있을 때만 의미 있음)
function mapEnterDungeon(triggerId)
    local gate = safeGetVar(triggerId, "cv_dungeonGateState", "열림")
    if gate ~= "열림" then
        alertError(triggerId, "던전 게이트가 닫혀 있습니다 (" .. gate .. "). 다음 날을 기다리세요.")
        return
    end
    _closeAllSidePanels(triggerId)
    -- #353: cv_dungeonActive 즉시 set (lorebook 던전 GM 가이드 조건부 활성을 위한 pre-set).
    setChatVar(triggerId, "cv_dungeonActive", "1")
    setChatVar(triggerId, "cv_dungeonGateState", "도전중")

    -- #453: 던전 재진입 시 cv_floor (누적 클리어 최고층) 부터 이어가기.
    --   forceCloseDungeon 은 cv_currentFloor 를 0 으로 reset 하지만, mapEnterDungeon 진입 시
    --   cv_floor 값으로 다시 set → _dungeonFloorSetup 의 cur+1 로 자연스럽게 cv_floor+1 시작.
    --   효과: 5층 클리어 후 성소 다녀와도 다음 entry 는 floor 6 부터 (보스 HP 자동 스케일).
    --   첫 진입 (cv_floor=0) 은 기존과 동일하게 floor 1 부터.
    local clearedFloor = tonumber(safeGetVar(triggerId, "cv_floor", "0")) or 0
    setChatVar(triggerId, "cv_currentFloor", tostring(clearedFloor))

    -- 셋업: 컨디션 / 타입 / 라운드 시퀀스 / 몬스터 / 패널 (dungeonNextFloor와 동일)
    -- cv_currentFloor = clearedFloor → _dungeonFloorSetup 가 +1 → clearedFloor + 1 시작.
    local pickedDType = _dungeonFloorSetup(triggerId)

    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    addChat(triggerId, "user", "⚔ 던전 게이트를 통해 던전에 진입한다.[DUNGEON_TYPE:" .. pickedDType .. "]")
end

-- ============ 강화 시스템 (#324 재설계): 슬롯 3 + 사용자 직접 선택 ============
-- 사용자가 슬롯 1/2/3 빈칸 클릭 → 보유 아이템 펼침 → 선택 → cv_forgeSlotN 저장
-- 슬롯 3개 같은 등급 채워지면 강화 버튼 활성. 5★은 비활성.
local CAT_CFG = {
    skill    = { listVar="cv_skills",     detailsVar="cv_skillDetails",    label="스킬", icon="✨" },
    relic    = { listVar="cv_relics",     detailsVar="cv_relicDetails",    label="유물", icon="🏺" },
    facility = { listVar="cv_facilities", detailsVar="cv_facilityDetails", label="시설", icon="🏛" },
}

-- cv_*Details → entries 리스트
local function parseForgeEntries(triggerId, cat)
    local cfg = CAT_CFG[cat]; if not cfg then return {} end
    local raw = safeGetVar(triggerId, cfg.detailsVar, "None")
    if raw == "None" or raw == "" or raw == "null" then return {} end
    local entries = {}
    local pos = 1
    while pos <= #raw do
        local s, e = raw:find(";;", pos, true)
        local entry = s and raw:sub(pos, s - 1) or raw:sub(pos)
        pos = s and (e + 1) or (#raw + 1)
        local parts, p2 = {}, 1
        while p2 <= #entry do
            local ss, ee = entry:find("||", p2, true)
            parts[#parts+1] = ss and entry:sub(p2, ss - 1) or entry:sub(p2)
            if not ss then break end
            p2 = ee + 1
        end
        if parts[1] and parts[1] ~= "" then
            -- #373 (Bug 3): effect (parts[4]) 도 추출 — 인벤 카드 표시에 사용
            entries[#entries+1] = {
                name = parts[1],
                desc = parts[2] or "",
                tier = tonumber(parts[3] or "1") or 1,
                effect = parts[4] or "",
                raw = entry,
            }
        end
    end
    return entries
end

-- cv_forgePickList<Cat><Slot> 9 변수 빌드 — 매 응답 onOutput / 슬롯 조작 후 호출
-- #373 (Bug 5): 다른 슬롯에 이미 배치된 항목 비활성화 (이름 기준 중복 방지).
-- equipped 항목도 비활성화 (장착 중인 스킬/유물은 강화 재료로 사용 불가 — 디자인 안전판)
function buildAllForgePickLists(triggerId)
    for _, cat in ipairs({"skill", "relic", "facility"}) do
        local cfg = CAT_CFG[cat]
        local entries = parseForgeEntries(triggerId, cat)
        local CapCat = cat:sub(1,1):upper() .. cat:sub(2)
        -- 장착 중인 이름 집합 (skill/relic 만 — facility 는 장착 개념 없음)
        local equippedSet = {}
        if cat == "skill" then
            local eq = safeGetVar(triggerId, "cv_equippedSkills", "None")
            if eq ~= "None" and eq ~= "" and eq ~= "null" then
                for n in eq:gmatch("([^,]+)") do equippedSet[n:match("^%s*(.-)%s*$")] = true end
            end
        elseif cat == "relic" then
            local eq = safeGetVar(triggerId, "cv_equippedRelics", "None")
            if eq ~= "None" and eq ~= "" and eq ~= "null" then
                for n in eq:gmatch("([^,]+)") do equippedSet[n:match("^%s*(.-)%s*$")] = true end
            end
        end
        for slot = 1, 3 do
            -- 다른 슬롯에 이미 들어간 이름 집합
            local takenSet = {}
            for s = 1, 3 do
                if s ~= slot then
                    local other = safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. s, "")
                    local otherName = other:match("^(.+)||%d+$")
                    if otherName then takenSet[otherName] = true end
                end
            end
            local pickList = ""
            for idx, entry in ipairs(entries) do
                if idx > 30 then break end
                local stars = string.rep("⭐", entry.tier)
                local label = entry.name .. " " .. stars
                if entry.tier >= 5 then
                    pickList = pickList .. '<span class="gi-forge-pick-disabled" title="5★은 강화할 수 없습니다">' .. label .. '</span>'
                elseif takenSet[entry.name] then
                    pickList = pickList .. '<span class="gi-forge-pick-disabled" title="이미 다른 슬롯에 배치됨">' .. label .. '</span>'
                elseif equippedSet[entry.name] then
                    pickList = pickList .. '<span class="gi-forge-pick-disabled" title="장착 중인 항목은 강화 재료로 사용 불가">' .. label .. '</span>'
                else
                    pickList = pickList .. '<span class="gi-forge-pick-item gi-forge-pick-tier-' .. entry.tier .. '">{{button::' .. label .. '::forgeSet' .. slot .. CapCat .. (idx-1) .. '}}</span>'
                end
            end
            if pickList == "" then
                pickList = '<div class="gi-forge-pick-empty">보유한 ' .. cfg.label .. '이 없습니다</div>'
            end
            setChatVar(triggerId, "cv_forgePickList" .. CapCat .. slot, pickList)
        end
    end
end

-- 슬롯 채우기 handler (#328: 카테고리별 슬롯 9 변수 분리)
-- 사용자가 카테고리 탭만 바꾸면 다른 카테고리 슬롯이 자동 표시됨 (CSS-only 분기)
-- reloadDisplay 제거 — 패널 유지 + 멈춤 방지. 시각 갱신은 강화/다음 응답 시.
local function _capCat(cat) return cat:sub(1,1):upper() .. cat:sub(2) end

local function forgeSetSlotHandler(triggerId, slot, cat, idx)
    local entries = parseForgeEntries(triggerId, cat)
    if idx + 1 > #entries then return end
    local entry = entries[idx + 1]
    if entry.tier >= 5 then
        alertError(triggerId, "5★은 강화할 수 없습니다.")
        return
    end
    local CapCat = _capCat(cat)
    -- #373 (Bug 5): 다른 슬롯에 이미 같은 이름이 있으면 거부 (중복 방지)
    for s = 1, 3 do
        if s ~= slot then
            local other = safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. s, "")
            local otherName = other:match("^(.+)||%d+$")
            if otherName == entry.name then
                alertError(triggerId, "이미 다른 슬롯에 같은 항목이 있습니다.")
                return
            end
        end
    end
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. slot, entry.name .. "||" .. entry.tier)
    -- #373 (Bug 5): 패널 / 탭 유지 (사이드 패널 + 카테고리 탭) + pickList 닫힘 (active slot 해제)
    setChatVar(triggerId, "cv_forgeOpen",        "1")
    setChatVar(triggerId, "cv_forgeCategory",    cat)
    setChatVar(triggerId, "cv_forgeActiveSlot",  "0")
    -- pickList 재빌드 (다른 슬롯 동일 항목 비활성화 반영)
    buildAllForgePickLists(triggerId)
    -- #377 후속 (얼헌 refreshScreen 패턴): appendSave 의 setChat 만으로 ONE 재렌더 충분
    -- → reloadDisplay 제거 (double-render 로 인한 setvar 결과 cv=0 → 패널 닫힘 flicker 차단)
    appendSaveToCurrentMessage(triggerId)
end

-- 동적 함수 생성 — forgeSet<1|2|3><Skill|Relic|Facility><0..29>
for slot = 1, 3 do
    for _, cat in ipairs({"skill", "relic", "facility"}) do
        local CapCat = _capCat(cat)
        for idx = 0, 29 do
            _G["forgeSet" .. slot .. CapCat .. idx] = function(triggerId)
                forgeSetSlotHandler(triggerId, slot, cat, idx)
            end
        end
    end
end

-- 카테고리별 슬롯 초기화 — 활성 카테고리의 3 슬롯만 비움.
-- #373 (Bug 5): 패널 / 탭 상태 유지 위해 cv 상태 명시 + reloadDisplay
local function _forgeClearCat(triggerId, cat)
    local CapCat = _capCat(cat)
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "1", "")
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "2", "")
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "3", "")
    setChatVar(triggerId, "cv_forgeOpen",       "1")
    setChatVar(triggerId, "cv_forgeCategory",   cat)
    setChatVar(triggerId, "cv_forgeActiveSlot", "0")
    buildAllForgePickLists(triggerId)
    -- #377 후속 (얼헌 refreshScreen 패턴): appendSave 의 setChat 만으로 ONE 재렌더 충분 → reloadDisplay 제거
    appendSaveToCurrentMessage(triggerId)
end
function forgeClearSkill(triggerId)    _forgeClearCat(triggerId, "skill")    end
function forgeClearRelic(triggerId)    _forgeClearCat(triggerId, "relic")    end
function forgeClearFacility(triggerId) _forgeClearCat(triggerId, "facility") end

-- 카테고리별 강화 실행
local function _forgeApplyCat(triggerId, cat)
    local cfg = CAT_CFG[cat]; if not cfg then return end
    local CapCat = _capCat(cat)
    local s1 = safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. "1", "")
    local s2 = safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. "2", "")
    local s3 = safeGetVar(triggerId, "cv_forgeSlot" .. CapCat .. "3", "")
    if s1 == "" or s2 == "" or s3 == "" then
        alertError(triggerId, cfg.label .. " 슬롯 3개를 모두 채워주세요."); return
    end

    local function parseSlot(s)
        local name, tier = s:match("^(.+)||(%d+)$")
        return name, tonumber(tier or "1") or 1
    end
    local n1, t1 = parseSlot(s1)
    local n2, t2 = parseSlot(s2)
    local n3, t3 = parseSlot(s3)

    if t1 ~= t2 or t2 ~= t3 then
        alertError(triggerId, "같은 ⭐ 등급 3개를 선택해야 합니다."); return
    end
    if t1 >= 5 then
        alertError(triggerId, "5★은 더 강화할 수 없습니다."); return
    end

    local entries = parseForgeEntries(triggerId, cat)
    local stockByName = {}
    for _, e in ipairs(entries) do
        if e.tier == t1 then stockByName[e.name] = (stockByName[e.name] or 0) + 1 end
    end
    local need = {}
    for _, n in ipairs({n1, n2, n3}) do need[n] = (need[n] or 0) + 1 end
    for name, cnt in pairs(need) do
        if (stockByName[name] or 0) < cnt then
            alertError(triggerId, "보유 수량 부족: " .. name); return
        end
    end

    local consumedNeed = {}
    for _, n in ipairs({n1, n2, n3}) do consumedNeed[n] = (consumedNeed[n] or 0) + 1 end
    local kept = {}
    for _, e in ipairs(entries) do
        if e.tier == t1 and consumedNeed[e.name] and consumedNeed[e.name] > 0 then
            consumedNeed[e.name] = consumedNeed[e.name] - 1
        else
            kept[#kept+1] = e.raw
        end
    end
    setChatVar(triggerId, cfg.detailsVar, (#kept == 0) and "None" or table.concat(kept, ";;"))

    local oldList = safeGetVar(triggerId, cfg.listVar, "None")
    if oldList ~= "None" and oldList ~= "" and oldList ~= "null" then
        local nameRemove = {}
        for _, n in ipairs({n1, n2, n3}) do nameRemove[n] = (nameRemove[n] or 0) + 1 end
        local remaining = {}
        for nm in oldList:gmatch("([^,]+)") do
            nm = nm:match("^%s*(.-)%s*$")
            if nm ~= "" and nameRemove[nm] and nameRemove[nm] > 0 then
                nameRemove[nm] = nameRemove[nm] - 1
            elseif nm ~= "" then
                remaining[#remaining+1] = nm
            end
        end
        setChatVar(triggerId, cfg.listVar, (#remaining == 0) and "None" or table.concat(remaining, ", "))
    end

    -- 강화된 카테고리만 슬롯 초기화 (다른 카테고리 슬롯 보존)
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "1", "")
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "2", "")
    setChatVar(triggerId, "cv_forgeSlot" .. CapCat .. "3", "")
    appendSaveToCurrentMessage(triggerId)

    local newTier = t1 + 1
    local stars = string.rep("⭐", t1)
    local newStars = string.rep("⭐", newTier)
    local msg = string.format("%s %s 강화: %s 3개 합성 → %s 강화 [FORGE_REQUEST:%s|%d→%d|%s]",
        cfg.icon, cfg.label, stars, newStars, cat, t1, newTier, table.concat({n1, n2, n3}, " + "))
    -- #343: 비-가챠 addChat 핸들러는 cv_gachaPanelOpen=0 (이전 가챠 세션 잔재로 패널 자동 재오픈 방지)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    -- #373 (Bug 5): 강화 완료 = forge UX 종료 → 다음 AI 응답에서 사이드 패널 닫힘
    setChatVar(triggerId, "cv_forgeOpen",        "0")
    setChatVar(triggerId, "cv_forgeActiveSlot",  "0")
    addChat(triggerId, "user", msg)
end
function forgeApplySkill(triggerId)    _forgeApplyCat(triggerId, "skill")    end
function forgeApplyRelic(triggerId)    _forgeApplyCat(triggerId, "relic")    end
function forgeApplyFacility(triggerId) _forgeApplyCat(triggerId, "facility") end

-- AUX 모드 ON/OFF — chat 변수 cv_auxMode ("1" = ON 기본, "0" = OFF)
-- 글로벌 변수 setGlobalVar이 risu-trigger 컨텍스트에서 작동 불안정 → chat 변수로 안정화
-- #373 후속 (Bug 2): 가이드 패널 안의 버튼 → 가이드 유지 + 잔재 (가챠/인벤/강화) 닫음 + SAVE 강제 재렌더
local function _stayInGuide(triggerId)
    smartSetChatVar(triggerId, "cv_guideOpen",      "1")
    smartSetChatVar(triggerId, "cv_invOpen",        "0")
    smartSetChatVar(triggerId, "cv_gachaPanelOpen", "0")
    smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    smartSetChatVar(triggerId, "cv_debugOpen",      "0")
    appendSaveToCurrentMessage(triggerId)
end

local function _stayInDebug(triggerId)
    smartSetChatVar(triggerId, "cv_debugOpen",      "1")
    smartSetChatVar(triggerId, "cv_invOpen",        "0")
    smartSetChatVar(triggerId, "cv_gachaPanelOpen", "0")
    smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    smartSetChatVar(triggerId, "cv_guideOpen",      "0")
end
function auxModeON(triggerId)
    setChatVar(triggerId, "cv_auxMode", "1")
    _stayInGuide(triggerId)  -- 내부에서 appendSaveToCurrentMessage 호출 (setChat → 재렌더)
end
function auxModeOFF(triggerId)
    setChatVar(triggerId, "cv_auxMode", "0")
    _stayInGuide(triggerId)
end

-- #362 기본 캐릭터 포함/제외 토글 — 가챠풀 캐시 invalidate 후 reloadDisplay
-- ON  (cv_baseCharsOff=0): COMPANION_POOL_BOT + DLC 동료 (기본)
-- OFF (cv_baseCharsOff=1): DLC 동료만 (DLC 테스터 / DLC-only 운영용)
function baseCharsON(triggerId)
    setChatVar(triggerId, "cv_baseCharsOff", "0")
    setChatVar(triggerId, "cv_companionPoolCache", "")  -- 다음 가챠 시 풀 재빌드
    _stayInGuide(triggerId)  -- 내부에서 appendSave (setChat → 재렌더)
end
function baseCharsOFF(triggerId)
    setChatVar(triggerId, "cv_baseCharsOff", "1")
    setChatVar(triggerId, "cv_companionPoolCache", "")
    _stayInGuide(triggerId)
end

-- ============================================================================
-- COMPANION GRID HTML BUILDER (사이드패널 👥 동료 탭용)
-- Lua가 한글명 + 영문 prefix 병렬 처리로 HTML 직접 빌드 (CBS 병렬 iter 한계 우회)
-- 결과는 cv_companionsGrid 채팅 변수에 저장, 정규식이 {{getvar}}로 출력
-- 매 onOutput에서 갱신 (SAVE에는 포함 X — 매번 재구성, save bloat 방지)
-- ============================================================================
local function buildCompanionsGrid(triggerId)
    local kor_str = safeGetVar(triggerId, "cv_companions", "None")
    local eng_str = safeGetVar(triggerId, "cv_companionsEng", "None")

    local empty_html = '<div class="gi-empty">아직 동료가 없습니다</div>'

    if kor_str == "None" or kor_str == "" or kor_str == "null" then
        return empty_html
    end

    -- Parse 한글명 / 영문 prefix 리스트
    local kor_list = {}
    for k in kor_str:gmatch("([^,]+)") do
        local kt = k:match("^%s*(.-)%s*$")
        if kt and kt ~= "" then table.insert(kor_list, kt) end
    end
    local eng_list = {}
    if eng_str ~= "None" and eng_str ~= "" and eng_str ~= "null" then
        for e in eng_str:gmatch("([^,]+)") do
            local et = e:match("^%s*(.-)%s*$")
            if et and et ~= "" then table.insert(eng_list, et) end
        end
    end

    if #kor_list == 0 then return empty_html end

    -- 가챠 게임 풀-블리드 카드 디자인 (서브컬쳐 미소녀 가챠 스타일)
    -- ★ portrait 1:1.4 비율, 이미지 full bleed, 이름 오버레이 (라벨 따로 X)
    -- ★ 두꺼운 골드 그라데이션 보더 + 외부 글로우 box-shadow
    -- ★ 우상단 ⭐ 데코 (gacha 분위기)
    -- ★ 하단 페이드 + 골드 이름 (텍스트 글로우)
    -- 클린 가챠 카드: 2열 그리드, portrait 1:1.5, 골드 보더, 흰 이름
    -- ★ 레이아웃 인라인 (CSS 없어도 100% 작동)
    -- ★ class="gi-comp-card" — CSS 임포트 시 hover shimmer 효과 추가 (degrades gracefully)
    local parts = {'<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:12px;">'}
    for i = 1, #kor_list do
        local kor = kor_list[i]
        local eng = eng_list[i] or kor
        local img_url = ""
        pcall(function() img_url = cbs("{{path::" .. eng .. "_neutral.webp}}") or "" end)

        -- 자산 resolution 실패 감지: cbs()가 빈 문자열 또는 echo (path 미해결)
        local img_resolved = img_url ~= ""
            and img_url ~= (eng .. "_neutral.webp")
            and not img_url:find("{{path::", 1, true)

        -- 이미지 블록: placeholder 배경 + image overlay 2-layer
        -- 1) placeholder 배경 (image 실패 시 보임)
        -- 2) image div 위에 박힘 (cbs() resolved 또는 raw {{path::}} 매크로 — 양쪽 다 시도)
        --    image 박히면 placeholder 가려짐, 실패 시 placeholder 노출
        local placeholder_html = '<div style="' ..
            'position:absolute;top:0;left:0;width:100%;height:100%;' ..
            'display:flex;flex-direction:column;align-items:center;justify-content:center;' ..
            'background:linear-gradient(135deg,#2a2438 0%,#1a1828 50%,#0d0c18 100%);' ..
            'gap:6px;padding:8px;box-sizing:border-box;' ..
            '">' ..
            '<div style="font-size:2.4em;opacity:0.4;line-height:1;">🎴</div>' ..
            '<div style="font-size:0.7em;color:rgba(255,235,160,0.65);text-align:center;line-height:1.3;font-weight:600;word-break:break-word;">' .. eng .. '</div>' ..
            '<div style="font-size:0.55em;color:rgba(255,255,255,0.35);text-align:center;line-height:1.2;">(에셋 미로드)</div>' ..
            '</div>'
        -- cbs() 성공 시 resolved URL, 실패 시 raw 매크로 fallback (RisuAI nested 평가 시도)
        local resolved_url = img_resolved and img_url or ("{{path::" .. eng .. "_neutral.webp}}")
        local img_layer = '<div class="gi-comp-img" style="' ..
            'position:absolute;top:0;left:0;width:100%;height:100%;' ..
            'background-image:url(\'' .. resolved_url .. '\');' ..
            'background-size:cover;' ..
            'background-position:center;' ..
            '"></div>'
        local img_block = placeholder_html .. img_layer

        -- 외곽 카드 (골드 보더)
        parts[#parts+1] = '<div class="gi-comp-card" style="' ..
            'position:relative;' ..
            'border-radius:13px;' ..
            'padding:2.5px;' ..
            'background:linear-gradient(135deg,#fff4c4 0%,#ffd966 25%,#d4a84e 55%,#8b6e2f 90%,#5a4520 100%);' ..
            'box-shadow:0 5px 16px rgba(0,0,0,0.5),0 0 16px rgba(255,200,80,0.22),inset 0 0 0 1px rgba(0,0,0,0.4);' ..
            'overflow:hidden;' ..
            '">' ..
            -- 내부 이미지 컨테이너 (portrait 1:1.3)
            '<div style="' ..
            'position:relative;' ..
            'width:100%;' ..
            'padding-top:130%;' ..
            'border-radius:10.5px;' ..
            'overflow:hidden;' ..
            'background:#0a0d18;' ..
            '">' ..
            img_block ..
            -- 하단 이름 (한글, 흰색 중앙)
            '<div style="' ..
            'position:absolute;bottom:0;left:0;right:0;' ..
            'padding:18px 6px 8px;' ..
            'background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,0.65) 45%,rgba(0,0,0,0.92) 100%);' ..
            'text-align:center;' ..
            'pointer-events:none;' ..
            '">' ..
            '<div style="' ..
            'font-size:0.82em;' ..
            'font-weight:700;' ..
            'color:#ffffff;' ..
            'text-shadow:0 1px 3px #000,0 0 5px rgba(0,0,0,0.9);' ..
            'letter-spacing:0.5px;' ..
            '">' .. kor .. '</div>' ..
            '</div>' ..
            '</div>' ..
            '</div>'
    end
    parts[#parts+1] = '</div>'
    return table.concat(parts)
end

-- #343: 가챠 버튼 클릭 시 사이드 패널 유지 — addChat 재렌더 후에도 radio가 checked 상태로 복원되도록
-- cv_gachaPanelOpen=1 마킹. STATUS_PANEL out HTML이 var=1 일 때 #gi-side-gacha 라디오에 checked 부착.
-- #373 후속 (Bug 3): cv_panelStayOnce="gacha" 설정 → onOutput END 가 이번 응답만 stay 허용 후 자동 reset
--                  → 후속 응답마다 패널 자동 열림 잔재 차단
local function _markGachaPanelStay(triggerId)
    smartSetChatVar(triggerId, "cv_gachaPanelOpen", "1")
    smartSetChatVar(triggerId, "cv_panelStayOnce",  "gacha")
    -- #373 Bug 1 후속: 다른 패널들 잔재 닫음 (가챠 클릭 시 가이드/인벤/강화 패널이 동시 checked 되어 last-in-DOM 으로 잘못 잡히는 거 차단)
    smartSetChatVar(triggerId, "cv_invOpen",        "0")
    smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    smartSetChatVar(triggerId, "cv_guideOpen",      "0")
    smartSetChatVar(triggerId, "cv_debugOpen",      "0")
    -- #344: 옛 chat 호환 — onOutput 안 돌고 가챠 버튼 먼저 누르는 경우(레거시) 대비
    -- 현재 chat에서 마지막 char 메시지 인덱스 찾아 cv_lastCharMsgId 설정. 게이트가 lastmessageid 대신 이걸 비교
    local chatLength = getChatLength(triggerId)
    for i = chatLength - 1, 0, -1 do
        local msg = getChat(triggerId, i)
        if msg and msg.role == "char" then
            setChatVar(triggerId, "cv_lastCharMsgId", tostring(i))
            break
        end
    end
end

function gachaCompanion(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    -- AI에 위임하지 않고 Lua가 직접 추첨해 [GACHA_PICK:한글|English] 강제
    local picked = pickRandomCompanion(triggerId)
    if picked then
        setChatVar(triggerId, "cv_lastGachaPick", picked.ko)
        addChat(triggerId, "user", "👥 동료 소환 가챠를 돌린다.[GACHA_PICK:" .. picked.ko .. "|" .. picked.en .. "]")
        print(string.format("[GachaIsland] COMPANION_PICK: %s (%s) origin=%s", picked.ko, picked.en, picked.origin))
    else
        -- pickRandomCompanion은 이제 항상 picked 리턴 (nil 안 옴) — 이 분기는 도달 불가능, 안전판
        addChat(triggerId, "user", "👥 동료 소환 가챠를 돌린다.")
        print("[GachaIsland] COMPANION_PICK: pickRandomCompanion returned nil unexpectedly")
    end
end

-- =============================================
-- COMPANION REROLL (500P) — 동료 다시 뽑기
-- 직전 소환된 동료를 500P 로 새 동료로 교체. 일반 답변 리롤 대체 (몰입/변수 안정).
-- =============================================
local function _rerollParsePoints(raw)
    raw = tostring(raw or "0"):gsub(",", "")
    return tonumber(raw) or 0
end

local function _rerollFormatPoints(n)
    n = math.max(0, math.floor(tonumber(n) or 0))
    return tostring(n):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function _rerollSplitCsv(raw)
    local list = {}
    if raw and raw ~= "" and raw ~= "None" and raw ~= "null" then
        for entry in tostring(raw):gmatch("([^,]+)") do
            local v = entry:match("^%s*(.-)%s*$") or ""
            if v ~= "" then list[#list+1] = v end
        end
    end
    return list
end

local function _rerollJoinCsv(list)
    if not list or #list == 0 then return "None" end
    return table.concat(list, ", ")
end

local function _rerollFindLastCompanion(triggerId)
    local korList = _rerollSplitCsv(safeGetVar(triggerId, "cv_companions", "None"))
    local engList = _rerollSplitCsv(safeGetVar(triggerId, "cv_companionsEng", "None"))
    if #korList == 0 then return nil, nil end
    return korList[#korList], engList[#korList]
end

local function _rerollPickReplacement(triggerId, oldKo)
    local pool = buildMergedPool(triggerId)
    local summoned = {}
    for _, name in ipairs(_rerollSplitCsv(safeGetVar(triggerId, "cv_companions", "None"))) do
        if name ~= oldKo then summoned[name] = true end
    end
    local candidates = {}
    for _, c in ipairs(pool) do
        if c.ko ~= oldKo and not summoned[c.ko] then
            candidates[#candidates+1] = c
        end
    end
    if #candidates == 0 then return nil end
    return candidates[math.random(#candidates)]
end

local function _rerollReplaceCompanion(triggerId, oldKo, newCompanion)
    local korList = _rerollSplitCsv(safeGetVar(triggerId, "cv_companions", "None"))
    local engList = _rerollSplitCsv(safeGetVar(triggerId, "cv_companionsEng", "None"))
    local idx = nil
    for i, name in ipairs(korList) do
        if name == oldKo then idx = i; break end
    end
    if not idx then return false end
    korList[idx] = newCompanion.ko
    engList[idx] = (newCompanion.en or ""):match("^(%S+)") or newCompanion.en or ""
    setChatVar(triggerId, "cv_companions",    _rerollJoinCsv(korList))
    setChatVar(triggerId, "cv_companionsEng", _rerollJoinCsv(engList))
    setChatVar(triggerId, "cv_lastGachaPick", newCompanion.ko)
    return true
end

function gachaCompanionReroll(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)

    if safeGetVar(triggerId, "cv_dungeonActive", "0") == "1" then
        alertError(triggerId, "던전 안에서는 동료 다시 뽑기를 사용할 수 없습니다.")
        return
    end

    local oldKo, oldEn = _rerollFindLastCompanion(triggerId)
    if not oldKo or oldKo == "" or oldKo == "None" or oldKo == "null" then
        alertError(triggerId, "다시 뽑을 최근 동료가 없습니다.")
        return
    end

    local curPoints = _rerollParsePoints(safeGetVar(triggerId, "cv_points", "0"))
    if curPoints < 500 then
        alertError(triggerId, "포인트가 부족합니다. 다시 뽑기에는 500P가 필요합니다.")
        return
    end

    local picked = _rerollPickReplacement(triggerId, oldKo)
    if not picked then
        alertError(triggerId, "교체 가능한 미소환 동료가 없습니다.")
        return
    end

    if not _rerollReplaceCompanion(triggerId, oldKo, picked) then
        alertError(triggerId, "기존 동료를 찾지 못해 다시 뽑기를 중단했습니다.")
        return
    end

    setChatVar(triggerId, "cv_points", _rerollFormatPoints(curPoints - 500))
    setChatVar(triggerId, "cv_skipNextRerollPoint", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "gacha")

    -- #537 CRITICAL: 직전 char msg 의 SAVE 갱신 — onOutput SAVE_LOAD 가 cv_companions 를 옛 동료로
    -- 덮어쓰지 않도록 reroll 상태 (바이켄 + 도바킨, points -500 등) 를 prior msg seed 에 박음.
    -- dungeonReturn 과 동일 패턴 — state-mutating 버튼 후 addChat 전 필수.
    appendSaveToCurrentMessage(triggerId)

    addChat(triggerId, "user", "👥 동료 다시 뽑기를 실행한다. 직전 소환 동료 " .. oldKo .. "를 계약 해제하고 500P로 새 동료를 다시 뽑는다.[GACHA_REROLL:" .. oldKo .. "|" .. (oldEn or "") .. "][GACHA_REROLL_PAID:500P][GACHA_PICK:" .. picked.ko .. "|" .. picked.en .. "]")
    print(string.format("[GachaIsland] COMPANION_REROLL: %s -> %s (%s), POINT %d -> %d", oldKo, picked.ko, picked.en, curPoints, curPoints - 500))
end

-- 커플 아이템 가챠: 1,000P, 차원주머니 아이템으로 저장 (성소/성역 충전 보조)
function gachaCouple(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    local c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
    local c2 = GACHA_CAT2_COUPLE[math.random(#GACHA_CAT2_COUPLE)]
    local c3 = GACHA_CAT3_COUPLE[math.random(#GACHA_CAT3_COUPLE)]
    local tier = rollGachaTier()
    addChat(triggerId, "user", "💞 커플 아이템 가챠를 돌린다.[GACHA_CATS:커플|" .. c1 .. "|" .. c2 .. "|" .. c3 .. "][GACHA_TIER:" .. tier .. "]")
end

-- 사이드 패널 닫기 (✕ 버튼 / backdrop 클릭 시 호출) — 채팅 전환·재방문 후 패널 auto-reopen 차단
-- 단순 <label for="gi-side-none"> 는 CSS 라디오 상태만 바꾸고 cv_*Open 변수는 그대로라
-- 다른 채팅 갔다 돌아오면 CBS 가 cv_*Open=1 보고 패널 재오픈. 명시적 reset 필요.
-- ✕ 버튼 / backdrop 클릭 시 chat var 만 클리어 (CSS 슬라이드 애니메이션 보존).
--   reloadDisplay 호출 시 DOM 재렌더링되어 CSS transition 끊김 → 호출 안 함.
--   appendSaveToCurrentMessage 의 setChat 도 마찬가지 → 호출 안 함 (다음 응답 onOutput 끝의 자동 SAVE 에 위임).
--   CSS 닫힘 애니메이션은 <label for="gi-side-none"> 의 라디오 변경이 담당.
function closeSidePanel(triggerId)
    smartSetChatVar(triggerId, "cv_invOpen",        "0")
    smartSetChatVar(triggerId, "cv_gachaPanelOpen", "0")
    smartSetChatVar(triggerId, "cv_forgeOpen",      "0")
    smartSetChatVar(triggerId, "cv_guideOpen",      "0")
    smartSetChatVar(triggerId, "cv_debugOpen",      "0")
    smartSetChatVar(triggerId, "cv_panelStayOnce",  "")
end

function gachaRelic(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    local c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
    local c2 = GACHA_CAT2_RELIC[math.random(#GACHA_CAT2_RELIC)]
    local tier = rollGachaTier()
    addChat(triggerId, "user", "🏺 유물 획득 가챠를 돌린다.[GACHA_CATS:유물|" .. c1 .. "|" .. c2 .. "][GACHA_TIER:" .. tier .. "]")
end

function gachaFacility(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    local c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
    local c2 = GACHA_CAT2_FAC[math.random(#GACHA_CAT2_FAC)]
    local tier = rollGachaTier()
    addChat(triggerId, "user", "🏛 시설 건설 가챠를 돌린다.[GACHA_CATS:시설|" .. c1 .. "|" .. c2 .. "][GACHA_TIER:" .. tier .. "]")
end

function gachaSkill(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    local c1 = GACHA_CAT2_SKILL1[math.random(#GACHA_CAT2_SKILL1)]
    local c2 = GACHA_CAT2_SKILL2[math.random(#GACHA_CAT2_SKILL2)]
    local tier = rollGachaTier()
    -- #425: 공격 sub-type 일 때 range axis (단일/광역) 추가 추첨
    local cats = "스킬|" .. c1 .. "|" .. c2
    if c2 == "공격" then
        local c3 = GACHA_CAT3_SKILL_RANGE[math.random(#GACHA_CAT3_SKILL_RANGE)]
        cats = cats .. "|" .. c3
    end
    addChat(triggerId, "user", "✨ 스킬 습득 가챠를 돌린다.[GACHA_CATS:" .. cats .. "][GACHA_TIER:" .. tier .. "]")
end

-- 보급품 카테고리 1회 분 결정 (stage 1+ <생존> 보정 포함)
local function pickSupplyCats(triggerId)
    local c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
    local c2

    local stage = tonumber(safeGetVar(triggerId, "cv_islandStage", "0")) or 0
    if stage >= 1 then
        local maxHp     = tonumber(safeGetVar(triggerId, "cv_maxHp",     "100")) or 100
        local curHp     = tonumber(safeGetVar(triggerId, "cv_hp",        "100")) or 100
        local maxMana   = tonumber(safeGetVar(triggerId, "cv_maxMana",   "100")) or 100
        local curMana   = tonumber(safeGetVar(triggerId, "cv_mana",      "100")) or 100
        local maxHunger = tonumber(safeGetVar(triggerId, "cv_maxHunger", "100")) or 100
        local curHunger = tonumber(safeGetVar(triggerId, "cv_hunger",    "100")) or 100

        local hpPct     = maxHp > 0     and (curHp / maxHp)         or 1
        local manaPct   = maxMana > 0   and (curMana / maxMana)     or 1
        local hungerPct = maxHunger > 0 and (curHunger / maxHunger) or 1

        if hpPct >= 1 and manaPct >= 1 and hungerPct >= 1 then
            c2 = GACHA_CAT2_SUPPLY[math.random(#GACHA_CAT2_SUPPLY)]
            print(string.format("[GachaIsland] SUPPLY_BIAS: stage%d 모든 스탯 만충 → 랜덤(%s)", stage, c2))
        else
            local lowest = "HP"
            local lowestPct = hpPct
            if manaPct < lowestPct then lowest = "MANA"; lowestPct = manaPct end
            if hungerPct < lowestPct then lowest = "HUNGER"; lowestPct = hungerPct end

            if     lowest == "HP"     then c2 = "HP회복"
            elseif lowest == "MANA"   then c2 = "마나회복"
            else                            c2 = "배고픔회복"
            end
            print(string.format("[GachaIsland] SUPPLY_BIAS: stage%d <생존> 보정 → %s (HP:%.0f%% MANA:%.0f%% HUNGER:%.0f%%)", stage, c2, hpPct*100, manaPct*100, hungerPct*100))
        end
    else
        c2 = GACHA_CAT2_SUPPLY[math.random(#GACHA_CAT2_SUPPLY)]
    end

    return c1, c2
end

function gachaSupply(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    local c1, c2 = pickSupplyCats(triggerId)
    local tier = rollGachaTier()
    addChat(triggerId, "user", "📦 보급품 가챠를 돌린다.[GACHA_CATS:보급품|" .. c1 .. "|" .. c2 .. "][GACHA_TIER:" .. tier .. "]")
end

-- 보급품 가챠 2회 — 한 user 메시지에 [GACHA_CATS] 두 개 부착, 「보급품 가챠를 돌린다」 두 줄 표시
-- AI는 「가챠 규칙」 entry의 [MULTI GACHA_CATS] 룰에 따라 두 번 결과 + 비용 2× 차감 (총 400P)
function gachaSupplyTwice(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    local c1a, c2a = pickSupplyCats(triggerId)
    local c1b, c2b = pickSupplyCats(triggerId)
    local tierA = rollGachaTier()
    local tierB = rollGachaTier()
    local msg = "📦 보급품 가챠를 돌린다.\n📦 보급품 가챠를 돌린다." ..
        "[GACHA_CATS:보급품|" .. c1a .. "|" .. c2a .. "][GACHA_TIER:" .. tierA .. "]" ..
        "[GACHA_CATS:보급품|" .. c1b .. "|" .. c2b .. "][GACHA_TIER:" .. tierB .. "]"
    addChat(triggerId, "user", msg)
end

-- #341: 랜덤 가챠 1회분 추첨 결과를 메시지 fragment로 빌드 (gachaRandom + gachaRandomAll 공유)
-- 반환: fragment string (예: "[GACHA_CATS:랜덤|Skill|...][GACHA_TIER:N]")
local function buildRandomGachaFragment(triggerId)
    local typ = rollRandomGachaType()
    local c1, c2, c3 = "", "", ""
    if typ == "Relic" then
        c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
        c2 = GACHA_CAT2_RELIC[math.random(#GACHA_CAT2_RELIC)]
    elseif typ == "Facility" then
        c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
        c2 = GACHA_CAT2_FAC[math.random(#GACHA_CAT2_FAC)]
    elseif typ == "Skill" then
        c1 = GACHA_CAT2_SKILL1[math.random(#GACHA_CAT2_SKILL1)]
        c2 = GACHA_CAT2_SKILL2[math.random(#GACHA_CAT2_SKILL2)]
    elseif typ == "Supply" then
        c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
        c2 = GACHA_CAT2_SUPPLY[math.random(#GACHA_CAT2_SUPPLY)]
    elseif typ == "Couple" then
        c1 = GACHA_CAT1_STYLE[math.random(#GACHA_CAT1_STYLE)]
        c2 = GACHA_CAT2_COUPLE[math.random(#GACHA_CAT2_COUPLE)]
        c3 = GACHA_CAT3_COUPLE[math.random(#GACHA_CAT3_COUPLE)]
    end
    if c1 ~= "" then
        local tier = rollGachaTier()
        -- #425: 랜덤 가챠에서 Skill + 공격 sub-type 일 때 range axis 추첨
        local extra = ""
        if typ == "Skill" and c2 == "공격" then
            extra = "|" .. GACHA_CAT3_SKILL_RANGE[math.random(#GACHA_CAT3_SKILL_RANGE)]
        end
        if typ == "Couple" then
            extra = "|" .. c3
        end
        return "[GACHA_CATS:랜덤|" .. typ .. "|" .. c1 .. "|" .. c2 .. extra .. "][GACHA_TIER:" .. tier .. "]"
    else
        -- Companion: 서브 카테고리 없음 — Lua 사전 추첨
        local picked = pickRandomCompanion(triggerId)
        if picked then
            setChatVar(triggerId, "cv_lastGachaPick", picked.ko)
            print(string.format("[GachaIsland] RANDOM→COMPANION_PICK: %s (%s)", picked.ko, picked.en))
            return "[GACHA_CATS:랜덤|" .. typ .. "][GACHA_PICK:" .. picked.ko .. "|" .. picked.en .. "]"
        else
            return "[GACHA_CATS:랜덤|" .. typ .. "]"
        end
    end
end

function gachaRandom(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    local frag = buildRandomGachaFragment(triggerId)
    addChat(triggerId, "user", "🎲 랜덤 가챠를 돌린다." .. frag)
end

-- #341: 보유한 가챠 티켓 전부 한 번에 사용
-- cv_items에서 "가챠 티켓 xN" 매칭 → N회 추첨 → 한 user 메시지에 모두 부착
function gachaRandomAll(triggerId)
    refreshSeed(triggerId)
    _markGachaPanelStay(triggerId)
    -- 보유 수량 추출
    local items = safeGetVar(triggerId, "cv_items", "None")
    local count = 0
    if items ~= "None" and items ~= "" and items ~= "null" then
        for entry in items:gmatch("([^,]+)") do
            local nm = entry:match("^%s*(.-)%s*$")
            local n = nm:match("^가챠 티켓%s+x(%d+)$")
            if n then
                count = tonumber(n) or 0
                break
            elseif nm == "가챠 티켓" then
                count = 1
                break
            end
        end
    end
    if count <= 0 then
        alertError(triggerId, "보유한 가챠 티켓이 없습니다.")
        return
    end
    if count == 1 then
        local frag = buildRandomGachaFragment(triggerId)
        addChat(triggerId, "user", "🎲 랜덤 가챠를 돌린다." .. frag)
        return
    end
    -- N >= 2: N개 fragment 조립
    local lines = {}
    local frags = {}
    for i = 1, count do
        lines[#lines+1] = "🎲 랜덤 가챠를 돌린다."
        frags[#frags+1] = buildRandomGachaFragment(triggerId)
    end
    local msg = table.concat(lines, "\n") .. table.concat(frags, "")
    addChat(triggerId, "user", msg)
    print(string.format("[GachaIsland] RANDOM_ALL: 가챠 티켓 %d장 한 번에 사용", count))
end

-- =============================================
-- DUNGEON CHOICE BUTTON HANDLERS (던전 클리어 후 / 성역 진입 시)
-- 가챠 버튼과 동일하게 채팅창에 자동 입력하여 다음 응답을 유도.
-- =============================================

-- 던전 종료 상태를 강제 동기화 (AI가 DUNGEON_EXIT 태그 누락해도 안전)
local function forceCloseDungeon(triggerId)
    smartSetChatVar(triggerId, "cv_dungeonActive",         "0")
    smartSetChatVar(triggerId, "cv_dungeonGateState",      "닫힘")
    smartSetChatVar(triggerId, "cv_currentFloor",          "0")
    smartSetChatVar(triggerId, "cv_activeFloorCondition",  "없음")
    smartSetChatVar(triggerId, "cv_activeDungeonType",     "None")
    smartSetChatVar(triggerId, "cv_sanctuarySpawnedFloor", "0")
    smartSetChatVar(triggerId, "cv_sanctuarySpawnedMsg",   "-1")  -- #452
    smartSetChatVar(triggerId, "cv_sanctuaryConsumed",     "0")   -- #452
    -- 라운드 시스템 + 몬스터 리셋
    smartSetChatVar(triggerId, "cv_currentRound",          "0")
    smartSetChatVar(triggerId, "cv_totalRounds",           "0")
    smartSetChatVar(triggerId, "cv_roundEvents",           "")
    smartSetChatVar(triggerId, "cv_roundPanel",            "")
    smartSetChatVar(triggerId, "cv_currentMonsters",       "")
    smartSetChatVar(triggerId, "cv_monsterPanel",          "")
    smartSetChatVar(triggerId, "cv_pendingMonsterSpawn",   "0")  -- #455 pending spawn flag reset
    smartSetChatVar(triggerId, "cv_mazeEscapeCount",       "0")  -- #308 미로형 카운트 리셋
    smartSetChatVar(triggerId, "cv_mazeFailStreak",        "0")  -- #436 미로 anti-stall 리셋
    print("[GachaIsland] forceCloseDungeon: 모든 던전 state 초기화 (라운드 + 몬스터 + 미로 카운트/streak 포함)")
end

-- =============================================
-- ROUND SYSTEM (Phase 1) — 라운드 카운터 + UI 패널 + advance 메커니즘
-- 던전 형식별 라운드 수: 결전형=1, 탐색/토벌/미로=3~10 (형식별 별도 범위)
-- 라운드 이벤트 시퀀스: cv_roundEvents에 "E|E|S|E|E" 형식 저장 (E=Event, S=Sanctuary, B=Boss)
-- 결전형: 1 라운드, 보스 1마리 multi-phase
-- =============================================
-- 라운드 시스템 — 4종 운용 (탐색형 / 토벌형 / 미로형 / 결전형)
-- 탐색형: 5~10 라운드, mid=S, last=B, 나머지 random (M 40% / T 25% / E 25% / I 10%)
-- 토벌형: 3~6 라운드, mid=S, last=B, 나머지 모두 M (몬스터만)
-- 미로형: 무한 라운드 (cv_totalRounds=0). 모든 라운드 E (탐색) 고정 (#436). 마나/허기만 소모. NO M/T/I.
-- 결전형: 1 라운드, B (보스 단일)
-- 이벤트 코드: M=몬스터 / E=탐색 / T=함정 / I=보급품 / S=성역 / B=보스 / X=출구
-- 성역 위치: mid = math.floor(total / 2) + 1 → 4→3, 5→3, 6→4, 7→4, 8→5, 9→5, 10→6
local function rollRoundsForFloor(triggerId, dungeonType)
    refreshSeed(triggerId)
    local totalRounds
    local events = {}

    -- 형식별 비전투 이벤트 가중치 풀 (탐색형/미로형)
    local function pickRandomEvent(weights)
        local r = math.random(100)
        local acc = 0
        for _, w in ipairs(weights) do
            acc = acc + w.weight
            if r <= acc then return w.code end
        end
        return weights[#weights].code  -- fallback
    end

    if dungeonType == "결전형" then
        totalRounds = 1
        events = { "B" }
    elseif dungeonType == "탐색형" then
        -- 5~10 라운드. M 40% / T 25% / E 25% / I 10%
        totalRounds = math.random(5, 10)
        local mid = math.floor(totalRounds / 2) + 1
        local weights = {
            {code="M", weight=40}, {code="T", weight=25},
            {code="E", weight=25}, {code="I", weight=10},
        }
        for i = 1, totalRounds do
            if     i == mid          then events[i] = "S"
            elseif i == totalRounds  then events[i] = "B"
            else                          events[i] = pickRandomEvent(weights)
            end
        end
    elseif dungeonType == "토벌형" then
        -- 3~6 라운드, 나머지 모두 M
        totalRounds = math.random(3, 6)
        local mid = math.floor(totalRounds / 2) + 1
        for i = 1, totalRounds do
            if     i == mid          then events[i] = "S"
            elseif i == totalRounds  then events[i] = "B"
            else                          events[i] = "M"
            end
        end
    elseif dungeonType == "미로형" then
        -- #308 미로형 무한 라운드 시스템. cv_totalRounds=0 (무한 표시).
        -- cv_mazeEscapeCount: 매 advanceRound 시 cv_combatResult ∈ {대성공, 성공}이면 +1
        -- 3 도달 시 X (출구) 라운드 자동 발생
        -- #436: 미로형 = exploration-only. 모든 라운드 E (탐색). M/T/I 제거. 마나/허기만 소모.
        -- cv_mazeFailStreak: 보통/실패/대실패 누적 카운트. 다음 라운드 rate +5% per stack. 성공 시 reset (anti-stall).
        totalRounds = 0  -- 무한 표시
        setChatVar(triggerId, "cv_mazeEscapeCount", "0")
        setChatVar(triggerId, "cv_mazeFailStreak", "0")  -- #436
        events = { "E" }  -- #436 첫 라운드 E 고정 (이전: weighted E70/T15/M10/I5)
    else
        -- 미지정 fallback: 3/5/7 무작위 + 정중앙 S + 마지막 B
        local pool = { 3, 5, 7 }
        totalRounds = pool[math.random(#pool)]
        local mid = math.floor(totalRounds / 2) + 1
        for i = 1, totalRounds do
            if     i == mid          then events[i] = "S"
            elseif i == totalRounds  then events[i] = "B"
            else                          events[i] = "M"
            end
        end
    end

    setChatVar(triggerId, "cv_currentRound", "1")
    setChatVar(triggerId, "cv_totalRounds",  tostring(totalRounds))
    setChatVar(triggerId, "cv_roundEvents",  table.concat(events, "|"))
    setChatVar(triggerId, "cv_hungerDrainAppliedRound", "-1")  -- 새 던전/floor 진입 시 reset (이전 던전 잔재 차단)
    print(string.format("[GachaIsland] ROUNDS_ROLLED: %s floor, %d rounds, seq=%s",
        dungeonType, totalRounds, table.concat(events, "|")))
end

-- 라운드 패널 HTML 생성 (정규식이 {{getvar::cv_roundPanel}}로 출력)
local function buildRoundPanel(triggerId)
    local dungeonActive = safeGetVar(triggerId, "cv_dungeonActive", "0")
    if dungeonActive ~= "1" then
        setChatVar(triggerId, "cv_roundPanel", "")
        return
    end
    local total = tonumber(safeGetVar(triggerId, "cv_totalRounds", "0")) or 0
    local cur   = tonumber(safeGetVar(triggerId, "cv_currentRound", "0")) or 0
    local evStr = safeGetVar(triggerId, "cv_roundEvents", "")
    local dType = safeGetVar(triggerId, "cv_activeDungeonType", "None")

    local events = {}
    for e in evStr:gmatch("([^|]+)") do events[#events+1] = e end

    -- #467 라운드 advance 직후 표시 lag — pendingSpawn=1 (advance 직후, 다음 라운드 monster 미spawn) 면
    --   visual cur 을 cur-1 로 표시 → "방금 끝낸 라운드" 가 current 로 보이게.
    --   cur=1 (첫 라운드 setup 직후) 은 예외 — advance 안 일어났음.
    -- #507: S/X/T/I/E (비전투) 라운드는 visual lag 적용 안 함 — pendingSpawn=1 이 SAVE_LOAD 로 복원돼도
    --   실제 cur 표시. 전투 라운드 (M/B) 만 「다음 monster spawn 대기」 라 visual lag 적용 의미 있음.
    -- #534: 미로형 = 모든 라운드 E 고정. advance 시 pendingSpawn=1 set 됨. 사용자가 narrate 한 round 와
    --   panel 의 round 가 일치하도록 미로형 도 visual lag 대상에 포함 (escape count 도 같이 lag).
    local pendingSpawn = safeGetVar(triggerId, "cv_pendingMonsterSpawn", "0") == "1"
    local _curEv = events[cur] or ""
    local _isMaze = dType == "미로형"
    local _applyLag = pendingSpawn and cur > 1 and (_curEv == "M" or _curEv == "B" or _isMaze)
    if _applyLag then
        cur = cur - 1
    end
    -- #308 미로형 무한 모드: total=0이라도 패널 빌드 (사용자 명세 "?" 표기)
    if evStr == "" or (total <= 0 and dType ~= "미로형") then
        setChatVar(triggerId, "cv_roundPanel", "")
        return
    end

    -- 미로형: displayTotal = #events (동적), 패널 트랙 끝에 "?" 슬롯 추가 (탈출 전까지)
    -- #534: escape count 는 lag 안 함 — 사용자가 narrate 한 round 의 성공 결과 (escape +1) 를 패널에 즉시 반영
    --   (cur 만 lag → "라운드 N (narrate 직후) — 진행 M/3" 형태로 표시)
    local mazeEscapeCount = tonumber(safeGetVar(triggerId, "cv_mazeEscapeCount", "0")) or 0
    local displayTotal = (dType == "미로형") and #events or total

    -- 이벤트 → 아이콘 매핑 (#305 신규: M/T/I/E 분리)
    local iconFor = function(ev, isPast, isCurrent)
        local icon = "⚔"
        if     ev == "S" then icon = "⛲"
        elseif ev == "B" then icon = "👑"
        elseif ev == "X" then icon = "🚪"
        elseif ev == "M" then icon = "⚔"  -- 몬스터 전투
        elseif ev == "T" then icon = "⚠"  -- 함정
        elseif ev == "I" then icon = "📦"  -- 보급품 발견
        elseif ev == "E" then icon = "🗺"  -- 탐색 (신규 의미: 비전투 자유 narration / 옛 E는 동일 아이콘으로 표시)
        end
        return icon
    end

    -- 형식별 헤더
    local headerLabel
    if     dType == "결전형" then headerLabel = "⚔ 결전 — 단일 라운드"
    elseif dType == "탐색형" then headerLabel = string.format("🗺 탐색 라운드 %d / %d", cur, total)
    elseif dType == "토벌형" then headerLabel = string.format("⚔ 토벌 라운드 %d / %d", cur, total)
    elseif dType == "미로형" then
        -- #308 미로형: 무한 라운드 + 탈출 진행도
        if mazeEscapeCount >= 3 then
            headerLabel = string.format("🌀 미로 라운드 %d — 🚪 출구!", cur)
        else
            headerLabel = string.format("🌀 미로 라운드 %d / ? — 탈출 진행 %d / 3", cur, mazeEscapeCount)
        end
    else                          headerLabel = string.format("던전 라운드 %d / %d", cur, total)
    end

    -- 라운드 트랙 (각 step)
    local steps = {}
    for i = 1, displayTotal do
        local ev = events[i] or "E"
        local icon = iconFor(ev)
        local state, opacity, scale, ring
        if i < cur then
            state = "done";    opacity = "0.45"; scale = "0.92"; ring = "transparent"
        elseif i == cur then
            state = "current"; opacity = "1";    scale = "1.15"; ring = "#ffd966"
        else
            state = "pending"; opacity = "0.7";  scale = "1";    ring = "transparent"
        end
        local bgColor
        if     ev == "S" then bgColor = "linear-gradient(135deg,#4ea3ff,#2b6bdb)"  -- 파랑 (성역)
        elseif ev == "B" then bgColor = "linear-gradient(135deg,#ff7a4e,#c93f1c)"  -- 빨강 (보스)
        elseif ev == "X" then bgColor = "linear-gradient(135deg,#b8a3ff,#5a3fc9)"  -- 보라 (출구)
        elseif ev == "M" then bgColor = "linear-gradient(135deg,#ff9870,#c95a32)"  -- 주황 (몬스터 전투)
        elseif ev == "T" then bgColor = "linear-gradient(135deg,#ffd166,#c98a1c)"  -- 황색 (함정)
        elseif ev == "I" then bgColor = "linear-gradient(135deg,#9eff9e,#3fa554)"  -- 녹색 (보급품)
        elseif ev == "E" then bgColor = "linear-gradient(135deg,#a0a8c0,#4a5070)"  -- 회청 (탐색)
        else                  bgColor = "linear-gradient(135deg,#5a5a6e,#2a2a3a)"  -- 회색 (미지정)
        end
        steps[#steps+1] = string.format(
            '<span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%%;background:%s;font-size:1.05em;line-height:1;opacity:%s;transform:scale(%s);box-shadow:0 0 0 2px %s,0 2px 6px rgba(0,0,0,0.4);transition:all 0.25s;">%s</span>',
            bgColor, opacity, scale, ring, icon
        )
    end
    -- #308 미로형: 카운트 < 3일 때 다음 라운드 "?" 미정 슬롯 추가 (사용자 명세)
    -- #329 화이트/블루 톤
    if dType == "미로형" and mazeEscapeCount < 3 then
        steps[#steps+1] = '<span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#e2e8f0,#cbd5e1);font-size:1.05em;line-height:1;opacity:0.7;color:#5a7b9a;font-weight:700;box-shadow:0 0 0 2px transparent,0 2px 6px rgba(45,108,176,0.15);transition:all 0.25s;">?</span>'
    end
    -- 화살표 연결 (sep)
    local sep = '<span style="opacity:0.6;font-size:0.9em;color:#5a7b9a;">›</span>'
    local trackHtml = table.concat(steps, sep)

    local panelHtml = string.format(
        '<div style="margin:8px auto 6px;max-width:680px;padding:10px 14px;border-radius:12px;background:rgba(245,251,255,0.97);border:1.5px solid rgba(45,108,176,0.45);box-shadow:0 4px 20px rgba(45,108,176,0.12),0 0 15px rgba(45,108,176,0.08);"><div style="font-size:0.78em;font-weight:700;color:#2d6cb0;letter-spacing:0.4px;margin-bottom:8px;text-shadow:0 0 8px rgba(45,108,176,0.2);">%s</div><div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:center;">%s</div></div>',
        headerLabel, trackHtml
    )
    setChatVar(triggerId, "cv_roundPanel", panelHtml)
end

-- =============================================
-- MONSTER SYSTEM (Phase 2) — HP 추적 + 층 스케일링 + 등급별 baseline + 다수 몬스터 패널
-- 데미지 공식: 스킬 데미지 = mana_cost × 2 (entry [15] / [3])
-- 받는 피해: cv_combatResult 실패/대실패 시 entry [15] HP Damage Table × 층 단계 자동 적용
-- (몬스터 공격력은 별도 변수 X — 받는 피해로 치환)
-- =============================================
-- #361: 4-tier 층 구간(저층/중층/고층/무한층) 전면 폐기 → 점진적 선형 multiplier.
--   공식: 1 + (floor - 1) × 0.15 (사용자 결정 — 직관 "10층=2배" 대비 약간 완만한 곡선)
--   1층=1.0 / 10층=2.35 / 50층=8.35 / 100층=15.85 / 500층=75.85
--   유저 데미지는 floor 무영향. 몬스터 HP만 ×m → 결과적으로 점점 단단해짐 ("묵시적 방어력").
--   처치 보상 (MONSTER_BASELINE.point × m) 도 자연 증가하여 가챠 비용 대비 균형 유지.
local function floorMultiplier(floor)
    floor = tonumber(floor) or 1
    if floor < 1 then floor = 1 end
    return 1.0 + (floor - 1) * 0.15
end

-- 몬스터 등급별 baseline (1층 기준). 결전형 보스 ×2 stack 적용 시 6000.
-- #448 보스 HP 280 → 200 하향. 마나 100 통 + floor 페널티 고려 시 1층 탐색형/토벌형 보스가 너무 빠듯해서 조정.
local MONSTER_BASELINE = {
    normal = { hp = 40,  point =   100 },
    elite  = { hp = 100, point =   500 },
    boss   = { hp = 200, point =  3000 },
}

-- 몬스터 이름은 LLM이 던전 테마에 맞춰 자유 생성.
-- spawn 시점엔 generic placeholder만 부여 → LLM이 [SYSTEM|MONSTER_INIT:N 이름] 태그로 명명 → setMonsterName이 슬롯 갱신.
local function placeholderName(tier, idx)
    local label
    if     tier == "boss"  then label = "보스"
    elseif tier == "elite" then label = "엘리트"
    else                        label = "적"
    end
    return label .. (idx and idx > 1 and (" " .. idx) or "")
end

-- LLM이 [SYSTEM|MONSTER_INIT:슬롯번호 이름] 출력 시 호출 — cv_currentMonsters 의 해당 슬롯 이름만 갱신 (HP/tier 보존)
local function setMonsterName(triggerId, slotIdx, newName)
    if not slotIdx or slotIdx < 1 then return end
    if not newName or newName == "" then return end
    local mStr = safeGetVar(triggerId, "cv_currentMonsters", "")
    if mStr == "" then return end
    local entries = {}
    for entry in mStr:gmatch("([^;][^;]*)") do
        if entry ~= "" and entry ~= ";" then entries[#entries+1] = entry end
    end
    if slotIdx > #entries then return end
    local tier, hp, maxHp, oldName = entries[slotIdx]:match("([^|]+)|([^|]+)|([^|]+)|(.+)")
    if not tier then return end
    entries[slotIdx] = string.format("%s|%s|%s|%s", tier, hp, maxHp, newName)
    setChatVar(triggerId, "cv_currentMonsters", table.concat(entries, ";;"))
    print(string.format("[GachaIsland] MONSTER_INIT: slot %d '%s' → '%s'", slotIdx, oldName, newName))
end

-- 현재 라운드 이벤트 + 형식에 맞춰 몬스터 스폰
-- 결과: cv_currentMonsters = "tier|hp|maxHp|name;;tier|hp|maxHp|name"
local function spawnMonstersForRound(triggerId)
    local active = safeGetVar(triggerId, "cv_dungeonActive", "0")
    if active ~= "1" then
        setChatVar(triggerId, "cv_currentMonsters", "")
        return
    end
    local dType = safeGetVar(triggerId, "cv_activeDungeonType", "None")
    local floor = tonumber(safeGetVar(triggerId, "cv_currentFloor", "1")) or 1
    local cur   = tonumber(safeGetVar(triggerId, "cv_currentRound", "1")) or 1
    local evStr = safeGetVar(triggerId, "cv_roundEvents", "")
    local events = {}
    for e in evStr:gmatch("([^|]+)") do events[#events+1] = e end
    local ev = events[cur] or "E"
    local mult = floorMultiplier(floor)
    refreshSeed(triggerId)

    local spawns = {}  -- {tier=..., name=...} list
    -- #305 새 이벤트 코드: M=몬스터 / E=탐색 / T=함정 / I=보급품 / S=성역 / B=보스 / W=wave / X=출구
    -- 옛 채팅 호환: E (구 의미: 확률적 일반 이벤트) 도 동일 분기 (탐색형 30% 전투 / 미로형 100% 비전투 #436)
    -- #436 legacy maze guard: 미로형 = exploration-only. M/T/I 라운드는 모두 E (탐색)로 처리 (구 채팅 호환).
    if dType == "미로형" and (ev == "M" or ev == "T" or ev == "I") then
        setChatVar(triggerId, "cv_currentMonsters", "")
        print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (legacy maze ev=%s → E exploration #436)", cur, ev))
        return
    end
    if ev == "S" or ev == "X" or ev == "T" or ev == "I" then
        -- 비전투 라운드 (성역 / 출구 / 함정 / 보급품)
        setChatVar(triggerId, "cv_currentMonsters", "")
        print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (%s) — non-combat", cur, ev))
        return
    elseif ev == "B" then
        spawns[1] = { tier = "boss", name = placeholderName("boss", 1) }
    elseif ev == "M" then
        -- #305 M = 명시적 몬스터 전투 라운드. 엘리트 20% 확률 (등장 시 엘리트 1마리만).
        if math.random(100) <= 20 then
            spawns[1] = { tier = "elite", name = placeholderName("elite", 1) }
        else
            local count = 1
            if     dType == "토벌형" then
                count = math.random(2, 3)
            elseif dType == "탐색형" then
                local roll = math.random(100)
                if     roll <= 70 then count = 1
                elseif roll <= 95 then count = 2
                else                  count = 3
                end
            end
            -- 미로형 / 기타: 1마리
            for i = 1, count do
                spawns[#spawns+1] = { tier = "normal", name = placeholderName("normal", i) }
            end
        end
    elseif ev == "E" then
        -- 옛 채팅 호환: E (구 의미) — 형식별 확률 분기
        --   탐색형 30% 전투 / 미로형 100% 비전투 (#436) / 토벌형 100% 전투 / 기타 0%
        --   신규 채팅에서는 E = 명시적 탐색(비전투)이지만 룰 일관성 위해 이 분기는 유지
        local nonCombatChance = 100
        if     dType == "탐색형" then nonCombatChance = 70
        elseif dType == "미로형" then nonCombatChance = 100  -- #436: 미로형 = exploration-only, 절대 spawn 안 함
        elseif dType == "토벌형" then nonCombatChance = 0
        end
        if math.random(100) <= nonCombatChance then
            setChatVar(triggerId, "cv_currentMonsters", "")
            print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (E %s 비전투) — supply/trap/sanity", cur, dType))
            return
        end
        spawns[#spawns+1] = { tier = "normal", name = placeholderName("normal", 1) }
    else
        -- 미지정 이벤트 → 비전투 처리 (안전판)
        setChatVar(triggerId, "cv_currentMonsters", "")
        print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (%s unknown) — non-combat fallback", cur, ev))
        return
    end

    -- 직렬화: tier|hp|maxHp|name (HP는 baseline × floor multiplier, round-up)
    local parts = {}
    for _, m in ipairs(spawns) do
        local base = MONSTER_BASELINE[m.tier] or MONSTER_BASELINE.normal
        local maxHp = math.ceil(base.hp * mult)
        parts[#parts+1] = string.format("%s|%d|%d|%s", m.tier, maxHp, maxHp, m.name)
    end
    setChatVar(triggerId, "cv_currentMonsters", table.concat(parts, ";;"))
    print(string.format("[GachaIsland] MONSTER_SPAWN: round %d (%s) floor %d ×%.1f — %s", cur, ev, floor, mult, table.concat(parts, ";; ")))
end

-- 몬스터 HP 패널 HTML (분수 HP 바 스타일, 각자 따로 표시)
local function buildMonsterPanel(triggerId)
    local active = safeGetVar(triggerId, "cv_dungeonActive", "0")
    if active ~= "1" then
        setChatVar(triggerId, "cv_monsterPanel", "")
        return
    end
    local mStr = safeGetVar(triggerId, "cv_currentMonsters", "")
    if mStr == "" then
        setChatVar(triggerId, "cv_monsterPanel", "")
        return
    end

    local bars = {}
    for entry in mStr:gmatch("([^;][^;]*)") do
        if entry ~= "" and entry ~= ";" then
            local tier, hp, maxHp, name = entry:match("([^|]+)|([^|]+)|([^|]+)|(.+)")
            if tier and hp and maxHp and name then
                local hpN  = tonumber(hp) or 0
                local maxN = tonumber(maxHp) or 1
                local pct  = math.max(0, math.min(100, math.floor(hpN / maxN * 100)))
                local label, barCol, ringCol
                if     tier == "boss"   then label = "⭐⭐⭐ "; barCol = "linear-gradient(90deg,#ff4e3a,#c91c1c)"; ringCol = "rgba(255,80,60,0.6)"
                elseif tier == "elite"  then label = "⭐⭐ ";   barCol = "linear-gradient(90deg,#b88aff,#7a3fc9)"; ringCol = "rgba(184,138,255,0.55)"
                else                         label = "⭐ ";    barCol = "linear-gradient(90deg,#d4a574,#8b6e2f)"; ringCol = "rgba(212,165,116,0.5)"
                end
                -- #329 화이트/블루 톤 (몬스터 등급별 색상은 의미 유지)
                local dead = hpN <= 0
                local nameStyle = dead and "color:#94a3b8;text-decoration:line-through;" or "color:#1e4d8b;"
                bars[#bars+1] = string.format(
                    '<div style="margin:4px 0;padding:6px 10px;background:#ffffff;border:1px solid %s;border-radius:8px;box-shadow:0 2px 6px rgba(45,108,176,0.08);"><div style="display:flex;align-items:center;justify-content:space-between;font-size:0.78em;%s margin-bottom:4px;"><span style="font-weight:700;">%s%s</span><span style="font-family:monospace;font-size:0.92em;color:#5a7b9a;opacity:0.85;">%d / %d</span></div><div style="position:relative;height:10px;background:rgba(45,108,176,0.08);border-radius:5px;overflow:hidden;border:1px solid rgba(45,108,176,0.15);"><div style="position:absolute;top:0;left:0;height:100%%;width:%d%%;background:%s;transition:width 0.5s cubic-bezier(0.25,0.46,0.45,0.94);box-shadow:0 0 8px %s;"></div></div></div>',
                    ringCol, nameStyle, label, name, hpN, maxN, pct, barCol, ringCol
                )
            end
        end
    end
    if #bars == 0 then
        setChatVar(triggerId, "cv_monsterPanel", "")
        return
    end
    local panel = string.format(
        '<div style="margin:6px auto;max-width:680px;padding:10px 12px;border-radius:12px;background:rgba(245,251,255,0.97);border:1.5px solid rgba(45,108,176,0.45);box-shadow:0 4px 20px rgba(45,108,176,0.12),0 0 15px rgba(45,108,176,0.08);"><div style="font-size:0.76em;font-weight:700;color:#2d6cb0;letter-spacing:0.4px;margin-bottom:6px;text-shadow:0 0 8px rgba(45,108,176,0.2);">⚔ 조우 몬스터</div>%s</div>',
        table.concat(bars, "")
    )
    setChatVar(triggerId, "cv_monsterPanel", panel)
end

-- 몬스터에 데미지 적용 (AI가 [SYSTEM|MONSTER_HP:-N 이름] 출력 시 호출)
-- HP 0 도달 → 사망 + 자동 POINT 부여 + entry 제거 (#304에서 변경: 사라짐)
-- 마지막 몬스터 처치 시 cv_currentMonsters="" + 패널 자동 클리어
-- Returns: (newHp, maxHp, killed, tier, pts) — #336 pts 추가 (NOTIFY 알림용)
local function applyMonsterDamage(triggerId, targetName, damage)
    local mStr = safeGetVar(triggerId, "cv_currentMonsters", "")
    if mStr == "" then return nil, nil, false, nil, nil end
    local floor = tonumber(safeGetVar(triggerId, "cv_currentFloor", "1")) or 1
    local mult  = floorMultiplier(floor)
    -- #438 robust name match: LLM 출력 변형 정규화 — 처치 후 POINT 0 증가 회귀 차단
    --   1. trailing "(N/M)" HP 마커 strip (예: "유압 집행자 (0/280)" → "유압 집행자")
    --   2. leading "[B]/[E]/[N]" tier 힌트 strip (정규식 누락 케이스 보호)
    --   3. trim whitespace
    local rawTargetName = targetName
    if targetName then
        targetName = targetName:gsub("%s*%(%d+/%d+%)%s*$", "")  -- trailing (N/M)
        targetName = targetName:gsub("^%[%a+%]%s*", "")          -- leading [B]/[E]/[N]
        targetName = targetName:match("^%s*(.-)%s*$") or targetName
    end
    local entries = {}
    for entry in mStr:gmatch("([^;][^;]*)") do
        if entry ~= "" and entry ~= ";" then entries[#entries+1] = entry end
    end
    local hitIdx, retNewHp, retMaxHp, retKilled, retTier, retPts = nil, nil, nil, false, nil, nil
    for i, entry in ipairs(entries) do
        local tier, hp, maxHp, name = entry:match("([^|]+)|([^|]+)|([^|]+)|(.+)")
        if tier and name and (name == targetName or name:find(targetName, 1, true) or targetName:find(name, 1, true)) then
            local hpN  = tonumber(hp) or 0
            local maxN = tonumber(maxHp) or 1
            local newHp = math.max(0, hpN - damage)
            entries[i] = string.format("%s|%d|%d|%s", tier, newHp, maxN, name)
            print(string.format("[GachaIsland] MONSTER_HP: %s (%s) %d → %d / %d", name, tier, hpN, newHp, maxN))
            retNewHp, retMaxHp, retTier = newHp, maxN, tier
            if newHp == 0 and hpN > 0 then
                -- 사망 → 자동 POINT (entry [0] baseline × floor multiplier, 결전형 ×2.0 stack은 보스만)
                local base = MONSTER_BASELINE[tier] or MONSTER_BASELINE.normal
                local pts = math.ceil(base.point * mult)
                local dType = safeGetVar(triggerId, "cv_activeDungeonType", "None")
                if tier == "boss" and dType == "결전형" then pts = pts * 2 end
                -- #332 fix: gsub은 (string, count) 2값 반환 → tonumber에 count(0)가 base로 전달 → Lua 5.4 "base out of range" 에러.
                -- 외부 괄호 한 겹 더 감싸 첫 값만 전달.
                local ptsClean = (safeGetVar(triggerId, "cv_points", "0")):gsub(",", "")
                local curPts = tonumber(ptsClean) or 0
                local newPts = curPts + pts
                -- 천 단위 콤마 포맷
                local fmt = tostring(newPts):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
                setChatVar(triggerId, "cv_points", fmt)
                print(string.format("[GachaIsland] MONSTER_KILL: %s (%s) → +%dP (total %s)", name, tier, pts, fmt))
                retKilled = true
                retPts = pts
            end
            hitIdx = i
            break
        end
    end
    if hitIdx then
        -- #304: HP 0 도달 시 entry 제거 (사라짐 — 사용자 요구)
        if retKilled then
            table.remove(entries, hitIdx)
        end
        if #entries == 0 then
            setChatVar(triggerId, "cv_currentMonsters", "")
            setChatVar(triggerId, "cv_monsterPanel",    "")
            print("[GachaIsland] MONSTER_HP: 모든 몬스터 처치 → cv_currentMonsters + cv_monsterPanel 자동 클리어")
        else
            setChatVar(triggerId, "cv_currentMonsters", table.concat(entries, ";;"))
        end
        return retNewHp, retMaxHp, retKilled, retTier, retPts
    else
        -- #438 진단 강화: 등록된 monster 목록도 함께 로그 (name mismatch 디버깅용)
        local _names = {}
        for i, entry in ipairs(entries) do
            local _tier, _hp, _maxHp, _name = entry:match("([^|]+)|([^|]+)|([^|]+)|(.+)")
            if _name then _names[#_names+1] = string.format("[%s] %s (%s/%s)", _tier or "?", _name, _hp or "?", _maxHp or "?") end
        end
        print(string.format("[GachaIsland] MONSTER_HP: target '%s' (raw='%s') not found. Registered: %s",
            targetName or "?", rawTargetName or "?", table.concat(_names, " / ")))
        return nil, nil, false, nil, nil
    end
end

-- #497 hunger=0 시 매 onOutput 마다 HP -5 자동 차감 (system-wide — 던전/섬 무관).
--   기존 #477: 던전 안 advanceRound 시점에만 차감 (cv_dungeonActive 가드). 섬에서는 NEW_DAY 시점에만.
--   결정: 단순화 — 매 응답 1회 hunger=0 + cv_hp>0 이면 HP -5 차감. 위치 무관.
--   GAME OVER / DEFEAT 트리거는 별도 — cv_hp==0 도달해도 자동 발동 안 함. LLM 또는 사용자 처리.
local function _applyStarvationHpPerResponse(triggerId)
    local curHunger = tonumber(safeGetVar(triggerId, "cv_hunger", "100")) or 100
    if curHunger > 0 then return end
    local curHp = tonumber(safeGetVar(triggerId, "cv_hp", "100")) or 100
    if curHp <= 0 then return end
    local newHp = math.max(0, curHp - 5)
    setChatVar(triggerId, "cv_hp", tostring(newHp))
    print(string.format("[GachaIsland] HUNGER_STARVATION (#497): hunger=0 → HP %d → %d (-5, per response)", curHp, newHp))
end

-- 라운드 advance: AI가 [SYSTEM|ROUND_CLEAR] 출력 시 cv_currentRound +1
-- 마지막 라운드 도달 시 자동 멈춤 (층 클리어 처리는 별도 [SYSTEM|FLOOR:N] 태그가 담당)
-- 다음 라운드의 몬스터 자동 스폰
-- #308 미로형 분기: 무한 라운드 + cv_mazeEscapeCount 카운트 시스템
local function advanceRound(triggerId)
    local cur   = tonumber(safeGetVar(triggerId, "cv_currentRound", "0")) or 0
    local total = tonumber(safeGetVar(triggerId, "cv_totalRounds",  "0")) or 0
    local dType = safeGetVar(triggerId, "cv_activeDungeonType", "None")

    -- #308 미로형 무한 라운드 분기
    if dType == "미로형" then
        -- #431 X 라운드 도달 후 또 advance 호출 차단 (무한 X 추가 위험 방지)
        local _evStr = safeGetVar(triggerId, "cv_roundEvents", "")
        local _events = {}
        for e in _evStr:gmatch("([^|]+)") do _events[#_events+1] = e end
        local _curEv = _events[cur] or ""
        if _curEv == "X" then
            print(string.format("[GachaIsland] MAZE_ADVANCE BLOCKED (#431): round %d ev=X 이미 출구 도달 — 또 advance 차단 (END SEQUENCE 출력만 허용)", cur))
            return
        end

        local result = safeGetVar(triggerId, "cv_combatResult", "보통")
        local count = tonumber(safeGetVar(triggerId, "cv_mazeEscapeCount", "0")) or 0
        local failStreak = tonumber(safeGetVar(triggerId, "cv_mazeFailStreak", "0")) or 0
        -- 성공 굴림 = 카운트 +1 (대성공/성공만) + failStreak reset
        -- 보통/실패/대실패 = 마나/허기 narrate + failStreak +1 (#436 anti-stall — 다음 라운드 +5%/stack)
        if result == "대성공" or result == "성공" then
            count = count + 1
            setChatVar(triggerId, "cv_mazeEscapeCount", tostring(count))
            setChatVar(triggerId, "cv_mazeFailStreak", "0")  -- #436 reset
            print(string.format("[GachaIsland] MAZE_COUNT: +1 (result=%s) → %d/3, failStreak reset", result, count))
        else
            failStreak = failStreak + 1
            setChatVar(triggerId, "cv_mazeFailStreak", tostring(failStreak))
            print(string.format("[GachaIsland] MAZE_COUNT: 유지 %d/3 (result=%s — 마나/허기 narrate, failStreak=%d → next rate +%d%%)", count, result, failStreak, failStreak * 5))
        end

        -- cv_currentRound + cv_roundEvents 동적 추가
        local newCur = cur + 1
        local evStr = safeGetVar(triggerId, "cv_roundEvents", "")

        -- 카운트 3 도달 → 다음 라운드를 X (출구)로 강제
        if count >= 3 then
            evStr = (evStr == "") and "X" or (evStr .. "|X")
            setChatVar(triggerId, "cv_roundEvents",  evStr)
            setChatVar(triggerId, "cv_currentRound", tostring(newCur))
            setChatVar(triggerId, "cv_totalRounds",  tostring(newCur))  -- 표시용
            -- #495: 미로 X = 비전투 출구. pendingSpawn flag 끄기 (set=1 이면 #454 가드가 FLOOR_END_AUTO 차단)
            setChatVar(triggerId, "cv_pendingMonsterSpawn", "0")
            print(string.format("[GachaIsland] MAZE_ESCAPE: 카운트 3 도달 → 라운드 %d X (출구) 자동 진입", newCur))

            -- 미로형 탈출 보너스 POINT: 진행한 라운드 × 500P × floor multiplier
            local _floor = tonumber(safeGetVar(triggerId, "cv_currentFloor", "0")) or 0
            local _mult = floorMultiplier(_floor)
            local _bonus = math.ceil(newCur * 500 * _mult)
            local _ptsClean = (safeGetVar(triggerId, "cv_points", "0")):gsub(",", "")
            local _curPts = tonumber(_ptsClean) or 0
            local _newPts = _curPts + _bonus
            local _fmt = tostring(_newPts):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
            setChatVar(triggerId, "cv_points", _fmt)
            print(string.format("[GachaIsland] MAZE_ESCAPE_BONUS (#417): %d rounds × 500P × m=%.2f → +%dP (total %s)", newCur, _mult, _bonus, _fmt))

            -- 메시지에 NOTIFY 카드 append (사용자 가시성)
            local _lastIdx = getChatLength(triggerId) - 1
            local _msg = getChat(triggerId, _lastIdx)
            if _msg and _msg.data then
                local _notify = string.format("\n[SYSTEM|NOTIFY:🗝 미로 탈출 보너스 +%dP (%d 라운드 탐험)]", _bonus, newCur)
                setChat(triggerId, _lastIdx, _msg.data .. _notify)
            end

            -- #497: starvation HP 차감은 onOutput 마다 1회로 통합 (호출 제거)
            return
        end

        -- #436: 카운트 미달 → 다음 라운드 E (탐색) 고정. M/T/I 모두 제거.
        evStr = (evStr == "") and "E" or (evStr .. "|E")
        setChatVar(triggerId, "cv_roundEvents", evStr)
        setChatVar(triggerId, "cv_currentRound", tostring(newCur))
        -- spawn 보류 (E는 비전투지만 일관성 위해 flag set — spawnMonstersForRound가 E + 미로형 = cv_currentMonsters="" 처리)
        setChatVar(triggerId, "cv_pendingMonsterSpawn", "1")
        print(string.format("[GachaIsland] MAZE_ADVANCE (#436): round %d → %d, ev=E (exploration-only), escape=%d/3, failStreak=%d", cur, newCur, count, failStreak))
        -- #497: starvation HP 차감은 onOutput 마다 1회로 통합 (호출 제거)
        return
    end

    -- 일반 던전 (탐색/토벌/결전/방어): 기존 로직
    if total <= 0 then return end
    if cur >= total then
        print(string.format("[GachaIsland] ROUND_ADVANCE: 마지막 라운드 (%d/%d), advance 안 함", cur, total))
        return
    end
    local newCur = cur + 1
    setChatVar(triggerId, "cv_currentRound", tostring(newCur))
    print(string.format("[GachaIsland] ROUND_ADVANCE: %d → %d (of %d) (spawn deferred)", cur, newCur, total))
    -- #383: 새 라운드 몬스터 spawn 보류 → 다음 editRequest hook 시 처리
    -- (LLM이 같은 응답에서 다음 라운드 narrate 시 placeholder "적/적 2" 노출 차단)
    setChatVar(triggerId, "cv_pendingMonsterSpawn", "1")
    -- #497: starvation HP 차감은 onOutput 마다 1회로 통합 (호출 제거)
end

function dungeonReturn(triggerId)
    forceCloseDungeon(triggerId)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    -- #433: #431 후 [SYSTEM|DUNGEON_EXIT] 자연 처리 폐기로 SAVE 갱신 fallback 사라짐.
    -- forceCloseDungeon이 메모리상 cv_dungeonActive=0 등 reset해도 다음 onOutput의 SAVE_LOAD가
    -- 직전 AI msg SAVE (cv_dungeonActive=1)로 되돌려서 던전 활성 상태 잔존. 직전 AI msg SAVE를 갱신.
    appendSaveToCurrentMessage(triggerId)
    addChat(triggerId, "user", "🏠 성소로 귀환한다.")
end

-- 던전 층 셋업 공통 로직 (dungeonNextFloor + mapEnterDungeon 공용)
-- floor +1, 컨디션 pre-roll, 타입 추첨 (2-back exclusion), 라운드 시퀀스, 첫 라운드 몬스터, 패널 빌드, SAVE 갱신
-- Returns: pickedDType (호출자가 [DUNGEON_TYPE:X] 태그에 사용)
-- Global function — mapEnterDungeon(L413)이 forward-call하므로 local 불가
function _dungeonFloorSetup(triggerId)
    -- 층 +1
    local cur = tonumber(safeGetVar(triggerId, "cv_currentFloor", "0")) or 0
    local nextFloor = cur + 1
    setChatVar(triggerId, "cv_currentFloor", tostring(nextFloor))

    -- 새 floor → 성역 출현 카운터 리셋 (floor당 1회만 허용)
    setChatVar(triggerId, "cv_sanctuarySpawnedFloor", "0")
    setChatVar(triggerId, "cv_sanctuarySpawnedMsg",   "-1")  -- #452
    setChatVar(triggerId, "cv_sanctuaryConsumed",     "0")   -- #452

    -- 층 컨디션 pre-roll — onInput이 버튼 클릭에는 발동 안 하므로 여기서 직접 처리
    refreshSeed(triggerId)
    local nextCond, condRoll = rollFloorCondition()
    setChatVar(triggerId, "cv_nextFloorCondition",   nextCond)
    setChatVar(triggerId, "cv_activeFloorCondition", nextCond)
    print(string.format("[GachaIsland] FLOOR_CONDITION_PREROLL: %d/100 → %s", condRoll, nextCond))

    -- 던전 type 추첨 — 2-back exclusion (직전 + 직직전 회피)
    refreshSeed(triggerId)
    local dungeonTypes = { "탐색형", "토벌형", "미로형", "결전형" }
    local last = safeGetVar(triggerId, "cv_lastDungeonType", "None")
    local prev = safeGetVar(triggerId, "cv_prevDungeonType", "None")
    local dPool = {}
    for _, t in ipairs(dungeonTypes) do
        if t ~= last and t ~= prev then table.insert(dPool, t) end
    end
    -- 안전판: 풀이 빈 경우 (4종 - 2 exclude = 2 보장이라 발생 안 함) 전체 풀 사용
    if #dPool == 0 then
        for _, t in ipairs(dungeonTypes) do table.insert(dPool, t) end
    end
    -- Fisher-Yates shuffle
    for i = #dPool, 2, -1 do
        local j = math.random(i)
        dPool[i], dPool[j] = dPool[j], dPool[i]
    end
    local pickedDType = dPool[math.random(#dPool)]

    setChatVar(triggerId, "cv_prevDungeonType",   last)
    setChatVar(triggerId, "cv_nextDungeonType",   pickedDType)
    setChatVar(triggerId, "cv_activeDungeonType", pickedDType)
    setChatVar(triggerId, "cv_lastDungeonType",   pickedDType)

    print(string.format("[GachaIsland] _dungeonFloorSetup: floor %d→%d, type=%s (avoid: last=%s, prev=%s)",
        cur, nextFloor, pickedDType, last, prev))

    -- 라운드 시스템: 라운드 시퀀스 + 첫 라운드 몬스터 + 패널
    rollRoundsForFloor(triggerId, pickedDType)
    spawnMonstersForRound(triggerId)
    buildRoundPanel(triggerId)
    buildMonsterPanel(triggerId)
    -- #455: 첫 라운드 spawn 이미 직접 완료 → pendingSpawn flag clear (옛 carry-over 차단)
    setChatVar(triggerId, "cv_pendingMonsterSpawn", "0")

    -- #305: 직전 봇 응답의 SAVE를 갱신
    appendSaveToCurrentMessage(triggerId)

    return pickedDType
end

function dungeonNextFloor(triggerId)
    -- 가드: 던전 진행 중이 아니면 무시 (DUNGEON_CHOICE 잘못 출력 / 부적절한 클릭 차단)
    local active = safeGetVar(triggerId, "cv_dungeonActive", "0")
    if active ~= "1" then
        -- #469: silent skip 대신 사용자 alert — 무반응 원인 명확히 표시
        local gate = safeGetVar(triggerId, "cv_dungeonGateState", "?")
        alertError(triggerId, string.format("다음 층 진입 불가:\n던전이 비활성 상태입니다.\n\ncv_dungeonActive=%s, cv_dungeonGateState=%s\n\n던전 외부에서 클릭되었거나 던전이 이미 종료된 상태입니다.", active, gate))
        print("[GachaIsland] dungeonNextFloor SKIPPED: 던전 진행 중 아님 (cv_dungeonActive=" .. active .. ", cv_dungeonGateState=" .. gate .. ")")
        return
    end

    local pickedDType = _dungeonFloorSetup(triggerId)

    -- [DUNGEON_TYPE:...] 태그로 user msg에 강제 부착 → AI는 verbatim 사용 (GACHA_PICK 패턴)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    addChat(triggerId, "user", "⬇ 다음 층으로 진입한다.[DUNGEON_TYPE:" .. pickedDType .. "]")
end

function sanctuaryReturn(triggerId)
    forceCloseDungeon(triggerId)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    appendSaveToCurrentMessage(triggerId)  -- #433 동일 이유 (dungeonReturn 참조)
    addChat(triggerId, "user", "🏠 던전을 빠져나가 성소로 귀환한다.")
end

function sanctuaryRecharge(triggerId)
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    -- #452: user 가 충전 클릭 → consume flag set. 이후 같은 floor 에서 [SANCTUARY_CHOICE] 재출력 시 strip.
    setChatVar(triggerId, "cv_sanctuaryConsumed", "1")
    -- consumed=1 을 마지막 char msg seed 에 박아둠. 안 그러면 다음 SAVE_LOAD 가 직전 char msg 의 옛 seed (consumed=0) 로 덮어써 #506 가드가 SKIP → 라운드 advance 차단.
    appendSaveToCurrentMessage(triggerId)
    addChat(triggerId, "user", "💎 던전 내 성역에서 마나를 충전한다.")
end


-- =============================================================================
-- #353 EQUIP SYSTEM HELPERS
-- 스킬/유물 장착 시스템 + stat 분리 저장 + 동적 재계산.
-- onOutput / onButtonClick 양쪽에서 사용하므로 모듈 레벨에 정의.
-- cv_*Details entry 5-field 확장: "name||desc||tier||effect||stat"
--   stat = "ATK:N,DEF:N,LUCK:N,MAXHP:N,MAXMANA:N,MAXHUNGER:N,SLOT:N" (0인 키는 생략 가능)
-- =============================================================================

local EQUIP_STAT_KEYS = {"ATK","DEF","LUCK","MAXHP","MAXMANA","MAXHUNGER","SLOT"}

-- ";;" split. detailsStr이 비어있거나 None이면 빈 테이블.
local function eqSplitEntries(detailsStr)
    local out = {}
    if not detailsStr or detailsStr == "None" or detailsStr == "" or detailsStr == "null" then
        return out
    end
    local pos = 1
    while pos <= #detailsStr do
        local s, e = detailsStr:find(";;", pos, true)
        if s then
            table.insert(out, detailsStr:sub(pos, s - 1))
            pos = e + 1
        else
            table.insert(out, detailsStr:sub(pos))
            break
        end
    end
    return out
end

-- entry "name||desc||tier||effect||stat" → 5 returns (모두 string 또는 nil)
local function eqParseEntry(entry)
    if not entry or entry == "" then return nil, nil, "1", nil, nil end
    local parts = {}
    local pos = 1
    while pos <= #entry do
        local s, e = entry:find("||", pos, true)
        if s then
            table.insert(parts, entry:sub(pos, s - 1))
            pos = e + 1
        else
            table.insert(parts, entry:sub(pos))
            break
        end
    end
    local name   = parts[1]
    local desc   = parts[2]
    local tier   = parts[3] or "1"
    local effect = parts[4]
    local stat   = parts[5]
    if effect == "" then effect = nil end
    if stat   == "" then stat   = nil end
    return name, desc, tier, effect, stat
end

-- " xN" suffix 제거 (스택 아이템 호환)
local function eqExtractBase(rawName)
    if not rawName then return "" end
    local base = rawName:match("^(.-)%s+x%d+$") or rawName
    return base:match("^%s*(.-)%s*$") or base
end

-- stat string "ATK:5,DEF:3,..." → table {ATK=5,DEF=3,...}. nil/빈문자열 → 빈 table.
local function eqStatParse(statStr)
    local t = {ATK=0, DEF=0, LUCK=0, MAXHP=0, MAXMANA=0, MAXHUNGER=0, SLOT=0}
    if not statStr or statStr == "" or statStr == "null" then return t end
    for k, v in statStr:gmatch("([A-Z]+):(%-?%d+)") do
        t[k] = tonumber(v) or 0
    end
    return t
end

-- stat table → string "ATK:5,DEF:3,..." (0인 키 생략). 모두 0이면 빈 문자열.
local function eqStatSerialize(t)
    if not t then return "" end
    local parts = {}
    for _, k in ipairs(EQUIP_STAT_KEYS) do
        local v = t[k] or 0
        if v ~= 0 then
            table.insert(parts, k .. ":" .. tostring(v))
        end
    end
    return table.concat(parts, ",")
end

-- EFFECT 텍스트에서 stat 추출 (마이그레이션용). "ATK +5", "DEF +10", "LUCK +5", "MAX HP +25" 등
local function eqStatExtractFromEffect(effect)
    local t = {ATK=0, DEF=0, LUCK=0, MAXHP=0, MAXMANA=0, MAXHUNGER=0, SLOT=0}
    if not effect or effect == "" then return t end
    local txt = effect
    -- 한글/영문 다양한 표기 정규화: "ATK +5" / "공격력 +5" / "공격 +5"
    for v in txt:gmatch("ATK%s*([%+%-]?%s*%d+)") do t.ATK = t.ATK + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("공격력?%s*([%+%-]?%s*%d+)") do t.ATK = t.ATK + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("DEF%s*([%+%-]?%s*%d+)") do t.DEF = t.DEF + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("방어력?%s*([%+%-]?%s*%d+)") do t.DEF = t.DEF + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("LUCK%s*([%+%-]?%s*%d+)") do t.LUCK = t.LUCK + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("행운%s*([%+%-]?%s*%d+)") do t.LUCK = t.LUCK + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("MAX%s*HP%s*([%+%-]?%s*%d+)") do t.MAXHP = t.MAXHP + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*HP%s*([%+%-]?%s*%d+)") do t.MAXHP = t.MAXHP + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*체력%s*([%+%-]?%s*%d+)") do t.MAXHP = t.MAXHP + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("MAX%s*MANA%s*([%+%-]?%s*%d+)") do t.MAXMANA = t.MAXMANA + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*MANA%s*([%+%-]?%s*%d+)") do t.MAXMANA = t.MAXMANA + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*마나%s*([%+%-]?%s*%d+)") do t.MAXMANA = t.MAXMANA + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("MAX%s*HUNGER%s*([%+%-]?%s*%d+)") do t.MAXHUNGER = t.MAXHUNGER + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*HUNGER%s*([%+%-]?%s*%d+)") do t.MAXHUNGER = t.MAXHUNGER + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("최대%s*허기%s*([%+%-]?%s*%d+)") do t.MAXHUNGER = t.MAXHUNGER + (tonumber((v:gsub("%s+",""))) or 0) end
    -- 슬롯 +1 (시설용)
    for v in txt:gmatch("장착%s*슬롯%s*([%+%-]?%s*%d+)") do t.SLOT = t.SLOT + (tonumber((v:gsub("%s+",""))) or 0) end
    for v in txt:gmatch("SLOT%s*([%+%-]?%s*%d+)") do t.SLOT = t.SLOT + (tonumber((v:gsub("%s+",""))) or 0) end
    return t
end

-- detailsStr에서 targetName entry의 stat table 반환 (없으면 nil)
-- #373 Bug 3 후속: 5번째 stat 필드 없으면 (legacy / GACHA_STAT_ABSORB 직전 항목만 처리해 누락된 옛 항목)
-- 4번째 EFFECT 텍스트에서 자동 추출 (ATK +18, LUCK +7 등) → 장착 시 능력치 정상 반영
local function eqGetEntryStat(detailsStr, targetName)
    for _, entry in ipairs(eqSplitEntries(detailsStr)) do
        local n, _, _, eff, statStr = eqParseEntry(entry)
        if n and eqExtractBase(n) == targetName then
            if statStr and statStr ~= "" and statStr ~= "null" then
                return eqStatParse(statStr)
            elseif eff and eff ~= "" then
                -- fallback: EFFECT 텍스트에서 stat 추출
                return eqStatExtractFromEffect(eff)
            end
            return eqStatParse(nil)  -- 모두 비어있으면 0
        end
    end
    return nil
end

-- 콤마 구분 list에 name 존재? (whitespace trim)
local function eqInList(listStr, targetName)
    if not listStr or listStr == "None" or listStr == "" or listStr == "null" then return false end
    for entry in listStr:gmatch("([^,]+)") do
        entry = entry:match("^%s*(.-)%s*$")
        if entry == targetName then return true end
    end
    return false
end

-- 콤마 구분 list의 entry 개수
local function eqCountList(listStr)
    if not listStr or listStr == "None" or listStr == "" or listStr == "null" then return 0 end
    local n = 0
    for _ in listStr:gmatch("([^,]+)") do n = n + 1 end
    return n
end

-- 콤마 구분 list에 name 추가 (중복 방지)
local function eqAddToList(listStr, targetName)
    if eqInList(listStr, targetName) then return listStr end
    if not listStr or listStr == "None" or listStr == "" or listStr == "null" then
        return targetName
    end
    return listStr .. ", " .. targetName
end

-- 콤마 구분 list에서 name 제거
local function eqRemoveFromList(listStr, targetName)
    if not listStr or listStr == "None" or listStr == "" or listStr == "null" then return "None" end
    local kept = {}
    for entry in listStr:gmatch("([^,]+)") do
        local e = entry:match("^%s*(.-)%s*$")
        if e ~= targetName then table.insert(kept, e) end
    end
    if #kept == 0 then return "None" end
    return table.concat(kept, ", ")
end

-- detailsStr에서 특정 name entry의 stat 필드를 statTable로 갱신 (entry 자체 in-place 수정)
-- 기존 5필드 없으면 추가, 있으면 교체. detailsStr 새 문자열 반환.
local function eqUpdateEntryStat(detailsStr, targetName, statTable)
    local entries = eqSplitEntries(detailsStr)
    local changed = false
    for i, entry in ipairs(entries) do
        local n, d, t, eff = eqParseEntry(entry)
        if n and eqExtractBase(n) == targetName then
            local statStr = eqStatSerialize(statTable)
            local newEntry = (n or "") .. "||" .. (d or "") .. "||" .. (t or "1") .. "||" .. (eff or "") .. "||" .. statStr
            entries[i] = newEntry
            changed = true
            break
        end
    end
    if not changed then return detailsStr end
    if #entries == 0 then return "None" end
    return table.concat(entries, ";;")
end

-- 장착된 스킬+유물의 stat 합산 → cv_attack/defense/luck/maxHp/maxMana/maxHunger 갱신
-- 시설 stat은 슬롯 한도 계산에만 사용 (별도 함수 eqRecalcSlots).
local function eqRecalcStats(triggerId)
    local atkBase = tonumber(safeGetVar(triggerId, "cv_attack_base",  "5"))   or 5
    local defBase = tonumber(safeGetVar(triggerId, "cv_defense_base", "5"))   or 5
    local lckBase = tonumber(safeGetVar(triggerId, "cv_luck_base",    "0"))   or 0
    local hpBase  = tonumber(safeGetVar(triggerId, "cv_maxHp_base",   "100")) or 100
    local mnBase  = tonumber(safeGetVar(triggerId, "cv_maxMana_base", "100")) or 100
    local hgBase  = tonumber(safeGetVar(triggerId, "cv_maxHunger_base","100")) or 100

    local atk, def, lck, mhp, mmn, mhg = atkBase, defBase, lckBase, hpBase, mnBase, hgBase

    local skillDetails = safeGetVar(triggerId, "cv_skillDetails", "None")
    local relicDetails = safeGetVar(triggerId, "cv_relicDetails", "None")
    local equippedSk   = safeGetVar(triggerId, "cv_equippedSkills", "None")
    local equippedRl   = safeGetVar(triggerId, "cv_equippedRelics", "None")

    if equippedSk ~= "None" and equippedSk ~= "" and equippedSk ~= "null" then
        for n in equippedSk:gmatch("([^,]+)") do
            n = n:match("^%s*(.-)%s*$")
            local s = eqGetEntryStat(skillDetails, n)
            if s then
                atk = atk + s.ATK;       def = def + s.DEF;       lck = lck + s.LUCK
                mhp = mhp + s.MAXHP;     mmn = mmn + s.MAXMANA;   mhg = mhg + s.MAXHUNGER
            end
        end
    end
    if equippedRl ~= "None" and equippedRl ~= "" and equippedRl ~= "null" then
        for n in equippedRl:gmatch("([^,]+)") do
            n = n:match("^%s*(.-)%s*$")
            local s = eqGetEntryStat(relicDetails, n)
            if s then
                atk = atk + s.ATK;       def = def + s.DEF;       lck = lck + s.LUCK
                mhp = mhp + s.MAXHP;     mmn = mmn + s.MAXMANA;   mhg = mhg + s.MAXHUNGER
            end
        end
    end

    -- #483 시설 stat 자동 합산 (보유 = 발동, 장착 개념 없음)
    --   기존: eqRecalcSlots 가 시설의 SLOT 필드만 처리. ATK/DEF/LUCK/MAXHP/MAXMANA/MAXHUNGER 는 합산 누락.
    --   #353 EQUIP SYSTEM 도입 시 스킬/유물 장착 합산만 작성, 시설 (장착 X) 은 깜빡함. 사용자 보고로 fix.
    --   시설은 모든 entry 의 stat 누적 합산. EFFECT 폴백 (#373) 도 지원.
    local facDetails = safeGetVar(triggerId, "cv_facilityDetails", "None")
    if facDetails ~= "None" and facDetails ~= "" and facDetails ~= "null" then
        for _, entry in ipairs(eqSplitEntries(facDetails)) do
            local n, _, _, eff, statStr = eqParseEntry(entry)
            if n then
                local s
                if statStr and statStr ~= "" and statStr ~= "null" then
                    s = eqStatParse(statStr)
                elseif eff and eff ~= "" then
                    s = eqStatExtractFromEffect(eff)
                end
                if s then
                    atk = atk + (s.ATK or 0);       def = def + (s.DEF or 0);       lck = lck + (s.LUCK or 0)
                    mhp = mhp + (s.MAXHP or 0);     mmn = mmn + (s.MAXMANA or 0);   mhg = mhg + (s.MAXHUNGER or 0)
                    -- SLOT 은 eqRecalcSlots 가 별도 처리 — 여기선 합산 안 함 (중복 방지)
                end
            end
        end
    end

    -- 음수 방어 (base 자체가 0 이하인 경우 가챠 stat이 음수 효과면 0으로)
    if atk < 0 then atk = 0 end
    if def < 0 then def = 0 end
    if lck < 0 then lck = 0 end
    if mhp < 1 then mhp = 1 end
    if mmn < 1 then mmn = 1 end
    if mhg < 1 then mhg = 1 end

    smartSetChatVar(triggerId, "cv_attack",    tostring(atk))
    smartSetChatVar(triggerId, "cv_defense",   tostring(def))
    smartSetChatVar(triggerId, "cv_luck",      tostring(lck))
    smartSetChatVar(triggerId, "cv_maxHp",     tostring(mhp))
    smartSetChatVar(triggerId, "cv_maxMana",   tostring(mmn))
    smartSetChatVar(triggerId, "cv_maxHunger", tostring(mhg))

    -- 현재 HP/MANA/HUNGER가 새 최대치 초과 시 clamp
    local curHp = tonumber(safeGetVar(triggerId, "cv_hp",     "100")) or 100
    local curMn = tonumber(safeGetVar(triggerId, "cv_mana",   "100")) or 100
    local curHg = tonumber(safeGetVar(triggerId, "cv_hunger", "100")) or 100
    if curHp > mhp then setChatVar(triggerId, "cv_hp",     tostring(mhp)) end
    if curMn > mmn then setChatVar(triggerId, "cv_mana",   tostring(mmn)) end
    if curHg > mhg then setChatVar(triggerId, "cv_hunger", tostring(mhg)) end

    print(string.format("[GachaIsland] EQUIP_RECALC: ATK=%d DEF=%d LUCK=%d MAXHP=%d MAXMANA=%d MAXHUNGER=%d (base %d/%d/%d/%d/%d/%d)",
        atk, def, lck, mhp, mmn, mhg, atkBase, defBase, lckBase, hpBase, mnBase, hgBase))
end

-- 모든 시설 stat의 SLOT 필드 합산 → cv_maxSkillSlots / cv_maxRelicSlots 갱신 (시설은 장착 개념 없으니 전부 합산).
-- 기본 3에 합산. 사용자 요청: 5★+ 시설의 SLOT+1 효과는 무제한 중첩 (장착 시스템 외부).
local function eqRecalcSlots(triggerId)
    local facDetails = safeGetVar(triggerId, "cv_facilityDetails", "None")
    local bonus = 0
    for _, entry in ipairs(eqSplitEntries(facDetails)) do
        local _, _, _, _, statStr = eqParseEntry(entry)
        if statStr and statStr ~= "" then
            local s = eqStatParse(statStr)
            bonus = bonus + (s.SLOT or 0)
        end
    end
    local newMax = 3 + bonus
    if newMax < 3 then newMax = 3 end
    setChatVar(triggerId, "cv_maxSkillSlots", tostring(newMax))
    setChatVar(triggerId, "cv_maxRelicSlots", tostring(newMax))
end

-- 장착 함수. kind = "skill" or "relic". 성공 시 true, 실패 시 false + reason 문자열.
local function eqEquip(triggerId, kind, name)
    local listKey, maxKey, ownedKey, detailKey
    if kind == "skill" then
        listKey, maxKey, ownedKey, detailKey = "cv_equippedSkills", "cv_maxSkillSlots", "cv_skills", "cv_skillDetails"
    elseif kind == "relic" then
        listKey, maxKey, ownedKey, detailKey = "cv_equippedRelics", "cv_maxRelicSlots", "cv_relics", "cv_relicDetails"
    else
        return false, "unknown kind"
    end
    local owned = safeGetVar(triggerId, ownedKey, "None")
    if not eqInList(owned, name) then
        -- detail에는 있을 수 있음 (보유 list 동기화 누락)
        if not eqGetEntryStat(safeGetVar(triggerId, detailKey, "None"), name) then
            return false, "not owned"
        end
    end
    local cur = safeGetVar(triggerId, listKey, "None")
    if eqInList(cur, name) then return false, "already equipped" end
    local max = tonumber(safeGetVar(triggerId, maxKey, "3")) or 3
    if eqCountList(cur) >= max then return false, "slot full" end
    setChatVar(triggerId, listKey, eqAddToList(cur, name))
    eqRecalcStats(triggerId)
    print(string.format("[GachaIsland] EQUIP %s: %s (slots used %d/%d)", kind, name, eqCountList(safeGetVar(triggerId, listKey, "None")), max))
    return true
end

local function eqUnequip(triggerId, kind, name)
    local listKey
    if kind == "skill" then listKey = "cv_equippedSkills"
    elseif kind == "relic" then listKey = "cv_equippedRelics"
    else return false, "unknown kind" end
    local cur = safeGetVar(triggerId, listKey, "None")
    if not eqInList(cur, name) then return false, "not equipped" end
    setChatVar(triggerId, listKey, eqRemoveFromList(cur, name))
    eqRecalcStats(triggerId)
    print(string.format("[GachaIsland] UNEQUIP %s: %s", kind, name))
    return true
end

-- =============================================================================
-- INVENTORY HTML PRE-BUILD + 동적 equipToggle 함수
-- cv_skillInvHtml / cv_relicInvHtml = onOutput / equip 후 Lua 가 카드 HTML 빌드.
-- 버튼 트리거 = equipToggleSkill0..29 / equipToggleRelic0..29 (인덱스는 cv_*Details ;; 순서).
-- =============================================================================

-- HTML escape (& < > " ' 만 처리 — name/desc/effect 사용자 데이터 안전화)
local function htmlEscape(s)
    if not s or s == "" then return "" end
    s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&#39;")
    return s
end

local function buildInvHtml(triggerId)
    for _, kind in ipairs({"skill", "relic"}) do
        local CapKind = kind:sub(1,1):upper() .. kind:sub(2)
        local entries = parseForgeEntries(triggerId, kind)
        local listKey = (kind == "skill") and "cv_equippedSkills" or "cv_equippedRelics"
        local maxKey  = (kind == "skill") and "cv_maxSkillSlots" or "cv_maxRelicSlots"
        local labelKor = (kind == "skill") and "스킬" or "유물"

        local equippedSet = {}
        local equippedCount = 0
        local eq = safeGetVar(triggerId, listKey, "None")
        if eq ~= "None" and eq ~= "" and eq ~= "null" then
            for n in eq:gmatch("([^,]+)") do
                n = n:match("^%s*(.-)%s*$")
                if n ~= "" then
                    equippedSet[n] = true
                    equippedCount = equippedCount + 1
                end
            end
        end
        local maxSlots = safeGetVar(triggerId, maxKey, "3")

        local html
        if #entries == 0 then
            html = '<div class="gi-empty">아직 ' .. labelKor .. '이 없습니다</div>'
        else
            html = '<div class="inv-equip-header"><span class="inv-equip-label">⚙ 장착</span><span class="inv-equip-count">'
                .. equippedCount .. ' / ' .. maxSlots .. '</span></div><div class="gi-list">'
            for idx, entry in ipairs(entries) do
                if idx > 30 then break end
                local stars = string.rep("⭐", entry.tier)
                local isEquipped = equippedSet[entry.name] == true
                html = html .. '<div class="gi-card gi-card-' .. kind .. ' gi-card-tier-' .. entry.tier .. '">'
                html = html .. '<span class="gi-card-stars gi-card-stars-' .. entry.tier .. '">' .. stars .. '</span>'
                html = html .. '<div class="gi-card-name">' .. htmlEscape(entry.name) .. '</div>'
                html = html .. '<div class="gi-card-desc">' .. htmlEscape(entry.desc) .. '</div>'
                if entry.effect and entry.effect ~= "" then
                    html = html .. '<div class="gi-card-effect">' .. htmlEscape(entry.effect) .. '</div>'
                end
                html = html .. '<div class="gi-card-equip-row">'
                if isEquipped then
                    -- #475 ✅ → ⚔ : ✅ 는 regex [43] 「불릿 줄바꿈 강제」 패턴에 매칭되어
                    --                badge 앞에 <br> 가 강제 삽입되어 박스 상단 빈 공백 + 크기 어긋남 발생.
                    --                ⚔ 는 해당 패턴 미포함 → 줄바꿈 안 됨, 해제 버튼과 동일 라인 정상 배치.
                    html = html .. '<span class="gi-card-equipped-badge">⚔ 장착중</span>'
                    html = html .. '{{button::🔓 해제::equipToggle' .. CapKind .. (idx-1) .. '}}'
                else
                    html = html .. '{{button::🔒 장착::equipToggle' .. CapKind .. (idx-1) .. '}}'
                end
                html = html .. '</div></div>'
            end
            html = html .. '</div>'
        end
        setChatVar(triggerId, "cv_" .. kind .. "InvHtml", html)
    end
end

-- #373 (Bug 3 strict): AI 컨텍스트용 equipped-only details 빌드
-- cv_equippedSkillDetails / cv_equippedRelicDetails — 장착 중인 항목만 ;;-구분 details 문자열
-- 매 응답 onOutput + equipToggleByIdx + migration 직후 호출 (cv_*Details 변경 직후 반드시 호출)
local function buildEquippedDetails(triggerId)
    for _, kind in ipairs({"skill", "relic"}) do
        local listKey   = (kind == "skill") and "cv_equippedSkills"   or "cv_equippedRelics"
        local outKey    = (kind == "skill") and "cv_equippedSkillDetails" or "cv_equippedRelicDetails"
        local eq = safeGetVar(triggerId, listKey, "None")
        if eq == "None" or eq == "" or eq == "null" then
            setChatVar(triggerId, outKey, "None")
        else
            local equippedSet = {}
            for n in eq:gmatch("([^,]+)") do
                n = n:match("^%s*(.-)%s*$")
                if n ~= "" then equippedSet[n] = true end
            end
            local entries = parseForgeEntries(triggerId, kind)
            local kept = {}
            for _, e in ipairs(entries) do
                if equippedSet[e.name] then
                    kept[#kept+1] = e.raw
                end
            end
            setChatVar(triggerId, outKey, (#kept == 0) and "None" or table.concat(kept, ";;"))
        end
    end
end

-- equip 토글 (인덱스 기반)
local function equipToggleByIdx(triggerId, kind, idx)
    local entries = parseForgeEntries(triggerId, kind)
    if idx + 1 > #entries then return end
    local entry = entries[idx + 1]
    local name = entry.name
    local listKey = (kind == "skill") and "cv_equippedSkills" or "cv_equippedRelics"
    local cur = safeGetVar(triggerId, listKey, "None")
    if eqInList(cur, name) then
        local ok, reason = eqUnequip(triggerId, kind, name)
        if not ok then alertError(triggerId, "해제 실패: " .. (reason or "")) end
    else
        local ok, reason = eqEquip(triggerId, kind, name)
        if not ok then
            if reason == "slot full" then
                local maxKey = (kind == "skill") and "cv_maxSkillSlots" or "cv_maxRelicSlots"
                local maxV = safeGetVar(triggerId, maxKey, "3")
                alertError(triggerId, "장착 슬롯이 가득 찼습니다 (" .. maxV .. "/" .. maxV .. "). 먼저 다른 것을 해제하세요.")
            elseif reason == "not owned" then
                alertError(triggerId, "보유하지 않은 항목입니다.")
            else
                alertError(triggerId, "장착 실패: " .. (reason or ""))
            end
        end
    end
    -- 패널 / 탭 유지 위해 cv 명시 + HTML 재빌드
    setChatVar(triggerId, "cv_invOpen",     "1")
    setChatVar(triggerId, "cv_invCategory", kind)
    buildAllForgePickLists(triggerId)
    buildInvHtml(triggerId)
    buildEquippedDetails(triggerId)  -- #373 strict: AI 컨텍스트용 equipped-only details 갱신
    -- #377 후속 (얼헌 refreshScreen 패턴): appendSave 의 setChat 만으로 ONE 재렌더 충분.
    -- reloadDisplay 제거 → double-render 시 setvar 가 cv=0 으로 reset 되어 패널 닫히는 flicker 차단.
    appendSaveToCurrentMessage(triggerId)
end

-- 글로벌 함수 사전 정의: equipToggleSkill0..29 / equipToggleRelic0..29
for idx = 0, 29 do
    _G["equipToggleSkill" .. idx] = function(triggerId)
        equipToggleByIdx(triggerId, "skill", idx)
    end
    _G["equipToggleRelic" .. idx] = function(triggerId)
        equipToggleByIdx(triggerId, "relic", idx)
    end
end


-- =============================================================================
-- VARIABLE EDITOR (디버그) — 사이드 패널 가이드 카드
-- =============================================================================

local VAR_EDIT_UNITS = {
    cv_points  = {big = 100000, med = 10000, sml = 1000},
    cv_hp      = {big = 100,    med = 50,    sml = 10},
    cv_mana    = {big = 100,    med = 50,    sml = 10},
    cv_hunger  = {big = 100,    med = 50,    sml = 10},
    cv_attack  = {big = 100,    med = 50,    sml = 10},
    cv_defense = {big = 100,    med = 50,    sml = 10},
    cv_luck    = {big = 50,     med = 10,    sml = 1},
}

-- 라벨 안의 \n 은 CSS 의 white-space:pre-line 으로 줄바꿈 처리 (이모지 한 줄 / 텍스트 한 줄)
local VAR_EDIT_TARGET_LABEL = {
    cv_points  = "💰\nPOINTS",
    cv_hp      = "❤️\nHP",
    cv_mana    = "💎\nMANA",
    cv_hunger  = "🍖\nHUNGER",
    cv_attack  = "⚔\nATK",
    cv_defense = "🛡\nDEF",
    cv_luck    = "🍀\nLUCK",
}

local VAR_EDIT_TARGET_ORDER = {
    "cv_points", "cv_hp", "cv_mana", "cv_hunger", "cv_attack", "cv_defense", "cv_luck",
}

local function _varEditFormatPoints(n)
    local s = tostring(n):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    s = s:gsub("^,", "")
    return s
end

local function _varEditReadValue(triggerId, key)
    if key == "cv_points" then
        -- gsub multi-return 이 tonumber 의 base 인자로 들어가지 않도록 local binding 필수
        local raw = safeGetVar(triggerId, "cv_points", "0")
        local cleaned = raw:gsub(",", "")
        return tonumber(cleaned) or 0
    end
    return tonumber(safeGetVar(triggerId, key, "0")) or 0
end

local function _varEditClamp(key, val)
    if key == "cv_points" then
        return math.max(0, math.min(999999999, val))
    elseif key == "cv_hp" or key == "cv_mana" or key == "cv_hunger" then
        return math.max(0, val)
    else
        return math.max(0, math.min(999, val))
    end
end

local function _varEditMaxValue(triggerId, key)
    if key == "cv_hp" then
        return tonumber(safeGetVar(triggerId, "cv_maxHp", "100")) or 100
    elseif key == "cv_mana" then
        return tonumber(safeGetVar(triggerId, "cv_maxMana", "100")) or 100
    elseif key == "cv_hunger" then
        return tonumber(safeGetVar(triggerId, "cv_maxHunger", "100")) or 100
    end
    return nil
end

local function _varEditWriteValue(triggerId, key, val)
    val = _varEditClamp(key, val)
    local maxV = _varEditMaxValue(triggerId, key)
    if maxV then val = math.min(maxV, val) end
    if key == "cv_points" then
        setChatVar(triggerId, key, _varEditFormatPoints(val))
    else
        setChatVar(triggerId, key, tostring(val))
        -- ATK/DEF/LUCK 는 onOutput 끝의 eqRecalcStats 가 cv_*_base + equipped 로 재계산해 cv_attack 등을 덮어씀.
        -- 사용자 의도 (변수 편집기 표시값 = 영구 반영) 위해 base 도 같이 set.
        if key == "cv_attack" or key == "cv_defense" or key == "cv_luck" then
            setChatVar(triggerId, key .. "_base", tostring(val))
        end
    end
end

local function _varEditApplyDelta(triggerId, delta)
    local target = safeGetVar(triggerId, "cv_varEditTarget", "")
    if target == "" or not VAR_EDIT_UNITS[target] then return end
    local cur = _varEditReadValue(triggerId, target)
    _varEditWriteValue(triggerId, target, cur + delta)
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    buildVarEditHtml(triggerId)
    appendSaveToCurrentMessage(triggerId)
end

local function _varEditApplyDeltaByUnit(triggerId, unitKey, sign)
    local target = safeGetVar(triggerId, "cv_varEditTarget", "")
    if target == "" or not VAR_EDIT_UNITS[target] then return end
    local delta = (VAR_EDIT_UNITS[target][unitKey] or 0) * sign
    if delta == 0 then return end
    _varEditApplyDelta(triggerId, delta)
end

function varEditMinusBig(triggerId)  _varEditApplyDeltaByUnit(triggerId, "big", -1) end
function varEditMinusMed(triggerId)  _varEditApplyDeltaByUnit(triggerId, "med", -1) end
function varEditMinusSml(triggerId)  _varEditApplyDeltaByUnit(triggerId, "sml", -1) end
function varEditPlusSml(triggerId)   _varEditApplyDeltaByUnit(triggerId, "sml",  1) end
function varEditPlusMed(triggerId)   _varEditApplyDeltaByUnit(triggerId, "med",  1) end
function varEditPlusBig(triggerId)   _varEditApplyDeltaByUnit(triggerId, "big",  1) end

function varEditSetMax(triggerId)
    local target = safeGetVar(triggerId, "cv_varEditTarget", "")
    if target == "" then return end
    local maxV = _varEditMaxValue(triggerId, target)
    if maxV then
        _varEditWriteValue(triggerId, target, maxV)
    elseif target == "cv_points" then
        _varEditWriteValue(triggerId, target, 999999999)
    else
        _varEditWriteValue(triggerId, target, 999)
    end
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    buildVarEditHtml(triggerId)
    appendSaveToCurrentMessage(triggerId)
end

function varEditSetMin(triggerId)
    local target = safeGetVar(triggerId, "cv_varEditTarget", "")
    if target == "" then return end
    _varEditWriteValue(triggerId, target, 0)
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    buildVarEditHtml(triggerId)
    appendSaveToCurrentMessage(triggerId)
end

local function _varEditSelect(triggerId, key)
    setChatVar(triggerId, "cv_varEditTarget", key)
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    buildVarEditHtml(triggerId)
end

function varEditSelectPoints(triggerId)   _varEditSelect(triggerId, "cv_points")  end
function varEditSelectHp(triggerId)       _varEditSelect(triggerId, "cv_hp")      end
function varEditSelectMana(triggerId)     _varEditSelect(triggerId, "cv_mana")    end
function varEditSelectHunger(triggerId)   _varEditSelect(triggerId, "cv_hunger")  end
function varEditSelectAttack(triggerId)   _varEditSelect(triggerId, "cv_attack")  end
function varEditSelectDefense(triggerId)  _varEditSelect(triggerId, "cv_defense") end
function varEditSelectLuck(triggerId)     _varEditSelect(triggerId, "cv_luck")    end

local function _varEditSplitItems(itemsStr)
    local out = {}
    if not itemsStr or itemsStr == "None" or itemsStr == "" or itemsStr == "null" then
        return out
    end
    for entry in (itemsStr .. ","):gmatch("([^,]+),") do
        local trimmed = entry:match("^%s*(.-)%s*$")
        if trimmed ~= "" then
            local base = trimmed:match("^(.+)%s+x%d+$") or trimmed
            base = base:match("^%s*(.-)%s*$")
            out[#out+1] = { raw = trimmed, base = base }
        end
    end
    return out
end

local function _varEditRemoveDetailByName(detailsStr, targetName)
    if not detailsStr or detailsStr == "" or detailsStr == "None" or detailsStr == "null" then
        return detailsStr or ""
    end
    local kept = {}
    for entry in (detailsStr .. ";;"):gmatch("(.-);;") do
        if entry ~= "" then
            local name = entry:match("^([^|]*)") or ""
            name = name:match("^%s*(.-)%s*$")
            if name ~= targetName then
                kept[#kept+1] = entry
            end
        end
    end
    return table.concat(kept, ";;")
end

local function _varEditDeleteItemByIdx(triggerId, idx)
    local curItems = safeGetVar(triggerId, "cv_items", "")
    local items = _varEditSplitItems(curItems)
    if idx < 1 or idx > #items then return end
    local removed = items[idx]
    table.remove(items, idx)
    local newItems
    if #items == 0 then
        newItems = "None"
    else
        local raws = {}
        for _, it in ipairs(items) do raws[#raws+1] = it.raw end
        newItems = table.concat(raws, ", ")
    end
    setChatVar(triggerId, "cv_items", newItems)
    local curDetails = safeGetVar(triggerId, "cv_itemDetails", "")
    local newDetails = _varEditRemoveDetailByName(curDetails, removed.base)
    if newDetails == "" then newDetails = "None" end
    setChatVar(triggerId, "cv_itemDetails", newDetails)
    print(string.format("[GachaIsland] VAR_EDIT_DELETE_ITEM: idx=%d name='%s' → cv_items='%s'", idx, removed.base, newItems))
    setChatVar(triggerId, "cv_debugOpen", "1")
    setChatVar(triggerId, "cv_varEditOpen", "1")
    setChatVar(triggerId, "cv_panelStayOnce", "")  -- 이전 trigger 잔재 cleanup (응답 후 reset 분기 진입 보장)
    buildVarEditHtml(triggerId)
    appendSaveToCurrentMessage(triggerId)
end

for idx = 1, 20 do
    _G["varEditDeleteItem" .. idx] = function(triggerId)
        _varEditDeleteItemByIdx(triggerId, idx)
    end
end

function buildVarEditHtml(triggerId)
    local target  = safeGetVar(triggerId, "cv_varEditTarget", "")
    local isOpen  = safeGetVar(triggerId, "cv_varEditOpen",   "0") == "1"
    local openAttr = isOpen and " open" or ""

    local html = '<details' .. openAttr .. ' class="gi-info-aux-card gi-varedit-card" style="padding:0;overflow:hidden;border-radius:8px;border:1px solid #fcd34d;">'
    html = html .. '<summary style="padding:10px 12px;cursor:pointer;font-weight:700;background:linear-gradient(90deg,#fef3c7 0%,#fde68a 100%);color:#78350f;list-style:none;display:flex;align-items:center;gap:8px;font-size:0.95em;">'
        .. '<span style="font-size:1.1em;">🛠️</span><span>변수 편집기</span>'
        .. '<span style="font-size:0.7em;font-weight:500;background:#fbbf24;color:#78350f;padding:1px 6px;border-radius:3px;margin-left:2px;">DEBUG</span>'
        .. '<span style="margin-left:auto;font-size:0.7em;color:#92400e;opacity:0.7;">▼ 펼치기</span>'
        .. '</summary>'

    html = html .. '<div style="padding:12px;background:#fffbeb;">'

    html = html .. '<div style="font-size:0.7em;color:#92400e;opacity:0.8;margin-bottom:6px;font-style:italic;">ⓘ 퍼스트 메시지에서는 작동하지 않음</div>'
    html = html .. '<div style="font-size:0.78em;color:#78350f;font-weight:700;margin-bottom:5px;letter-spacing:0.02em;">📍 편집 대상</div>'
    html = html .. '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-bottom:12px;">'
    for _, key in ipairs(VAR_EDIT_TARGET_ORDER) do
        local label = VAR_EDIT_TARGET_LABEL[key]
        local triggerName = "varEditSelect" .. key:sub(4,4):upper() .. key:sub(5)
        local activeClass = (target == key) and " gi-varedit-chip-active" or ""
        html = html .. '<div class="gi-varedit-chip' .. activeClass .. '">'
            .. '{{button::' .. label .. '::' .. triggerName .. '}}'
            .. '</div>'
    end
    html = html .. '</div>'

    if target ~= "" and VAR_EDIT_UNITS[target] then
        local label = VAR_EDIT_TARGET_LABEL[target] or target
        local labelInline = (label:gsub("\n", " "))  -- 현재 값 display 는 한 줄 유지
        local cur = _varEditReadValue(triggerId, target)
        local maxV = _varEditMaxValue(triggerId, target)
        local valStr
        if target == "cv_points" then
            valStr = _varEditFormatPoints(cur) .. " P"
        elseif maxV then
            valStr = tostring(cur) .. " / " .. tostring(maxV)
        else
            valStr = tostring(cur)
        end
        local units = VAR_EDIT_UNITS[target]
        local fmtUnit = _varEditFormatPoints
        html = html .. '<div style="background:#ffffff;border:1px solid #fcd34d;border-radius:8px;padding:10px 12px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;">'
            .. '<span style="font-weight:700;color:#78350f;font-size:0.9em;">' .. labelInline .. '</span>'
            .. '<span style="font-family:ui-monospace,Consolas,monospace;font-size:1.05em;font-weight:700;color:#78350f;background:#fef3c7;padding:3px 10px;border-radius:4px;border:1px solid #fbbf24;">' .. valStr .. '</span>'
            .. '</div>'
        html = html .. '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-bottom:10px;">'
            .. '<div>{{button::+' .. fmtUnit(units.sml) .. '::varEditPlusSml}}</div>'
            .. '<div>{{button::+' .. fmtUnit(units.med) .. '::varEditPlusMed}}</div>'
            .. '<div>{{button::+' .. fmtUnit(units.big) .. '::varEditPlusBig}}</div>'
            .. '<div class="gi-varedit-emphasis">{{button::MAX::varEditSetMax}}</div>'
            .. '<div>{{button::−' .. fmtUnit(units.sml) .. '::varEditMinusSml}}</div>'
            .. '<div>{{button::−' .. fmtUnit(units.med) .. '::varEditMinusMed}}</div>'
            .. '<div>{{button::−' .. fmtUnit(units.big) .. '::varEditMinusBig}}</div>'
            .. '<div class="gi-varedit-emphasis">{{button::MIN::varEditSetMin}}</div>'
            .. '</div>'
    else
        html = html .. '<div style="background:#ffffff;border:1px dashed #fbbf24;border-radius:8px;padding:14px;text-align:center;color:#92400e;font-size:0.85em;margin-bottom:10px;">▲ 편집할 stat 을 선택하세요</div>'
    end

    html = html .. '<div style="font-size:0.78em;color:#78350f;font-weight:700;margin-bottom:5px;letter-spacing:0.02em;">📦 보유 아이템 <span style="font-weight:500;opacity:0.7;">(cv_items)</span></div>'
    local items = _varEditSplitItems(safeGetVar(triggerId, "cv_items", ""))
    if #items == 0 then
        html = html .. '<div style="text-align:center;color:#a16207;font-size:0.82em;padding:10px;background:#ffffff;border-radius:6px;border:1px dashed #fbbf24;">없음</div>'
    else
        html = html .. '<div style="display:flex;flex-direction:column;gap:3px;">'
        for idx, it in ipairs(items) do
            if idx > 20 then break end
            html = html .. '<div style="display:flex;align-items:center;justify-content:space-between;gap:6px;background:#ffffff;padding:5px 8px;border-radius:5px;border:1px solid #fcd34d;">'
                .. '<span style="font-size:0.85em;color:#1f2937;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;">' .. htmlEscape(it.raw) .. '</span>'
                .. '<div class="gi-varedit-delete">{{button::✕::varEditDeleteItem' .. idx .. '}}</div>'
                .. '</div>'
        end
        if #items > 20 then
            html = html .. '<div style="font-size:0.72em;color:#a16207;text-align:center;padding:4px;font-style:italic;">(상위 20개만 표시 — 추가 entry 는 다음 응답에서 표시)</div>'
        end
        html = html .. '</div>'
    end

    html = html .. '</div>'
    html = html .. '</details>'
    setChatVar(triggerId, "cv_varEditHtml", html)
end


-- =============================================
-- #446 rollCombatResult — cv_combatResult / Roll / Rate / Basic / Ulti 결정 헬퍼.
-- onInput (사용자 직접 타이핑) + onOutput 끝 (다음 응답용 안전망 pre-roll) 양쪽에서 호출.
-- 사용 배경: Risu 가 addChat 으로 추가된 user msg (버튼 클릭 등) 에는 onInput 발동 안 함.
-- 그 결과 미로 진행 중 cv_combatResult 가 옛 값 고정 → mazeFailStreak 보정 + 진행 자체 영구 막힘.
-- onOutput 끝에서도 호출하여 매 응답 끝에 다음용 result 새로 결정 (failStreak 반영 보장).
-- 호출자가 refreshSeed 책임 — 헬퍼는 PRNG 상태 그대로 사용.
-- =============================================
local function rollCombatResult(triggerId)
    local maxHp     = tonumber(safeGetVar(triggerId, "cv_maxHp",     "100")) or 100
    local curHp     = tonumber(safeGetVar(triggerId, "cv_hp",        "100")) or 100
    local maxMana   = tonumber(safeGetVar(triggerId, "cv_maxMana",   "100")) or 100
    local curMana   = tonumber(safeGetVar(triggerId, "cv_mana",      "100")) or 100
    local maxHunger = tonumber(safeGetVar(triggerId, "cv_maxHunger", "100")) or 100
    local curHunger = tonumber(safeGetVar(triggerId, "cv_hunger",    "100")) or 100
    local floor     = tonumber(safeGetVar(triggerId, "cv_currentFloor", "0")) or 0

    local rate = 60  -- #424 base 55→60

    -- HP/MANA/HUNGER 패널티
    local hpPct = maxHp > 0 and (curHp / maxHp * 100) or 0
    if    hpPct < 20 then rate = rate - 20
    elseif hpPct < 40 then rate = rate - 10 end

    local manaPct = maxMana > 0 and (curMana / maxMana * 100) or 0
    if    curMana == 0   then rate = rate - 20
    elseif manaPct < 30  then rate = rate - 10 end

    local hungerPct = maxHunger > 0 and (curHunger / maxHunger * 100) or 0
    if    curHunger == 0  then rate = rate - 15
    elseif hungerPct < 15 then rate = rate - 10
    elseif hungerPct < 30 then rate = rate - 5 end

    -- 동료 보너스 (+2%/명, max 4)
    local companions = safeGetVar(triggerId, "cv_companions", "None")
    if companions ~= "None" and companions ~= "" then
        local n = 0
        for _ in companions:gmatch("[^,]+") do n = n + 1 end
        if n > 4 then n = 4 end
        rate = rate + n * 2
    end

    rate = rate - (floor - 1) * 0.2  -- 층수 페널티

    local islandStage = tonumber(safeGetVar(triggerId, "cv_islandStage", "0")) or 0
    if islandStage >= 3 then rate = rate + 10 end

    -- 미로형 +30 + failStreak * 5
    local activeDType = safeGetVar(triggerId, "cv_activeDungeonType", "None")
    if activeDType == "미로형" then
        rate = rate + 30
        local failStreak = tonumber(safeGetVar(triggerId, "cv_mazeFailStreak", "0")) or 0
        if failStreak > 0 then
            rate = rate + failStreak * 5
            print(string.format("[GachaIsland] MAZE_FAIL_STREAK_BONUS (#436): failStreak=%d → rate +%d%%", failStreak, failStreak * 5))
        end
    end

    -- #504: LUCK 1 = rate +1% (이전 10 당 1% → ATK/DEF 와 동등하게 1당 1%)
    local luckVal = tonumber(safeGetVar(triggerId, "cv_luck", "0")) or 0
    if luckVal > 0 then rate = rate + luckVal end

    -- #447: rate 가 floor 페널티 (-0.2/층) 로 float 가능 → math.floor 로 정수화 (string.format %d 에러 차단).
    local finalRate   = math.floor(math.max(5, math.min(95, rate)))
    local roll        = math.random(1, 100)
    local critSuccess = math.floor(finalRate * 0.15)
    local success     = math.floor(finalRate * 0.5)
    local normal      = math.floor(finalRate + (100 - finalRate) * 0.5)
    local fail        = math.floor(finalRate + (100 - finalRate) * 0.85)

    local result
    if    roll <= critSuccess then result = "대성공"
    elseif roll <= success    then result = "성공"
    elseif roll <= normal     then result = "보통"
    elseif roll <= fail       then result = "실패"
    else                           result = "대실패" end

    setChatVar(triggerId, "cv_combatResult", result)
    setChatVar(triggerId, "cv_combatRoll",   tostring(roll))
    setChatVar(triggerId, "cv_combatRate",   tostring(finalRate))
    print(string.format("[GachaIsland] COMBAT_ROLL: %d/100 → %s (Rate: %d%%)", roll, result, finalRate))

    -- 일반 공격 (#444): 보통 -20 / 실패 +10 / 대실패 +10
    local basicNormalEnd = math.max(success + 1, normal - 20)
    local basicFailEnd   = math.max(basicNormalEnd + 1, fail - 10)
    local basicResult
    if     roll <= critSuccess     then basicResult = "대성공"
    elseif roll <= success          then basicResult = "성공"
    elseif roll <= basicNormalEnd   then basicResult = "보통"
    elseif roll <= basicFailEnd     then basicResult = "실패"
    else                                 basicResult = "대실패" end
    setChatVar(triggerId, "cv_combatResultBasic", basicResult)

    -- 궁극기 (#444): 대성공 +10 / 성공 +10 / 보통 -20
    local ultiCritEnd    = math.min(success - 1, critSuccess + 10)
    local ultiSuccessEnd = math.min(normal - 1,  success + 20)
    local ultiResult
    if     roll <= ultiCritEnd     then ultiResult = "대성공"
    elseif roll <= ultiSuccessEnd   then ultiResult = "성공"
    elseif roll <= normal           then ultiResult = "보통"
    elseif roll <= fail             then ultiResult = "실패"
    else                                 ultiResult = "대실패" end
    setChatVar(triggerId, "cv_combatResultUlti", ultiResult)

    if basicResult ~= result or ultiResult ~= result then
        print(string.format("[GachaIsland] RESULT_VARIANTS (#444): roll=%d → 스킬=%s / 일반 공격=%s / 궁극기=%s", roll, result, basicResult, ultiResult))
    end
end

onInput = async(function(triggerId)
    -- 매 입력마다 PRNG seed refresh — 모든 random 호출 (전투/층/던전) 분산
    refreshSeed(triggerId)

    -- #373 (Bug 1, 3, 5): 일반 유저 입력 시 사이드패널 stay-open 플래그 일괄 해제.
    -- 버튼은 addChat-driven → onInput 발동 안 함 (button-path).
    -- onInput 발동 = 유저가 직접 타이핑 → 패널 잔여 stay-open 모두 해제 (가챠/인벤/강화/가이드).
    setChatVar(triggerId, "cv_gachaPanelOpen", "0")
    setChatVar(triggerId, "cv_invOpen",        "0")
    setChatVar(triggerId, "cv_forgeOpen",      "0")
    setChatVar(triggerId, "cv_guideOpen",      "0")
    setChatVar(triggerId, "cv_forgeActiveSlot","0")

    -- #446: rate 계산 + result/basic/ulti 결정은 rollCombatResult 헬퍼에서 처리.
    rollCombatResult(triggerId)

    -- =============================================
    -- FLOOR CONDITION PRE-ROLL (층 컨디션 사전 결정)
    -- 25% 확률로 발생. 발생 시 5가지 컨디션 중 무작위 선택.
    -- 저장 형식: "없음" 또는 컨디션 이름
    -- =============================================
    -- 모듈 레벨 FLOOR_CONDITIONS + rollFloorCondition 헬퍼 사용 (dungeonNextFloor와 일관)
    local nextCond, condRoll = rollFloorCondition()
    setChatVar(triggerId, "cv_nextFloorCondition", nextCond)
    print(string.format("[GachaIsland] FLOOR_CONDITION_PREROLL (onInput): %d/100 → %s", condRoll, nextCond))

    -- 첫 던전 진입 대비 pre-sync: 던전 밖일 때만 cv_activeFloorCondition 동기화
    -- (이래야 AI가 자연어 "던전 가자" 입력 시 프롬프트에 활성 컨디션이 박혀 있어 narration 가능)
    -- 던전 안일 땐 sync 안 함 — 현재 floor 진행 중인 활성 컨디션을 덮어쓰지 않기 위함
    if safeGetVar(triggerId, "cv_dungeonActive", "0") ~= "1" then
        setChatVar(triggerId, "cv_activeFloorCondition", nextCond)
        print(string.format("[GachaIsland] FLOOR_CONDITION_PRESYNC (outside dungeon): %s", nextCond))
    end

    -- 직전 user 메시지 캡처 (이하 여러 곳에서 사용)
    -- NOTE: button-path는 onInput이 발동 안 함 (addChat-driven user msg 특성).
    -- 버튼 진입 시 floor condition·dungeon type pre-roll은 dungeonNextFloor에서 직접 처리.
    -- 여기서 [DUNGEON_TYPE:...] 가드는 자연 narrative 경로에서 우연히 태그 들어간 케이스 안전망.
    local lastUserMsg = ""
    local chatLen = getChatLength(triggerId)
    if chatLen > 0 then
        local m = getChat(triggerId, chatLen - 1)
        if m and m.role == "user" and m.data then lastUserMsg = m.data end
    end

    -- =============================================
    -- DUNGEON TYPE PRE-ROLL (던전 타입 사전 결정)
    -- 5종 균등 + cv_lastDungeonType 회피 (AI positional bias 차단)
    -- AI는 floor entry SYS_NARR에서 cv_nextDungeonType verbatim 사용
    --
    -- 가드: 직전 user msg에 [DUNGEON_TYPE:...] 태그가 있으면 (dungeonNextFloor 버튼 경로)
    -- pre-roll 스킵 → 버튼이 이미 픽한 값을 덮어쓰지 않음
    -- =============================================
    if lastUserMsg:match("%[DUNGEON_TYPE:[^%]]+%]") then
        print("[GachaIsland] DUNGEON_TYPE_PREROLL: SKIPPED (user msg has [DUNGEON_TYPE:...] tag — button-driven path)")
    else
        -- 2-back exclusion (last + prev) + Fisher-Yates shuffle — dungeonNextFloor와 동일 정책
        local dungeonTypes = { "탐색형", "토벌형", "미로형", "결전형" }
        local last = safeGetVar(triggerId, "cv_lastDungeonType", "None")
        local prev = safeGetVar(triggerId, "cv_prevDungeonType", "None")
        local dPool = {}
        for _, t in ipairs(dungeonTypes) do
            if t ~= last and t ~= prev then table.insert(dPool, t) end
        end
        if #dPool == 0 then
            for _, t in ipairs(dungeonTypes) do table.insert(dPool, t) end
        end
        for i = #dPool, 2, -1 do
            local j = math.random(i)
            dPool[i], dPool[j] = dPool[j], dPool[i]
        end
        local pickedDType = dPool[math.random(#dPool)]
        setChatVar(triggerId, "cv_nextDungeonType", pickedDType)
        print(string.format("[GachaIsland] DUNGEON_TYPE_PREROLL: %s (avoid: last=%s, prev=%s)", pickedDType, last, prev))
    end
end)

-- STATUS_TIP fallback — AI가 [STATUS_TIP:...] 누락 시 상태 기반 다양한 메시지 picker
-- (단일 hardcoded fallback이 매번 같은 메시지로 반복 노출되던 문제 해소: 동료/유저 입장 「복붙」 인상 제거)
local function generateFallbackTip(triggerId)
    local hp        = tonumber(safeGetVar(triggerId, "cv_hp",        "100")) or 100
    local maxHp     = tonumber(safeGetVar(triggerId, "cv_maxHp",     "100")) or 100
    local mana      = tonumber(safeGetVar(triggerId, "cv_mana",      "100")) or 100
    local maxMana   = tonumber(safeGetVar(triggerId, "cv_maxMana",   "100")) or 100
    local hunger    = tonumber(safeGetVar(triggerId, "cv_hunger",    "100")) or 100
    local maxHunger = tonumber(safeGetVar(triggerId, "cv_maxHunger", "100")) or 100
    local pointsStr = (safeGetVar(triggerId, "cv_points", "0")):gsub(",", "")
    local points    = tonumber(pointsStr) or 0
    local dungeonActive = safeGetVar(triggerId, "cv_dungeonActive", "0") == "1"

    local hpPct     = (maxHp     > 0) and (hp     / maxHp     * 100) or 100
    local manaPct   = (maxMana   > 0) and (mana   / maxMana   * 100) or 100
    local hungerPct = (maxHunger > 0) and (hunger / maxHunger * 100) or 100

    local pool = {}

    -- 위급 상황 (HP / MANA / HUNGER)
    if hpPct < 25 then
        table.insert(pool, "체력이 위태위태~ 한 대만 더 맞으면 큰일나겠는걸요?")
        table.insert(pool, "이대로 가다간 그림이 좀 처참해질 것 같은데요~?")
    end
    if manaPct < 30 then
        table.insert(pool, "마나가 슬슬 바닥인데, 충전은 누구랑 하실 거예요~?")
        table.insert(pool, "마나 없으면 스킬도 못 쓰시잖아요~ 동료한테 부탁 좀 해보시지요?")
    end
    if hungerPct < 30 then
        table.insert(pool, "허기 좀 챙기시지요~ 굶어 쓰러지면 그것도 그림이긴 하겠지만요?")
        table.insert(pool, "뭐라도 좀 드시는 게 좋을 텐데... 보급품 가챠라도 한 번 굴려보시지요?")
    end

    -- 던전 진행 상황
    if dungeonActive then
        table.insert(pool, "여기까지 내려오셨는데, 후퇴하실 건가요? 한 층 더 욕심내실 건가요~?")
        table.insert(pool, "던전 깊숙이 들어오셨네요~ 마지막에 누가 웃을지 궁금해지는데요?")
        table.insert(pool, "지금 귀환할까요, 아니면 욕심 한 번 더 부려볼까요~?")
    end

    -- 포인트 상황
    if points >= 10000 then
        table.insert(pool, "포인트 두둑하시네요~ 시설 한 번 지어보시는 건 어떠세요?")
        table.insert(pool, "포인트가 넉넉한데, 뭐 굴려보실 건가요~?")
    end
    if points < 1000 and not dungeonActive then
        table.insert(pool, "포인트가 영 부족해 보이는데, 던전 다녀오셔야겠는걸요?")
        table.insert(pool, "지갑이 가벼우신 것 같은데, 던전이 부르고 있는 것 같지 않으세요~?")
    end

    -- 모든 상태가 평이할 때 일반 fallback (6종 random)
    if #pool == 0 then
        pool = {
            "오늘은 또 어떤 운을 시험해보실 작정이세요~?",
            "가챠라는 게 묘하지요~ 오늘은 어느 쪽으로 굴려보실 건가요?",
            "흠~ 슬슬 다음 수를 둘 차례인 것 같은데요?",
            "지루할 틈이 없으시죠? 가챠섬은 항상 새로운 게 일어나니까요~",
            "한 번에 너무 많은 걸 노리지는 마세요~ ...아니면 그것도 그림일까요?",
            "어떤 선택을 하시든, 저는 옆에서 지켜볼 뿐이에요~ ♪",
        }
    end

    -- 직전 fallback과 동일한 항목 회피 (연속 같은 fallback 노출 차단)
    local lastFallback = safeGetVar(triggerId, "cv_lastFallbackTip", "")
    local picked = pool[math.random(#pool)]
    if #pool >= 2 and picked == lastFallback then
        local tries = 0
        while picked == lastFallback and tries < 5 do
            picked = pool[math.random(#pool)]
            tries = tries + 1
        end
    end
    setChatVar(triggerId, "cv_lastFallbackTip", picked)
    return picked
end

-- =============================================
-- STATE SAVE/RESTORE (per-message snapshot)
-- 매 AI 메시지 끝에 <=SAVE¦...=> 태그 부착 → 어느 시점이든 복원 가능
-- Reroll, 메시지 삭제, 시간 되돌리기 모두 자동 처리
-- =============================================

local SNAPSHOT_VARS = {
    -- 스탯 (현재/최대)
    "cv_hp", "cv_mana", "cv_hunger",
    "cv_maxHp", "cv_maxMana", "cv_maxHunger",
    -- 자원
    "cv_points",
    -- 능력치
    "cv_attack", "cv_defense", "cv_luck",
    -- 인벤토리 (이름 + 디테일)
    "cv_items", "cv_itemDetails",
    "cv_skills", "cv_skillDetails",
    "cv_relics", "cv_relicDetails",
    "cv_facilities", "cv_facilityDetails",
    "cv_companions", "cv_companionsEng",
    -- 던전 진행
    "cv_floor",
    "cv_dungeonActive", "cv_dungeonGateState", "cv_dungeonEnteredToday",
    "cv_activeFloorCondition", "cv_activeDungeonType", "cv_lastDungeonType", "cv_prevDungeonType",
    "cv_sanctuarySpawnedFloor",
    "cv_sanctuarySpawnedMsg",   -- #452 마커 박힌 msg idx (msg 미스매치 시 transfer + prior strip)
    "cv_sanctuaryConsumed",     -- #452 user 가 충전/귀환 클릭한 경우 1 (이후 emit 영구 차단)
    -- 라운드 시스템 + 몬스터 추적 (#331 — Panel HTML은 SAVE에서 제외, 매 onOutput에서 재빌드)
    "cv_currentRound", "cv_totalRounds", "cv_roundEvents",
    "cv_hungerDrainAppliedRound",  -- 결전형 등 single-round 던전의 round drain 중복 차감 차단용 (라운드별 1회 cap)
    "cv_currentMonsters",
    "cv_pendingMonsterSpawn",  -- #455 라운드 advance 후 다음 editRequest 의 spawn 예약 플래그 (reload 시 보존)
    "cv_mazeEscapeCount",  -- #308 미로형 무한 라운드 탈출 카운트 (0~3)
    "cv_mazeFailStreak",   -- #436 미로형 anti-stall 누적 카운트 (보통/실패/대실패 시 +1, 성공 시 reset; 다음 라운드 rate +5%/stack)
    -- 사용자 설정
    "cv_auxMode",
    -- 게임 상태
    "cv_islandStage", "cv_day", "cv_gameOver",
    "cv_stage5MaxApplied",
    -- 강화 슬롯 (#328 — 카테고리별 9 변수 분리)
    "cv_forgeSlotSkill1",    "cv_forgeSlotSkill2",    "cv_forgeSlotSkill3",
    "cv_forgeSlotRelic1",    "cv_forgeSlotRelic2",    "cv_forgeSlotRelic3",
    "cv_forgeSlotFacility1", "cv_forgeSlotFacility2", "cv_forgeSlotFacility3",
    -- Lua dedup state
    -- #385: cv_lastCompanionMsg 를 SAVE 에서 제외 (SAVE_LOAD 후 stale msg idx 로 복원되어
    -- dedupe 가드가 잇시키 같은 가챠 매칭 영구 차단하는 버그 차단). 매 chat 시작 시 -1 reset 으로 충분.
    "cv_lastDayMsg", "cv_lastGachaPick",
    -- #353 EQUIP SYSTEM (스킬/유물 장착 + 기본 스탯 + 슬롯 한도)
    "cv_equippedSkills", "cv_equippedRelics",
    "cv_maxSkillSlots",  "cv_maxRelicSlots",
    "cv_attack_base",    "cv_defense_base",    "cv_luck_base",
    "cv_maxHp_base",     "cv_maxMana_base",    "cv_maxHunger_base",
    -- #362 DLC-only toggle
    "cv_baseCharsOff",
}
-- 제외 (transient pre-roll, 매 onInput에서 fresh):
--   cv_combatResult/Roll/Rate, cv_nextFloorCondition, cv_nextDungeonType
-- 제외 (live state — dungeonNextFloor 버튼이 imperative 갱신, SAVE 복원 시 stale 1로 되돌아가는 버그 방지):
--   cv_currentFloor (버튼·자연 narrative 진입 모두 onOutput lock-in에서 sync, SAVE/LOAD에 의존 안 함)
-- 제외 (UI/meta — 트랜지언트 또는 재로드 시 자체 init):
--   cv_invOpen, cv_invCategory, cv_gachaPanelOpen, cv_forgeOpen, cv_forgeCategory, cv_guideOpen, cv_debugOpen, cv_skipNextRerollPoint
--   cv_seedCounter (PRNG entropy counter — monotonic increase 보장 위해 SAVE 제외)
--   cv_lastFallbackTip (STATUS_TIP fallback dedupe — transient)

-- =============================================
-- #345: SAVE V2 — 짧은 키 + 기본값 생략으로 평균 ~89% 감소
-- 옛 포맷: <=SAVE¦cv_hp:80¦cv_mana:60¦cv_hunger:70¦...=> (~1440 bytes, 모든 변수)
-- 신 포맷: <=S2¦h:80¦m:60¦u:70=> (~150 bytes, 변경된 변수만)
-- 옛 SAVE도 로드 시 인식 (legacy chat 호환) — writer는 V2만 사용
-- =============================================

