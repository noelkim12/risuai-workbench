-- =============================================
-- Gacha Island Backend
--
-- onInput  : details format migration / combat roll / floor condition pre-roll / dungeon type pre-roll
-- onOutput : SYSTEM tag parsing (POINT/HP/MANA/HUNGER/MAX_*/ITEM_*/SKILL_/GACHA/FLOOR/NEW_DAY/DEFEAT/DUNGEON_*)
--          + cv_*Details management (이름||효과;;이름||효과 format, 사이드 패널 CBS 파싱 호환)
--          + island stage auto-calc / dungeon gate state / GAME OVER detection
--          + STATUS_PANEL auto-generation from cv_* (AI only outputs [STATUS_TIP:...])
-- =============================================

math.randomseed(os.time())

-- Helper: treat "null" string from RisuAI as nil/fallback
local function safeGetVar(triggerId, varName, fallback)
    local val = getChatVar(triggerId, varName)
    if val == nil or val == "" or val == "null" then
        return fallback
    end
    return val
end

-- Helper: setChatVar 의 「현재 값과 같으면 안 쓴다」 버전.
-- 패널 닫기/플래그 리셋처럼 같은 값을 반복 setChat 하는 핫 경로에서 사용.
-- Risu 의 SAVE 갱신 + CBS 재평가 + dirty marking 부담을 줄임. 동작은 setChatVar 와 동일.
local function smartSetChatVar(triggerId, key, value)
    local newVal = tostring(value)
    local cur = getChatVar(triggerId, key)
    if cur ~= newVal then
        setChatVar(triggerId, key, newVal)
    end
end

-- =============================================
-- PRNG SEED REFRESH (entropy fix)
-- RisuAI Lua가 트리거마다 모듈 재로드해 같은 os.time() seed 반복 사용 의심 →
-- math.random 시퀀스가 결정적이 되어 같은 인덱스만 뽑히는 편향 발생.
-- Lua 5.4 2-arg math.randomseed(x, y) → 128-bit 시드 (high 64 = os.time, low 64 = counter*7919)
-- chat-persistent counter로 매 호출 unique seed 보장 + warm-up으로 초기 상태 회피.
-- 모든 random 호출 (전투/층컨디션/던전 type/가챠) 직전에 호출.
-- =============================================
local function refreshSeed(triggerId)
    local seedCounter = tonumber(safeGetVar(triggerId, "cv_seedCounter", "0")) or 0
    seedCounter = seedCounter + 1
    setChatVar(triggerId, "cv_seedCounter", tostring(seedCounter))
    -- #424 entropy 보강:
    --   high bits = os.time() * 1000003 + counter * 7919 (같은 초 입력에도 high 점프)
    --   low bits  = counter * 982451653 (counter +1 마다 ~10억 점프 → 카드 덱 시작점 멀리 이동)
    --   warm-up 5 → 20회 (초기 cluster 완전 회피)
    math.randomseed(os.time() * 1000003 + seedCounter * 7919, seedCounter * 982451653)
    for _ = 1, 20 do math.random() end
end

-- 던전 층 컨디션 5종 (module-level constant — onInput pre-roll + dungeonNextFloor 둘 다 사용)
local FLOOR_CONDITIONS = {
    "축복받은 땅",      -- 긍정: HP/마나 회복 소량
    "마나 과잉",        -- 긍정: 마나 소모 -20%
    "풍요의 기운",      -- 긍정: 포인트 획득 +30%
    "저주받은 땅",      -- 부정: 받는 피해 +30%
    "마나 고갈 지역",   -- 부정: 층 입장 시 마나 -15
}

-- 헬퍼: 층 컨디션 25% 발생 + 5종 균등 pre-roll → (조건명, condRoll)
local function rollFloorCondition()
    local condRoll = math.random(100)
    local cond
    if condRoll <= 25 then
        cond = FLOOR_CONDITIONS[math.random(#FLOOR_CONDITIONS)]
    else
        cond = "없음"
    end
    return cond, condRoll
end



-- =============================================
-- COMBAT JUDGMENT SYSTEM (onInput)
-- 매 유저 입력 전에 실행. 파티 현황을 기반으로 전투 판정 주사위를 미리 계산하여
-- cv_combatResult / cv_combatRoll / cv_combatRate 에 저장.
-- AI는 던전 전투 중 cv_combatResult를 읽어 해당 턴의 행동 결과를 서술.
--
-- 성공률 구성 요소:
--   기본값: 60% (#424 — 55→60, 난이도 ↓)
--   HP < 40% → -10%,  HP < 20% → -20%
--   마나 < 30% → -10%, 마나 = 0 → -20%
--   허기 < 30% → -5%,  허기 < 15% → -10%, 허기 = 0 → -15%
--   동료 1명당 +2% (최대 4명 cap = +8%, entry [2] Party Max 4 룰; 스킬/유물 보너스는 제거)
--   층수: -0.2%/층 선형 (#361 — 1층 ±0, 100층 -19.8%, 500층 -99.8%; cv_currentFloor 기준). 4-tier 분기 폐기.
--   행운(cv_luck): 1당 +1% (#504 — ATK/DEF 와 동등 비율)
--   섬 개발 단계 3+ (요새 이상): +10%
--   미로형: +30% (탈출 카운트 가속용)
--   최종 범위: 5% ~ 95%
--
-- 5단계 판정 (종 분포 — 보통 정점, 대성공/대실패 양극단으로 갈수록 적음):
--   대성공: roll ≤ finalRate × 0.15
--   성공:   roll ≤ finalRate × 0.5
--   보통:   roll ≤ finalRate + (100 - finalRate) × 0.5  (#424 — 0.4→0.5, 보통 영역 확장)
--   실패:   roll ≤ finalRate + (100 - finalRate) × 0.85
--   대실패: 그 외
-- (#424 rate=60% 기준 분포: 9% / 21% / 50% / 14% / 6% — 좋은 30:보통 50:나쁜 20)
-- =============================================


