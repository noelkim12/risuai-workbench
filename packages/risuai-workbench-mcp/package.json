{
  "name": "@risuai-workbench/mcp",
  "version": "0.1.1",
  "description": "Local stdio MCP server for safe RisuAI Workbench artifact inspection, validation, and approved patch workflows",
  "bin": {
    "risuai-workbench-mcp": "bin/risuai-workbench-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "prompt-assets",
    "package.json",
    "README*",
    "LICENSE*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "watch": "tsc -w -p .",
    "surface:snapshot": "node dist/dev/snapshot-tool-surface.js",
    "surface:check": "node dist/dev/snapshot-tool-surface.js --check",
    "facade:visualize": "node dist/dev/facade-visualization.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noelkim12/risuai-workbench.git",
    "directory": "packages/risuai-workbench-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@risuai-workbench/cbs-language-server": "^0.1.1",
    "@risuai-workbench/core": "^0.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/noelkim12/risuai-workbench/tree/main/packages/risuai-workbench-mcp",
  "bugs": {
    "url": "https://github.com/noelkim12/risuai-workbench/issues"
  }
}
