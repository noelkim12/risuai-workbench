{
  "name": "risuai-hmr-provider",
  "version": "1.0.0",
  "displayName": "Risu Workbench HMR",
  "description": "Receives live definition updates from Risu Workbench over local HMR",
  "private": true,
  "type": "module",
  "main": "dist/risuai-hmr-provider.js",
  "browser": "dist/risuai-hmr-provider.js",
  "scripts": {
    "dev": "vite build --watch",
    "dev:drive": "vite build --watch --outDir /mnt/d/risu/plugin-dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^22.12.0",
    "diff": "^8.0.4",
    "esbuild": "^0.28.0",
    "svelte": "^5.46.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
